odeType":"BinaryOperation","operator":"==","rightExpression":{"hexValue":"30","id":9808,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"5678:1:28","typeDescriptions":{"typeIdentifier":"t_rational_0_by_1","typeString":"int_const 0"},"value":"0"},"src":"5650:29:28","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"falseExpression":{"hexValue":"31","id":9811,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"5686:1:28","typeDescriptions":{"typeIdentifier":"t_rational_1_by_1","typeString":"int_const 1"},"value":"1"},"id":9812,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"nodeType":"Conditional","src":"5650:37:28","trueExpression":{"hexValue":"30","id":9810,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"5682:1:28","typeDescriptions":{"typeIdentifier":"t_rational_0_by_1","typeString":"int_const 0"},"value":"0"},"typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}}],"id":9813,"isConstant":false,"isInlineArray":false,"isLValue":false,"isPure":false,"lValueRequested":false,"nodeType":"TupleExpression","src":"5649:39:28","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"src":"5633:55:28","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"nodeType":"VariableDeclarationStatement","src":"5615:73:28"},{"expression":{"id":9821,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"leftHandSide":{"id":9816,"name":"sqrtPriceX96","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":9456,"src":"5698:12:28","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"nodeType":"Assignment","operator":"=","rightHandSide":{"arguments":[{"id":9819,"name":"rounded","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":9796,"src":"5732:7:28","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}}],"expression":{"argumentTypes":[{"typeIdentifier":"t_uint256","typeString":"uint256"}],"expression":{"id":9817,"name":"SafeCast","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":4925,"src":"5713:8:28","typeDescriptions":{"typeIdentifier":"t_type$_t_contract$_SafeCast_$4925_$","typeString":"type(library SafeCast)"}},"id":9818,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"memberLocation":"5722:9:28","memberName":"toUint160","nodeType":"MemberAccess","referencedDeclaration":3523,"src":"5713:18:28","typeDescriptions":{"typeIdentifier":"t_function_internal_pure$_t_uint256_$returns$_t_uint160_$","typeString":"function (uint256) pure returns (uint160)"}},"id":9820,"isConstant":false,"isLValue":false,"isPure":false,"kind":"functionCall","lValueRequested":false,"nameLocations":[],"names":[],"nodeType":"FunctionCall","src":"5713:27:28","tryCall":false,"typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"src":"5698:42:28","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"id":9822,"nodeType":"ExpressionStatement","src":"5698:42:28"}]},"documentation":{"id":9451,"nodeType":"StructuredDocumentation","src":"1447:862:28","text":" @notice Converts a tick to its Q64.96 square-root price.\n @dev Uses the independently implemented bitwise exponentiation and rounds the Q128.128 result up to Q64.96.\n      The loop-free algorithm multiplies one precomputed Q128.128 constant per set bit of `|tick|`. The\n      constants are nearest-integer rounded values of `2^128 / sqrt(1.0001)^(2^k)` for `k = 0..18`, matching\n      the pinned Uniswap implementation (a literal floor would not reproduce Uniswap's outputs). For positive\n      ticks the ratio is inverted. The final Q128.128 to Q64.96 conversion rounds up.\n      Reverts with `InvalidTick` when `tick` is outside `[MIN_TICK, MAX_TICK]`.\n @param tick The tick in the inclusive Uniswap v4 range.\n @return sqrtPriceX96 The square root of 1.0001^tick, scaled by 2^96."},"id":9824,"implemented":true,"kind":"function","modifiers":[],"name":"getSqrtPriceAtTick","nameLocation":"2323:18:28","nodeType":"FunctionDefinition","parameters":{"id":9454,"nodeType":"ParameterList","parameters":[{"constant":false,"id":9453,"mutability":"mutable","name":"tick","nameLocation":"2348:4:28","nodeType":"VariableDeclaration","scope":9824,"src":"2342:10:28","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":9452,"name":"int24","nodeType":"ElementaryTypeName","src":"2342:5:28","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"}],"src":"2341:12:28"},"returnParameters":{"id":9457,"nodeType":"ParameterList","parameters":[{"constant":false,"id":9456,"mutability":"mutable","name":"sqrtPriceX96","nameLocation":"2385:12:28","nodeType":"VariableDeclaration","scope":9824,"src":"2377:20:28","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":9455,"name":"uint160","nodeType":"ElementaryTypeName","src":"2377:7:28","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"}],"src":"2376:22:28"},"scope":9825,"src":"2314:3433:28","stateMutability":"pure","virtual":false,"visibility":"internal"}],"scope":9826,"src":"840:4909:28","usedErrors":[9441],"usedEvents":[]}],"src":"32:5718:28"}