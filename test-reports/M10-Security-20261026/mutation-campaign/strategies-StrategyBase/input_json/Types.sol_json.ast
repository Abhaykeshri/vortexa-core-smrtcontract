public"},{"canonicalName":"Strategy","documentation":{"id":929,"nodeType":"StructuredDocumentation","src":"1788:262:2","text":" @notice High-level strategy selector for later vault planning milestones.\n @dev The numeric values are stored in vault configuration and emitted in events, so new strategies must only be\n      appended and existing members must never be reordered."},"id":933,"members":[{"id":930,"name":"NormalLP","nameLocation":"2169:8:2","nodeType":"EnumValue","src":"2169:8:2"},{"id":931,"name":"BuyTheDip","nameLocation":"2280:9:2","nodeType":"EnumValue","src":"2280:9:2"},{"id":932,"name":"SellThePump","nameLocation":"2392:11:2","nodeType":"EnumValue","src":"2392:11:2"}],"name":"Strategy","nameLocation":"2056:8:2","nodeType":"EnumDefinition","src":"2051:354:2"},{"canonicalName":"DepositMode","documentation":{"id":934,"nodeType":"StructuredDocumentation","src":"2407:267:2","text":" @notice Deposit token selection mode for later vault deposit flows.\n @dev Reported by a strategy to tell the vault which tokens it accepts. One-sided strategies accept a single\n      token because their bands sit entirely on one side of the pool price."},"id":938,"members":[{"id":935,"name":"BothTokens","nameLocation":"2759:10:2","nodeType":"EnumValue","src":"2759:10:2"},{"id":936,"name":"Token0Only","nameLocation":"2830:10:2","nodeType":"EnumValue","src":"2830:10:2"},{"id":937,"name":"Token1Only","nameLocation":"2901:10:2","nodeType":"EnumValue","src":"2901:10:2"}],"name":"DepositMode","nameLocation":"2680:11:2","nodeType":"EnumDefinition","src":"2675:238:2"},{"canonicalName":"Band","documentation":{"id":939,"nodeType":"StructuredDocumentation","src":"2915:403:2","text":" @notice One liquidity band in a planned or active position set.\n @dev Planned bands (returned by the shape library) carry zero `tokenId` and `liquidity`. Active bands record the\n      PositionManager NFT the vault owns for the band. Ticks must be multiples of the pool's tick spacing and lie\n      within the usable tick range; bands of one vault must be contiguous and non-overlapping."},"id":952,"members":[{"constant":false,"id":942,"mutability":"mutable","name":"tickLower","nameLocation":"3408:9:2","nodeType":"VariableDeclaration","scope":952,"src":"3402:15:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":941,"name":"int24","nodeType":"ElementaryTypeName","src":"3402:5:2","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":945,"mutability":"mutable","name":"tickUpper","nameLocation":"3494:9:2","nodeType":"VariableDeclaration","scope":952,"src":"3488:15:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":944,"name":"int24","nodeType":"ElementaryTypeName","src":"3488:5:2","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":948,"mutability":"mutable","name":"tokenId","nameLocation":"3600:7:2","nodeType":"VariableDeclaration","scope":952,"src":"3592:15:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":947,"name":"uint256","nodeType":"ElementaryTypeName","src":"3592:7:2","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":951,"mutability":"mutable","name":"liquidity","nameLocation":"3691:9:2","nodeType":"VariableDeclaration","scope":952,"src":"3683:17:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"},"typeName":{"id":950,"name":"uint128","nodeType":"ElementaryTypeName","src":"3683:7:2","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"visibility":"internal"}],"name":"Band","nameLocation":"3326:4:2","nodeType":"StructDefinition","scope":1024,"src":"3319:384:2","visibility":"public"},{"canonicalName":"VaultConfig","documentation":{"id":953,"nodeType":"StructuredDocumentation","src":"3705:403:2","text":" @notice User-facing vault strategy configuration used by later milestones.\n @dev Written once when a vault is initialized and immutable afterwards: no privileged function may change it.\n      The factory overwrites `baseIsCurrency0` with the value from the pool rule so a creator cannot flip it.\n      One-sided strategies use `trailTicks` and `lockOnFill`; Normal LP uses `driftTicks`."},"id":992,"members":[{"constant":false,"id":957,"mutability":"mutable","name":"poolKey","nameLocation":"4205:7:2","nodeType":"VariableDeclaration","scope":992,"src":"4197:15:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$928_storage_ptr","typeString":"struct PoolKey"},"typeName":{"id":956,"nodeType":"UserDefinedTypeName","pathNode":{"id":955,"name":"PoolKey","nameLocations":["4197:7:2"],"nodeType":"IdentifierPath","referencedDeclaration":928,"src":"4197:7:2"},"referencedDeclaration":928,"src":"4197:7:2","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$928_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"},{"constant":false,"id":961,"mutability":"mutable","name":"strategy","nameLocation":"4291:8:2","nodeType":"VariableDeclaration","scope":992,"src":"4282:17:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_enum$_Strategy_$933","typeString":"enum Strategy"},"typeName":{"id":960,"nodeType":"UserDefinedTypeName","pathNode":{"id":959,"name":"Strategy","nameLocations":["4282:8:2"],"nodeType":"IdentifierPath","referencedDeclaration":933,"src":"4282:8:2"},"referencedDeclaration":933,"src":"4282:8:2","typeDescriptions":{"typeIdentifier":"t_enum$_Strategy_$933","typeString":"enum Strategy"}},"visibility":"internal"},{"constant":false,"id":964,"mutability":"mutable","n