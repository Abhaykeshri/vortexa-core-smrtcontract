aryOperation","operator":"||","rightExpression":{"commonType":{"typeIdentifier":"t_uint256","typeString":"uint256"},"id":1499,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"leftExpression":{"id":1497,"name":"numerator","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":1476,"src":"32019:9:8","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"nodeType":"BinaryOperation","operator":"<","rightExpression":{"id":1498,"name":"scaled","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":1486,"src":"32031:6:8","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"src":"32019:18:8","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"src":"32012:25:8","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"functionReturnParameters":1482,"id":1501,"nodeType":"Return","src":"32005:32:8"}]},"documentation":{"id":1474,"nodeType":"StructuredDocumentation","src":"31218:607:8","text":" @notice Reports whether `numerator / denominator` is small enough for `_sqrtFromRatio` to convert.\n @dev `_sqrtFromRatio` computes `numerator * 2**192 / denominator`, which only fits in 256 bits when\n      `numerator < denominator * 2**64`. If `denominator * 2**64` itself overflows, every 256-bit numerator\n      is smaller, so the ratio always fits. `denominator` must be non-zero.\n @param numerator Numerator of the price ratio.\n @param denominator Denominator of the price ratio.\n @return fits True when the ratio can be converted without overflow."},"id":1503,"implemented":true,"kind":"function","modifiers":[],"name":"_ratioFits","nameLocation":"31839:10:8","nodeType":"FunctionDefinition","parameters":{"id":1479,"nodeType":"ParameterList","parameters":[{"constant":false,"id":1476,"mutability":"mutable","name":"numerator","nameLocation":"31858:9:8","nodeType":"VariableDeclaration","scope":1503,"src":"31850:17:8","stateVariable":false,"storageLocati