src":"32722:555:14"}]},"documentation":{"id":8543,"nodeType":"StructuredDocumentation","src":"31493:880:14","text":" @notice Reads every non-empty band's pending fees and the liquidity this withdrawal removes from it.\n @dev Runs before any state change or external call that could move fee growth. Fills `pending0/1` in\n      `cache`. The PositionManager is needed when any liquidity is removed or any fee is pending; a tiny\n      withdrawal that removes nothing and collects nothing pays only the idle share without calling it.\n @param positionManager Trusted PositionManager-compatible contract.\n @param stateView Trusted StateView-compatible contract.\n @param shares Shares being burned.\n @param cache Withdrawal cache; `supplyBefore` is read, `pending0/1` are written.\n @return removeLiq Liquidity to remove per band, `floor(L * shares / supply)`.\n @return callPositionManager True when a PositionManager call is needed."},"id":8658,"implemented":true,"kind":"function","modifiers":[],"name":"_withdrawPlan","nameLocation":"32387:13:14","nodeType":"FunctionDefinition","parameters":{"id":8555,"nodeType":"ParameterList","parameters":[{"constant":false,"id":8546,"mutability":"mutable","name":"positionManager","nameLocation":"32431:15:14","nodeType":"VariableDeclaration","scope":8658,"src":"32410:36:14","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_contract$_IPositionManagerLike_$11249","typeString":"contract IPositionManagerLike"},"typeName":{"id":8545,"nodeType":"UserDefinedTypeName","pathNode":{"id":8544,"name":"IPositionManagerLike","nameLocations":["32410:20:14"],"nodeType":"IdentifierPath","referencedDeclaration":11249,"src":"32410:20:14"},"referencedDeclaration":11249,"src":"32410:20:14","typeDescriptions":{"typeIdentifier":"t_contract$_IPositionManagerLike_$11249","typeString":"contract IPositionManagerLike"}},"visibility":"internal"},{"constant":false,"id":8549,"mutability":"mutable","name":"stateView","nameLocation":"32