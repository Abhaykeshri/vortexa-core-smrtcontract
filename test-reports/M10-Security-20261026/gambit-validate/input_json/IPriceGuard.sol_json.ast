{"absolutePath":"src/interfaces/IPriceGuard.sol","exportedSymbols":{"IPriceGuard":[7543],"PoolKey":[8059]},"id":7544,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":7451,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:16"},{"absolutePath":"src/libraries/Types.sol","file":"../libraries/Types.sol","id":7453,"nameLocation":"-1:-1:-1","nodeType":"ImportDirective","scope":7544,"sourceUnit":8155,"src":"57:47:16","symbolAliases":[{"foreign":{"id":7452,"name":"PoolKey","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":8059,"src":"65:7:16","typeDescriptions":{}},"nameLocation":"-1:-1:-1"}],"unitAlias":""},{"abstract":false,"baseContracts":[],"canonicalName":"IPriceGuard","contractDependencies":[],"contractKind":"interface","documentation":{"id":7454,"nodeType":"StructuredDocumentation","src":"106:642:16","text":" @title PriceGuard Interface\n @notice Defines the configuration and runtime checks used to validate pool prices against oracle references.\n @dev Implementations are expected to compare a Uniswap V4 pool price with Chainlink and/or Uniswap V3 TWAP\n      references and return trust status without mutating state during price checks.\n      Consumers (vault, swap executor, factory) call `isPriceTrusted` in the same transaction as any action that\n      values shares or accepts a swap price, and never cache the result. Withdrawal paths must not call this\n      interface, so an oracle outage can never trap user funds."},"fullyImplemented":false,"id":7543,"linearizedBaseContracts":[7543],"name":"IPriceGuard","nameLocation":"759:11:16","nodeType":"ContractDefinition","nodes":[{"canonicalName":"IPriceGuard.PairConfig","documentation":{"id":7455,"nodeType":"StructuredDocumentation","src":"777:389:16","text":" @notice Reference-oracle configuration for one Uniswap V4 pool.\n @dev At least one of `chainlinkFeed` or `v3Pool` must be configured by the implementation. The Chainlink feed\n      is the primary reference and the V3 TWAP is the fallback. A `maxDeviationBps` of zero marks an unset\n      configuration, so implementations must reject zero when storing."},"id":7483,"members":[{"constant":false,"id":7458,"mutability":"mutable","name":"chainlinkFeed","nameLocation":"1309:13:16","nodeType":"VariableDeclaration","scope":7483,"src":"1301:21:16","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":7457,"name":"address","nodeType":"ElementaryTypeName","src":"1301:7:16","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":7461,"mutability":"mutable","name":"invertFeed","nameLocation":"1479:10:16","nodeType":"VariableDeclaration","scope":7483,"src":"1474:15:16","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":7460,"name":"bool","nodeType":"ElementaryTypeName","src":"1474:4:16","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":7464,"mutability":"mutable","name":"maxStaleness","nameLocation":"1609:12:16","nodeType":"VariableDeclaration","scope":7483,"src":"1602:19:16","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint32","typeString":"uint32"},"typeName":{"id":7463,"name":"uint32","nodeType":"ElementaryTypeName","src":"1602:6:16","typeDescriptions":{"typeIdentifier":"t_uint32","typeString":"uint32"}},"visibility":"internal"},{"constant":false,"id":7467,"mutability":"mutable","name":"minAnswer","nameLocation":"1765:9:16","nodeType":"VariableDeclaration","scope":7483,"src":"1757:17:16","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":7466,"name":"uint256","nodeType":"ElementaryTypeName","src":"1757:7:16","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":7470,"mutability":"mutable","name":"maxAnswer","nameLocation":"1918:9:16","nodeType":"VariableDeclaration","scope":7483,"src":"1910:17:16","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":7469,"name":"uint256","nodeType":"ElementaryTypeName","src":"1910:7:16","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":7473,"mutability":"mutable","name":"v3Pool","nameLocation":"2041:6:16","nodeType":"VariableDeclaration","scope":7483,"src":"2033:14:16","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":7472,"name":"address","nodeType":"ElementaryTypeName","src":"2033:7:16","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":7476,"mutability":"mutable","name":"invertV3","nameLocation":"2204:8:16","nodeType":"VariableDeclaration","scope":7483,"src":"2199:13:16","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":7475,"name":"bool","nodeType":"ElementaryTypeName","src":"2199:4:16","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":7479,"mutability":"mutable","name":"twapWindow","nameLocation":"2337:10:16","nodeType":"VariableDeclaration","scope":7483,"src":"2330:17:16","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint32","typeString":"uint32"},"typeName":{"id":7478,"name":"uint32","nodeType":"ElementaryTypeName","src":"2330:6:16","typeDescriptions":{"typeIdentifier":"t_uint32","typeString":"uint32"}},"visibility":"internal"},{"constant":false,"id":7482,"mutability":"mutable","name":"maxDeviationBps","nameLocation":"2491:15:16","nodeType":"VariableDeclaration","scope":7483,"src":"2484:22:16","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"},"typeName":{"id":7481,"name":"uint16","nodeType":"ElementaryTypeName","src":"2484:6:16","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"}},"visibility":"internal"}],"name":"PairConfig","nameLocation":"1178:10:16","nodeType":"StructDefinition","scope":7543,"src":"1171:1342:16","visibility":"public"},{"anonymous":false,"documentation":{"id":7484,"nodeType":"StructuredDocumentation","src":"2519:514:16","text":" @notice Emitted when a pool reference configuration is stored.\n @dev Emitted by `setPairConfig` after validation and storage, so indexers always see the stored values.\n @param poolId Uniswap V4 pool id derived from `key`.\n @param key Uniswap V4 pool key configured by the owner.\n @param config Oracle and deviation configuration stored for the pool.\n @param decimals0 Cached decimals for `key.currency0`.\n @param decimals1 Cached decimals for `key.currency1`."},"eventSelector":"68937cf29d67c2708cbe0c1e521c7b474f55187cbd273051bbc263f9f7f73e9e","id":7498,"name":"PairConfigSet","nameLocation":"3044:13:16","nodeType":"EventDefinition","parameters":{"id":7497,"nodeType":"ParameterList","parameters":[{"constant":false,"id":7486,"indexed":true,"mutability":"mutable","name":"poolId","nameLocation":"3074:6:16","nodeType":"VariableDeclaration","scope":7498,"src":"3058:22:16","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":7485,"name":"bytes32","nodeType":"ElementaryTypeName","src":"3058:7:16","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"visibility":"internal"},{"constant":false,"id":7489,"indexed":false,"mutability":"mutable","name":"key","nameLocation":"3090:3:16","nodeType":"VariableDeclaration","scope":7498,"src":"3082:11:16","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$8059_memory_ptr","typeString":"struct PoolKey"},"typeName":{"id":7488,"nodeType":"UserDefinedTypeName","pathNode":{"id":7487,"name":"PoolKey","nameLocations":["3082:7:16"],"nodeType":"IdentifierPath","referencedDeclaration":8059,"src":"3082:7:16"},"referencedDeclaration":8059,"src":"3082:7:16","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$8059_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"},{"constant":false,"id":7492,"indexed":false,"mutability":"mutable","name":"config","nameLocation":"3106:6:16","nodeType":"VariableDeclaration","scope":7498,"src":"3095:17:16","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_struct$_PairConfig_$7483_memory_ptr","typeString":"struct IPriceGuard.PairConfig"},"typeName":{"id":7491,"nodeType":"UserDefinedTypeName","pathNode":{"id":7490,"name":"PairConfig","nameLocations":["3095:10:16"],"nodeType":"IdentifierPath","referencedDeclaration":7483,"src":"3095:10:16"},"referencedDeclaration":7483,"src":"3095:10:16","typeDescriptions":{"typeIdentifier":"t_struct$_PairConfig_$7483_storage_ptr","typeString":"struct IPriceGuard.PairConfig"}},"visibility":"internal"},{"constant":false,"id":7494,"indexed":false,"mutability":"mutable","name":"decimals0","nameLocation":"3120:9:16","nodeType":"VariableDeclaration","scope":7498,"src":"3114:15:16","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":7493,"name":"uint8","nodeType":"ElementaryTypeName","src":"3114:5:16","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"visibility":"internal"},{"constant":false,"id":7496,"indexed":false,"mutability":"mutable","name":"decimals1","nameLocation":"3137:9:16","nodeType":"VariableDeclaration","scope":7498,"src":"3131:15:16","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":7495,"name":"uint8","nodeType":"ElementaryTypeName","src":"3131:5:16","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"visibility":"internal"}],"src":"3057:90:16"},"src":"3038:110:16"},{"documentation":{"id":7499,"nodeType":"StructuredDocumentation","src":"3154:525:16","text":" @notice Stores or replaces the oracle configuration for a Uniswap V4 pool.\n @dev Restricted to the owner, which is expected to be a timelock. Implementations must validate the\n      configuration, cache both currencies' decimals, and confirm that the converted reference price agrees\n      with the live pool price before storing, and must emit `PairConfigSet`.\n @param key Pool key identifying the V4 pool.\n @param config Oracle reference and deviation settings for the pool."},"functionSelector":"c2e85d2d","id":7508,"implemented":false,"kind":"function","modifiers":[],"name":"setPairConfig","nameLocation":"3693:13:16","nodeType":"FunctionDefinition","parameters":{"id":7506,"nodeType":"ParameterList","parameters":[{"constant":false,"id":7502,"mutability":"mutable","name":"key","nameLocation":"3724:3:16","nodeType":"VariableDeclaration","scope":7508,"src":"3707:20:16","stateVariable":false,"storageLocation":"calldata","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$8059_calldata_ptr","typeString":"struct PoolKey"},"typeName":{"id":7501,"nodeType":"UserDefinedTypeName","pathNode":{"id":7500,"name":"PoolKey","nameLocations":["3707:7:16"],"nodeType":"IdentifierPath","referencedDeclaration":8059,"src":"3707:7:16"},"referencedDeclaration":8059,"src":"3707:7:16","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$8059_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"},{"constant":false,"id":7505,"mutability":"mutable","name":"config","nameLocation":"3749:6:16","nodeType":"VariableDeclaration","scope":7508,"src":"3729:26:16","stateVariable":false,"storageLocation":"calldata","typeDescriptions":{"typeIdentifier":"t_struct$_PairConfig_$7483_calldata_ptr","typeString":"struct IPriceGuard.PairConfig"},"typeName":{"id":7504,"nodeType":"UserDefinedTypeName","pathNode":{"id":7503,"name":"PairConfig","nameLocations":["3729:10:16"],"nodeType":"IdentifierPath","referencedDeclaration":7483,"src":"3729:10:16"},"referencedDeclaration":7483,"src":"3729:10:16","typeDescriptions":{"typeIdentifier":"t_struct$_PairConfig_$7483_storage_ptr","typeString":"struct IPriceGuard.PairConfig"}},"visibility":"internal"}],"src":"3706:50:16"},"returnParameters":{"id":7507,"nodeType":"ParameterList","parameters":[],"src":"3765:0:16"},"scope":7543,"src":"3684:82:16","stateMutability":"nonpayable","virtual":false,"visibility":"external"},{"documentation":{"id":7509,"nodeType":"StructuredDocumentation","src":"3772:645:16","text":" @notice Checks whether the current V4 pool price is within the configured deviation from the reference price.\n @dev Must not mutate state. Stale, missing or invalid oracle data returns `(false, type(uint256).max)` rather\n      than reverting, so callers can raise one clear error; only a pool without a configuration reverts.\n @param key Pool key identifying the V4 pool to check.\n @return trusted True when the pool price is within the configured deviation and safety checks pass.\n @return devBps Observed deviation in basis points, or `type(uint256).max` when no trusted reference is available."},"functionSelector":"cf8b06c0","id":7519,"implemented":false,"kind":"function","modifiers":[],"name":"isPriceTrusted","nameLocation":"4431:14:16","nodeType":"FunctionDefinition","parameters":{"id":7513,"nodeType":"ParameterList","parameters":[{"constant":false,"id":7512,"mutability":"mutable","name":"key","nameLocation":"4463:3:16","nodeType":"VariableDeclaration","scope":7519,"src":"4446:20:16","stateVariable":false,"storageLocation":"calldata","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$8059_calldata_ptr","typeString":"struct PoolKey"},"typeName":{"id":7511,"nodeType":"UserDefinedTypeName","pathNode":{"id":7510,"name":"PoolKey","nameLocations":["4446:7:16"],"nodeType":"IdentifierPath","referencedDeclaration":8059,"src":"4446:7:16"},"referencedDeclaration":8059,"src":"4446:7:16","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$8059_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"}],"src":"4445:22:16"},"returnParameters":{"id":7518,"nodeType":"ParameterList","parameters":[{"constant":false,"id":7515,"mutability":"mutable","name":"trusted","nameLocation":"4496:7:16","nodeType":"VariableDeclaration","scope":7519,"src":"4491:12:16","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":7514,"name":"bool","nodeType":"ElementaryTypeName","src":"4491:4:16","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":7517,"mutability":"mutable","name":"devBps","nameLocation":"4513:6:16","nodeType":"VariableDeclaration","scope":7519,"src":"4505:14:16","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":7516,"name":"uint256","nodeType":"ElementaryTypeName","src":"4505:7:16","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"4490:30:16"},"scope":7543,"src":"4422:99:16","stateMutability":"view","virtual":false,"visibility":"external"},{"documentation":{"id":7520,"nodeType":"StructuredDocumentation","src":"4527:323:16","text":" @notice Returns the current trusted oracle reference price for a pool.\n @dev Reverts when the pair is not configured or its oracle/reference is not currently usable.\n @param key Pool key identifying the configured V4 pool.\n @return sqrtPriceX96 Trusted reference price in Q64.96 format."},"functionSelector":"4f2aa232","id":7528,"implemented":false,"kind":"function","modifiers":[],"name":"referenceSqrtPriceX96","nameLocation":"4864:21:16","nodeType":"FunctionDefinition","parameters":{"id":7524,"nodeType":"ParameterList","parameters":[{"constant":false,"id":7523,"mutability":"mutable","name":"key","nameLocation":"4903:3:16","nodeType":"VariableDeclaration","scope":7528,"src":"4886:20:16","stateVariable":false,"storageLocation":"calldata","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$8059_calldata_ptr","typeString":"struct PoolKey"},"typeName":{"id":7522,"nodeType":"UserDefinedTypeName","pathNode":{"id":7521,"name":"PoolKey","nameLocations":["4886:7:16"],"nodeType":"IdentifierPath","referencedDeclaration":8059,"src":"4886:7:16"},"referencedDeclaration":8059,"src":"4886:7:16","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$8059_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"}],"src":"4885:22:16"},"returnParameters":{"id":7527,"nodeType":"ParameterList","parameters":[{"constant":false,"id":7526,"mutability":"mutable","name":"sqrtPriceX96","nameLocation":"4939:12:16","nodeType":"VariableDeclaration","scope":7528,"src":"4931:20:16","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":7525,"name":"uint160","nodeType":"ElementaryTypeName","src":"4931:7:16","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"}],"src":"4930:22:16"},"scope":7543,"src":"4855:98:16","stateMutability":"view","virtual":false,"visibility":"external"},{"documentation":{"id":7529,"nodeType":"StructuredDocumentation","src":"4959:428:16","text":" @notice Returns the stored oracle configuration and cached currency decimals for a pool.\n @dev An unset pool returns a zeroed configuration; callers distinguish it by `maxDeviationBps == 0`.\n @param key Pool key identifying the V4 pool.\n @return config Stored pair configuration.\n @return decimals0 Cached decimals for currency0.\n @return decimals1 Cached decimals for currency1."},"functionSelector":"8bae2724","id":7542,"implemented":false,"kind":"function","modifiers":[],"name":"configOf","nameLocation":"5401:8:16","nodeType":"FunctionDefinition","parameters":{"id":7533,"nodeType":"ParameterList","parameters":[{"constant":false,"id":7532,"mutability":"mutable","name":"key","nameLocation":"5427:3:16","nodeType":"VariableDeclaration","scope":7542,"src":"5410:20:16","stateVariable":false,"storageLocation":"calldata","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$8059_calldata_ptr","typeString":"struct PoolKey"},"typeName":{"id":7531,"nodeType":"UserDefinedTypeName","pathNode":{"id":7530,"name":"PoolKey","nameLocations":["5410:7:16"],"nodeType":"IdentifierPath","referencedDeclaration":8059,"src":"5410:7:16"},"referencedDeclaration":8059,"src":"5410:7:16","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$8059_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"}],"src":"5409:22:16"},"returnParameters":{"id":7541,"nodeType":"ParameterList","parameters":[{"constant":false,"id":7536,"mutability":"mutable","name":"config","nameLocation":"5497:6:16","nodeType":"VariableDeclaration","scope":7542,"src":"5479:24:16","stateVariable":false,"storageLocation":"memory","typeDescriptions":{"typeIdentifier":"t_struct$_PairConfig_$7483_memory_ptr","typeString":"struct IPriceGuard.PairConfig"},"typeName":{"id":7535,"nodeType":"UserDefinedTypeName","pathNode":{"id":7534,"name":"PairConfig","nameLocations":["5479:10:16"],"nodeType":"IdentifierPath","referencedDeclaration":7483,"src":"5479:10:16"},"referencedDeclaration":7483,"src":"5479:10:16","typeDescriptions":{"typeIdentifier":"t_struct$_PairConfig_$7483_storage_ptr","typeString":"struct IPriceGuard.PairConfig"}},"visibility":"internal"},{"constant":false,"id":7538,"mutability":"mutable","name":"decimals0","nameLocation":"5511:9:16","nodeType":"VariableDeclaration","scope":7542,"src":"55