{"absolutePath":"src/libraries/PosmActions.sol","exportedSymbols":{"PosmActions":[9433]},"id":9434,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":9399,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:27"},{"abstract":false,"baseContracts":[],"canonicalName":"PosmActions","contractDependencies":[],"contractKind":"library","documentation":{"id":9400,"nodeType":"StructuredDocumentation","src":"57:557:27","text":" @title Position Manager Action Constants\n @notice Action ids used when encoding calls for the Uniswap V4 periphery position manager.\n @dev Action IDs are checked against the pinned v4-periphery Actions library in tests.\n      Each id is one byte of the `actions` argument passed to `PositionManager.modifyLiquidities`, paired with an\n      ABI-encoded entry in the `params` array. The values must match the deployed PositionManager exactly; the\n      fork tests assert them against the pinned release, so never edit them from memory."},"fullyImplemented":true,"id":9433,"linearizedBaseContracts":[9433],"name":"PosmActions","nameLocation":"623:11:27","nodeType":"ContractDefinition","nodes":[{"constant":true,"documentation":{"id":9401,"nodeType":"StructuredDocumentation","src":"641:174:27","text":" @notice Increase liquidity action id.\n @dev Params: `(tokenId, liquidity, amount0Max, amount1Max, hookData)`. Adds liquidity to an existing position."},"id":9404,"mutability":"constant","name":"INCREASE_LIQUIDITY","nameLocation":"844:18:27","nodeType":"VariableDeclaration","scope":9433,"src":"820:49:27","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":9402,"name":"uint8","nodeType":"ElementaryTypeName","src":"820:5:27","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"value":{"hexValue":"30783030","id":9403,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"865:4:27","typeDescriptions":{"typeIdentifier":"t_rational_0_by_1","typeString":"int_const 0"},"value":"0x00"},"visibility":"internal"},{"constant":true,"documentation":{"id":9405,"nodeType":"StructuredDocumentation","src":"875:174:27","text":" @notice Decrease liquidity action id.\n @dev Params: `(tokenId, liquidity, amount0Min, amount1Min, hookData)`. A liquidity of zero collects fees only."},"id":9408,"mutability":"constant","name":"DECREASE_LIQUIDITY","nameLocation":"1078:18:27","nodeType":"VariableDeclaration","scope":9433,"src":"1054:49:27","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":9406,"name":"uint8","nodeType":"ElementaryTypeName","src":"1054:5:27","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"value":{"hexValue":"30783031","id":9407,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"1099:4:27","typeDescriptions":{"typeIdentifier":"t_rational_1_by_1","typeString":"int_const 1"},"value":"0x01"},"visibility":"internal"},{"constant":true,"documentation":{"id":9409,"nodeType":"StructuredDocumentation","src":"1109:215:27","text":" @notice Mint position action id.\n @dev Params: `(poolKey, tickLower, tickUpper, liquidity, amount0Max, amount1Max, owner, hookData)`. Creates a\n      new position NFT owned by `owner`."},"id":9412,"mutability":"constant","name":"MINT_POSITION","nameLocation":"1353:13:27","nodeType":"VariableDeclaration","scope":9433,"src":"1329:44:27","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":9410,"name":"uint8","nodeType":"ElementaryTypeName","src":"1329:5:27","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"value":{"hexValue":"30783032","id":9411,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"1369:4:27","typeDescriptions":{"typeIdentifier":"t_rational_2_by_1","typeString":"int_const 2"},"value":"0x02"},"visibility":"internal"},{"constant":true,"documentation":{"id":9413,"nodeType":"StructuredDocumentation","src":"1379:165:27","text":" @notice Burn position action id.\n @dev Params: `(tokenId, amount0Min, amount1Min, hookData)`. Removes remaining liquidity and burns the NFT."},"id":9416,"mutability":"constant","name":"BURN_POSITION","nameLocation":"1573:13:27","nodeType":"VariableDeclaration","scope":9433,"src":"1549:44:27","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":9414,"name":"uint8","nodeType":"ElementaryTypeName","src":"1549:5:27","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"value":{"hexValue":"30783033","id":9415,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"1589:4:27","typeDescriptions":{"typeIdentifier":"t_rational_3_by_1","typeString":"int_const 3"},"value":"0x03"},"visibility":"internal"},{"constant":true,"documentation":{"id":9417,"nodeType":"StructuredDocumentation","src":"1599:162:27","text":" @notice Settle a currency pair action id.\n @dev Params: `(currency0, currency1)`. Pays the debts owed to the PoolManager from the caller."},"id":9420,"mutability":"constant","name":"SETTLE_PAIR","nameLocation":"1790:11:27","nodeType":"VariableDeclaration","scope":9433,"src":"1766:42:27","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":9418,"name":"uint8","nodeType":"ElementaryTypeName","src":"1766:5:27","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"value":{"hexValue":"30783064","id":9419,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"1804:4:27","typeDescriptions":{"typeIdentifier":"t_rational_13_by_1","typeString":"int_const 13"},"value":"0x0d"},"visibility":"internal"},{"constant":true,"documentation":{"id":9421,"nodeType":"StructuredDocumentation","src":"1814:169:27","text":" @notice Take a currency pair action id.\n @dev Params: `(currency0, currency1, recipient)`. Sends credits owed by the PoolManager to `recipient`."},"id":9424,"mutability":"constant","name":"TAKE_PAIR","nameLocation":"2012:9:27","nodeType":"VariableDeclaration","scope":9433,"src":"1988:40:27","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":9422,"name":"uint8","nodeType":"ElementaryTypeName","src":"1988:5:27","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"value":{"hexValue":"30783131","id":9423,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"2024:4:27","typeDescriptions":{"typeIdentifier":"t_rational_17_by_1","typeString":"int_const 17"},"value":"0x11"},"visibility":"internal"},{"constant":true,"documentation":{"id":9425,"nodeType":"StructuredDocumentation","src":"2034:227:27","text":" @notice Close currency action id.\n @dev Params: `(currency)`. Settles a negative currency delta from the caller or takes a positive one to the\n      caller, whichever direction the delta requires."},"id":9428,"mutability":"constant","name":"CLOSE_CURRENCY","nameLocation":"2290:14:27","nodeType":"VariableDeclaration","scope":9433,"src":"2266:45:27","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":9426,"name":"uint8","nodeType":"ElementaryTypeName","src":"2266:5:27","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"value":{"hexValue":"30783132","id":9427,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"2307:4:27","typeDescriptions":{"typeIdent