"17067:353:8"}]},"documentation":{"id":626,"nodeType":"StructuredDocumentation","src":"16270:574:8","text":" @notice Checks that a V3 pool holds the same token pair as the V4 pool key.\n @dev Native ETH in the key is mapped to `nativeWrapper`. When `invertV3` is true the V3 pool must list the\n      tokens in the opposite order to the V4 key, otherwise in the same order. Reverts with `InvalidV3Pool`\n      on a mismatch or if the V3 token reads revert.\n @param key Pool key whose tokens are matched.\n @param v3Pool Candidate Uniswap V3 pool.\n @param invertV3 Whether the V3 pool's token ordering is reversed against the V4 key."},"id":700,"implemented":true,"kind":"function","modifiers":[],"name":"_validateV3Tokens","nameLocation":"16858:17:8","nodeType":"FunctionDefinition","parameters":{"id":634,"nodeType":"ParameterList","parameters":[{"constant":false,"id":629,"mutability":"mutable","name":"key","nameLocation":"16893:3:8","nodeType":"VariableDeclaration","scope":700,"src":"16876:20:8","stateVariable":false,"storageLocation":"calldata","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$5888_calldata_ptr","typeString":"struct PoolKey"},"typeName":{"id":628,"nodeType":"UserDefinedTypeName","pathNode":{"id":627,"name":"PoolKey","nameLocations":["16876:7:8"],"nodeType":"IdentifierPath","referencedDeclaration":5888,"src":"16876:7:8"},"referencedDeclaration":5888,"src":"16876:7:8","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$5888_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"},{"constant":false,"id":631,"mutability":"mutable","name":"v3Pool","nameLocation":"16906:6:8","nodeType":"VariableDeclaration","scope":700,"src":"16898:14:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":630,"name":"address","nodeType":"ElementaryTypeName","src":"16898:7:8","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"