teViewLike.sol","id":17,"nameLocation":"-1:-1:-1","nodeType":"ImportDirective","scope":1570,"sourceUnit":5422,"src":"570:72:8","symbolAliases":[{"foreign":{"id":16,"name":"IStateViewLike","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":5421,"src":"578:14:8","typeDescriptions":{}},"nameLocation":"-1:-1:-1"}],"unitAlias":""},{"absolutePath":"src/interfaces/external/IUniswapV3PoolLike.sol","file":"./interfaces/external/IUniswapV3PoolLike.sol","id":19,"nameLocation":"-1:-1:-1","nodeType":"ImportDirective","scope":1570,"sourceUnit":5451,"src":"643:80:8","symbolAliases":[{"foreign":{"id":18,"name":"IUniswapV3PoolLike","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":5450,"src":"651:18:8","typeDescriptions":{}},"nameLocation":"-1:-1:-1"}],"unitAlias":""},{"absolutePath":"src/libraries/Types.sol","file":"./libraries/Types.sol","id":22,"nameLocation":"-1:-1:-1","nodeType":"ImportDirective","scope":1570,"sourceUnit":5984,"src":"724:56:8","symbolAliases":[{"foreign":{"id":20,"name":"Currency","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":5869,"src":"732:8:8","typeDescriptions":{}},"nameLocation":"-1:-1:-1"},{"foreign":{"id":21,"name":"PoolKey","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":5888,"src":"742:7:8","typeDescriptions":{}},"nameLocation":"-1:-1:-1"}],"unitAlias":""},{"absolutePath":"src/libraries/PoolIdLib.sol","file":"./libraries/PoolIdLib.sol","id":24,"nameLocation":"-1:-1:-1","nodeType":"ImportDirective","scope":1570,"sourceUnit":5474,"src":"781:52:8","symbolAliases":[{"foreign":{"id":23,"name":"PoolIdLib","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":5473,"src":"789:9:8","typeDescriptions":{}},"nameLocation":"-1:-1:-1"}],"unitAlias":""},{"absolutePath":"src/libraries/SqrtPriceMath.sol","file":"./libraries/SqrtPriceMath.sol","id":26,"nameLocation":"-1:-1:-1","nodeType":"ImportDirective","scope":1570,"sourceUnit":5866,"src":"834:60:8","symbolAliases":[{"foreign":{"id":25,"name":"SqrtPriceMath","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":5865,"src":"842:13:8","typeDescriptions":{}},"nameLocation":"-1:-1:-1"}],"unitAlias":""},{"abstract":false,"baseContracts":[{"baseName":{"id":28,"name":"IPriceGuard","nameLocations":["2097:11:8"],"nodeType":"IdentifierPath","referencedDeclaration":5345,"src":"2097:11:8"},"id":29,"nodeType":"InheritanceSpecifier","src":"2097:11:8"},{"baseName":{"id":30,"name":"Ownable2Step","nameLocations":["2110:12:8"],"nodeType":"IdentifierPath","referencedDeclaration":1803,"src":"2110:12:8"},"id":31,"nodeType":"InheritanceSpecifier","src":"2110:12:8"}],"canonicalName":"PriceGuard","contractDependencies":[],"contractKind":"contract","documentation":{"id":27,"nodeType":"StructuredDocumentation","src":"896:1028:8","text":" @title PriceGuard\n @notice Validates Uniswap V4 pool prices against Chainlink and Uniswap V3 TWAP references.\n @dev Ownership uses OpenZeppelin Ownable2Step so the deployer can transfer control to a timelock that must\n      explicitly accept ownership before managing pair configurations.\n      Reference selection: the Chainlink feed is tried first; if it is unset or its answer is rejected, the\n      Uniswap V3 TWAP is used. If neither produces a price the pool is reported as untrusted.\n      Trust model: the owner is trusted to configure correct feeds, answer bounds, TWAP pools and deviation\n      limits. Everything read at runtime (pool state, feeds, token metadata, sequencer feed) is untrusted and\n      every failure maps to \"not trusted\" rather than a revert, except for a missing configuration.\n      The only state-changing function is `setPairConfig` (plus the inherited two-step ownership functions).\n      Withdrawals in consumer contracts must never call this contract."},"fullyImplemented":true,"id":1569,"linearizedBaseContracts":[1569,1803,1717,6013,5345],"name":"PriceGuard","nameLocation":"2083:10:8","nodeType":"ContractDefinition","nodes":[{"global":false,"id":35,"libraryName":{"id":32,"name":"PoolIdLib","nameLocations":["2135:9:8"],"nodeType":"IdentifierPath","referencedDeclaration":5473,"src":"2135:9:8"},"nodeType":"UsingForDirective","src":"2129:28:8","typeName":{"id":34,"nodeType":"UserDefinedTypeName","pathNode":{"id":33,"name":"PoolKey","nameLocations":["2149:7:8"],"nodeType":"IdentifierPath","referencedDeclaration":5888,"src":"2149:7:8"},"referencedDeclaration":5888,"src":"2149:7:8","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$5888_storage_ptr","typeString":"struct PoolKey"}}},{"documentation":{"id":36,"nodeType":"StructuredDocumentation","src":"2163:170:8","text":" @notice A required address argument is zero.\n @dev Thrown by the constructor when `stateView_`, `nativeWrapper_` or `owner_` is the zero address."},"errorSelector":"d92e233d","id":38,"name":"ZeroAddress","nameLocation":"2344:11:8","nodeType":"ErrorDefinition","parameters":{"id":37,"nodeType":"ParameterList","parameters":[],"src":"2355:2:8"},"src":"2338:20:8"},{"documentation":{"id":39,"nodeType":"StructuredDocumentation","src":"2363:180:8","text":" @notice A pair configuration does not include any usable reference oracle.\n @dev Thrown by `setPairConfig` when both `chainlinkFeed` and `v3Pool` are zero."},"errorSelector":"46b4f71d","id":41,"name":"NoReference","nameLocation":"2554:11:8","nodeType":"ErrorDefinition","parameters":{"id":40,"nodeType":"ParameterList","parameters":[],"src":"2565:2:8"},"src":"2548:20:8"},{"documentation":{"id":42,"nodeType":"StructuredDocumentation","src":"2573:205:8","text":" @notice The configured maximum deviation is outside the allowed bounds.\n @dev Thrown by `setPairConfig` unless `maxDeviationBps` is within `[MIN_DEVIATION_BPS, MAX_DEVIATION_BPS]`."},"errorSelector":"7c2f3dca","id":44,"name":"InvalidDeviation","nameLocation":"2789:16:8","nodeType":"ErrorDefinition","parameters":{"id":43,"nodeType":"ParameterList","parameters":[],"src":"2805:2:8"},"src":"2783:25:8"},{"documentation":{"id":45,"nodeType":"StructuredDocumentation","src":"2813:180:8","text":" @notice The V3 TWAP window is below the required minimum.\n @dev Thrown by `setPairConfig` when `v3Pool` is set and `twapWindow` is below `MIN_TWAP_WINDOW`."},"errorSelector":"bbedb50a","id":47,"name":"InvalidTwapWindow","nameLocation":"3004:17:8","nodeType":"ErrorDefinition","parameters":{"id":46,"nodeType":"ParameterList","parameters":[],"src":"3021:2:8"},"src":"2998:26:8"},{"documentation":{"id":48,"nodeType":"StructuredDocumentation","src":"3029:164:8","text":" @notice The configured Chainlink feed cannot be queried as expected.\n @dev Thrown by `setPairConfig` when `decimals()` on the feed reverts."},"errorSelector":"1f86e170","id":50,"name":"InvalidFeed","nameLocation":"3204:11:8","nodeType":"ErrorDefinition","parameters":{"id":49,"nodeType":"ParameterList","parameters":[],"src":"3215:2:8"},"src":"3198:20:8"},{"documentation":{"id":51,"nodeType":"StructuredDocumentation","src":"3223:163:8","text":" @notice Chainlink answer bounds are malformed.\n @dev Thrown by `setPairConfig` when `minAnswer` is zero or not strictly below `maxAnswer`."},"errorSelector":"6a326ec2","id":53,"name":"InvalidAnswerBounds","nameLocation":"3397:19:8","nodeType":"ErrorDefinition","parameters":{"id":52,"nodeType":"ParameterList","parameters":[],"src":"3416:2:8"},"src":"3391:28:8"},{"documentation":{"id":54,"nodeType":"StructuredDocumentation","src":"3424:312:8","text":" @notice The V3 fallback pool does not match the configured V4 pool tokens and orientation.\n @dev Thrown by `setPairConfig` when the V3 pool's tokens differ from the pool key tokens (with the wrapped\n      native token standing in for native ETH), or when the V3 token reads revert."},"errorSelector":"43c927f6","id":56,"name":"InvalidV3Pool","nameLocation":"3747:13:8","nodeType":"ErrorDefinition","parameters":{"id":55,"nodeType":"ParameterList","parameters":[],"src":"3760:2:8"},"src":"3741:22:8"},{"documentation":{"id":57,"nodeType":"StructuredDocumentation","src":"3768:192:8","text":" @notice No pair configuration exists for the requested pool.\n @dev Thrown by `isPriceTrusted` when `maxDeviationBps` is zero, which is only the case for unset configs."},"errorSelector":"0d9d9394","id":59,"name":"NoConfig","nameLocation":"3971:8:8","nodeType":"ErrorDefinition","parameters":{"id":58,"nodeType":"ParameterList","parameters":[],"src":"3979:2:8"},"src":"3965:17:8"},{"documentation":{"id":60,"nodeType":"StructuredDocumentation","src":"3987:80:8","text":" @notice No valid configured oracle reference can be produced."},"errorSelector":"5f41ff92","id":62,"name":"InvalidReference","nameLocation":"4078:16:8","nodeType":"ErrorDefinition","parameters":{"id":61,"nodeType":"ParameterList","parameters":[],"src":"4094:2:8"},"src":"4072:25:8"},{"documentation":{"id":63,"nodeType":"StructuredDocumentation","src":"4102:202:8","text":" @notice A price ratio cannot be represented as a uint160 sqrtPriceX96 value.\n @dev Thrown by `_sqrtFromRatio` when the square root of the Q192 ratio exceeds `type(uint160).max`."},"errorSelector":"37c8a83c","id":65,"name":"PriceOutOfRange","nameLocation":"4315:15:8","nodeType":"ErrorDefinition","parameters":{"id":64,"nodeType":"ParameterList","parameters":[],"src":"4330:2:8"},"src":"4309:24:8"},{"documentation":{"id":66,"nodeType":"StructuredDocumentation","src":"4338:399:8","text":" @notice The configured reference price does not match the live pool price within the allowed deviation.\n @dev Thrown by `setPairConfig` when the pool is uninitialized, the reference is unavailable at\n      configuration time, or the initial deviation exceeds `maxDeviationBps`. This catches wrong feed\n      orientation and wrong decimals before they are stored."},"errorSelector":"b3cd5c66","id":68,"name":"InvalidInitialPrice","nameLocation":"4748:19:8","nodeType":"ErrorDefinition","parameters":{"id":67,"nodeType":"ParameterList","parameters":[],"src":"4767:2:8"},"src":"4742:28:8"},{"constant":true,"documentation":{"id":69,"nodeType":"StructuredDocumentation","src":"4776:197:8","text":" @notice Highest token/feed decimal value accepted before exponentiation.\n @dev `10 ** 77` is the largest power of ten that fits in a uint256, so larger values are rejected."},"id":72,"mutability":"constant","name":"MAX_SAFE_DECIMALS","nameLocation":"5002:17:8","nodeType":"VariableDeclaration","scope":1569,"src":"4978:46:8","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":70,"name":"uint8","nodeType":"ElementaryTypeName","src":"4978:5:8","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"value":{"hexValue":"3737","id":71,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"5022:2:8","typeDescriptions":{"typeIdentifier":"t_rational_77_by_1","typeString":"int_const 77"},"value":"77"},"visibility":"internal"},{"constant":true,"documentation":{"id":73,"nodeType":"StructuredDocumentation","src":"5030:190:8","text":" @notice Minimum allowed price deviation threshold, in basis points.\n @dev A zero threshold is disallowed because `maxDeviationBps == 0` marks an unset configuration."},"id":76,"mutability":"constant","name":"MIN_DEVIATION_BPS","nameLocation":"5250:17:8","nodeType":"VariableDeclaration","scope":1569,"src":"5225:46:8","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"},"typeName":{"id":74,"name":"uint16","nodeType":"ElementaryTypeName","src":"5225:6:8","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"}},"value":{"hexValue":"31","id":75,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"5270:1:8","typeDescriptions":{"typeIdentifier":"t_rational_1_by_1","typeString":"int_const 1"},"value":"1"},"visibility":"internal"},{"constant":true,"documentation":{"id":77,"nodeType":"StructuredDocumentation","src":"5277:51:8","text":" @notice Basis-point denominator."},"id":80,"mutability":"constant","name":"BPS_DENOMINATOR","nameLocation":"5358:15:8","nodeType":"VariableDeclaration","scope":1569,"src":"5333:46:8","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"},"typeName":{"id":78,"name":"uint16","nodeType":"ElementaryTypeName","src":"5333:6:8","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"}},"value":{"hexValue":"316534","id":79,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"5376:3:8","typeDescriptions":{"typeIdentifier":"t_rational_10000_by_1","typeString":"int_const 10000"},"value":"1e4"},"visibility":"internal"},{"constant":true,"documentation":{"id":81,"nodeType":"StructuredDocumentation","src":"5385:127:8","text":" @notice Maximum allowed price deviation threshold, in basis points.\n @dev 1,000 bps equals 10 percent."},"id":84,"mutability":"constant","name":"MAX_DEVIATION_BPS","nameLocation":"5542:17:8","nodeType":"VariableDeclaration","scope":1569,"src":"5517:50:8","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"},"typeName":{"id":82,"name":"uint16","nodeType":"ElementaryTypeName","src":"5517:6:8","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"}},"value":{"hexValue":"315f303030","id":83,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"5562:5:8","typeDescriptions":{"typeIdentifier":"t_rational_1000_by_1","typeString":"int_const 1000"},"value":"1_000"},"visibility":"internal"},{"constant":true,"documentation":{"id":85,"nodeType":"StructuredDocumentation","src":"5573:183:8","text":" @notice Minimum accepted Uniswap V3 TWAP window, in seconds.\n @dev Short windows are cheap to manipulate on thin pools, so ten minutes is enforced as a floor."},"id":88,"mutability":"constant","name":"MIN_TWAP_WINDOW","nameLocation":"5786:15:8","nodeType":"VariableDeclaration","scope":1569,"src":"5761:46:8","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint32","typeString":"uint32"},"typeName":{"id":86,"name":"uint32","nodeType":"ElementaryTypeName","src":"5761:6:8","typeDescriptions":{"typeIdentifier":"t_uint32","typeString":"uint32"}},"value":{"hexValue":"363030","id":87,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"5804:3:8","typeDescriptions":{"typeIdentifier":"t_rational_600_by_1","typeString":"int_const 600"},"value":"600"},"visibility":"internal"},{"constant":true,"documentation":{"id":89,"nodeType":"StructuredDocumentation","src":"5813:206:8","text":" @notice Required grace period after an L2 sequencer comes back online, in seconds.\n @dev Prices are not trusted until the sequencer has been up for strictly longer than this period."},"id":92,"mutability":"constant","name":"SEQUENCER_GRACE_PERIOD","nameLocation":"6049:22:8","nodeType":"VariableDeclaration","scope":1569,"src":"6024:55:8","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint32","typeString":"uint32"},"typeName":{"id":90,"name":"uint32","nodeType":"ElementaryTypeName","src":"6024:6:8","typeDescriptions":{"typeIdentifier":"t_uint32","typeString":"uint32"}},"value":{"hexValue":"335f363030","id":91,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"6074:5:8","typeDescriptions":{"typeIdentifier":"t_rational_3600_by_1","typeString":"int_const 3600"},"value":"3_600"},"visibility":"internal"},{"constant":false,"documentation":{"id":93,"nodeType":"StructuredDocumentation","src":"6086:147:8","text":" @notice Uniswap V4 StateView contract used to read pool slot0 values.\n @dev Set once in the constructor and never changed."},"functionSelector":"4c4a3c25","id":96,"mutability":"immutable","name":"stateView","nameLocation":"6270:9:8","nodeType":"VariableDeclaration","scope":1569,"src":"6238:41:8","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_contract$_IStateViewLike_$5421","typeString":"contract IStateViewLike"},"typeName":{"id":95,"nodeType":"UserDefinedTypeName","pathNode":{"id":94,"name":"IStateViewLike","nameLocations":["6238:14:8"],"nodeType":"IdentifierPath","referencedDeclaration":5421,"src":"6238:14:8"},"referencedDeclaration":5421,"src":"6238:14:8","typeDescriptions":{"typeIdentifier":"t_contract$_IStateViewLike_$5421","typeString":"contract IStateViewLike"}},"visibility":"public"},{"constant":false,"documentation":{"id":97,"nodeType":"StructuredDocumentation","src":"6285:179:8","text":" @notice Optional Chainlink L2 sequencer uptime feed; zero address means L1 deployment.\n @dev When zero, `_sequencerUp` always reports the sequencer as up."},"functionSelector":"a7264705","id":99,"mutability":"immutable","name":"sequencerUptimeFeed","nameLocation":"6494:19:8","nodeType":"VariableDeclaration","scope":1569,"src":"6469:44:8","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":98,"name":"address","nodeType":"ElementaryTypeName","src":"6469:7:8","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"public"},{"constant":false,"documentation":{"id":100,"nodeType":"StructuredDocumentation","src":"6519:210:8","text":" @notice Wrapped native token used when a V4 pool key contains the native currency sentinel.\n @dev Used only to match V4 native-ETH pools against V3 pools, which only hold ERC-20 tokens."},"functionSelector":"0b48a8b8","id":102,"mutability":"immutable","name":"nativeWrapper","nameLocation":"6759:13:8","nodeType":"VariableDeclaration","scope":1569,"