{"absolutePath":"src/interfaces/external/IAggregatorV3.sol","exportedSymbols":{"IAggregatorV3":[5369]},"id":5370,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":5347,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:10"},{"abstract":false,"baseContracts":[],"canonicalName":"IAggregatorV3","contractDependencies":[],"contractKind":"interface","documentation":{"id":5348,"nodeType":"StructuredDocumentation","src":"57:533:10","text":" @title Chainlink AggregatorV3 Minimal Interface\n @notice Minimal subset of the Chainlink AggregatorV3 interface required by PriceGuard.\n @dev Used for both price feeds and optional L2 sequencer uptime feeds.\n      Only the two functions PriceGuard needs are declared. For a sequencer uptime feed an `answer` of zero means\n      the sequencer is up and `updatedAt` is the time it last changed state. Callers must treat every returned\n      value as untrusted and validate sign, freshness and bounds themselves."},"fullyImplemented":false,"id":5369,"linearizedBaseContracts":[5369],"name":"IAggregatorV3","nameLocation":"601:13:10","nodeType":"ContractDefinition","nodes":[{"documentation":{"id":5349,"nodeType":"StructuredDocumentation","src":"621:230:10","text":" @notice Returns the number of decimals used by feed answers.\n @dev Reverts or misbehaves for contracts that are not Chainlink aggregators; callers should wrap the call.\n @return Feed answer decimals."},"functionSelector":"313ce567","id":5354,"implemented":false,"kind":"function","modifiers":[],"name":"decimals","nameLocation":"865:8:10","nodeType":"FunctionDefinition","parameters":{"id":5350,"nodeType":"ParameterList","parameters":[],"src":"873:2:10"},"returnParameters":{"id":5353,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5352,"mutability":"mutable","name":"","nameLocation":"-1:-1:-1","nodeType":"VariableDeclaration","scope":5354,"src":"899:5:10","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":5351,"name":"uint8","nodeType":"ElementaryTypeName","src":"899:5:10","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"visibility":"internal"}],"src":"898:7:10"},"scope":5369,"src":"856:50:10","stateMutability":"view","virtual":false,"visibility":"external"},{"documentation":{"id":5355,"nodeType":"StructuredDocumentation","src":"912:567:10","text":" @notice Returns data for the latest completed oracle round.\n @dev May revert if the feed has no completed round. The `answer` can be zero or negative and may be clamped\n      to the feed's built-in minimum or maximum during extreme market moves.\n @return roundId Latest round id.\n @return answer Latest answer for the feed.\n @return startedAt Timestamp when the round started.\n @return updatedAt Timestamp when the round was last updated.\n @return answeredInRound Round id in which the answer was computed."},"functionSelector":"feaf968c","id":5368,"implemented":false,"kind":"function","modifiers":[],"name":"latestRoundData","nameLocation":"1493:15:10","nodeType":"FunctionDefinition","parameters":{"id":5356,"nodeType":"ParameterList","parameters":[],"src":"1508:2:10"},"returnParameters":{"id":5367,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5358,"mutability":"mutable","name":"roundId","nameLocation":"1565:7:10","nodeType":"VariableDeclaration","scope":5368,"src":"1558:14:10","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint80","typeString":"uint80"},"typeName":{"id":5357,"name":"uint80","nodeType":"ElementaryTypeName","src":"1558:6:10","typeDescriptions":{"typeIdentifier":"t_uint80","typeString":"uint80"}},"visibility":"internal"},{"constant":false,"id":5360,"mutability":"mutable","name":"answer","nameLocation":"1581:6:10","nodeType":"VariableDeclaration","scope":5368,"src":"1574:13:10","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int256",