26092:12:8","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}}],"id":1169,"isConstant":false,"isInlineArray":false,"isLValue":false,"isPure":false,"lValueRequested":false,"nodeType":"TupleExpression","src":"26079:26:8","typeDescriptions":{"typeIdentifier":"t_tuple$_t_uint256_$_t_uint256_$","typeString":"tuple(uint256,uint256)"}},"typeDescriptions":{"typeIdentifier":"t_tuple$_t_uint256_$_t_uint256_$","typeString":"tuple(uint256,uint256)"}},"src":"26043:91:8","typeDescriptions":{"typeIdentifier":"t_tuple$__$","typeString":"tuple()"}},"id":1175,"nodeType":"ExpressionStatement","src":"26043:91:8"}]},"documentation":{"id":1095,"nodeType":"StructuredDocumentation","src":"24106:1286:8","text":" @notice Builds the raw-unit price ratio `token1 raw units / token0 raw units` from a feed answer.\n @dev With feed decimals `fd` and token decimals `d0`, `d1`:\n      - a feed quoting token1 per token0 gives `answer * 10**d1 / (10**fd * 10**d0)`;\n      - a feed quoting token0 per token1 (`invert`) gives `10**fd * 10**d1 / (answer * 10**d0)`.\n      The inverted form must re-derive the decimals scaling instead of swapping the direct ratio, because\n      the token decimals appear on opposite sides in the two cases. Swapping the direct ratio is only\n      correct when `d0 == d1`.\n      Returns `ok == false` if any multiplication overflows. `answer` must be non-zero when `invert` is set.\n @param invert Whether the feed quotes token0 per token1.\n @param answer Positive feed answer.\n @param feedDecimals Decimals of the feed answer; at most `MAX_SAFE_DECIMALS`.\n @param decimals0 Decimals of `currency0`; at most `MAX_SAFE_DECIMALS`.\n @param decimals1 Decimals of `currency1`; at most `MAX_SAFE_DECIMALS`.\n @return ok True when both products fit in 256 bits.\n @return numerator Numerator of the raw price ratio.\n @return denominator Denominator of the raw price ratio."},"id":1177,"implemented":true,"kind":"function","modifiers":[],"name":"_scaledRatio","nameLocation":"25406:12:8","nodeType":"FunctionDefinition","parameters":{"id":1106,"nodeType":"ParameterList","parameters":[{"constant":false,"id":1097,"mutability":"mutable","name":"invert","nameLocation":"25424:6:8","nodeType":"VariableDeclaration","scope":1177,"src":"25419:11:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":1096,"name":"bool","nodeType":"ElementaryTypeName","src":"25419:4:8","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":1099,"mutability":"mutable","name":"answer","nameLocation":"25440:6:8","nodeType":"VariableDeclaration","scope":1177,"src":"25432:14:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":1098,"name":"uint256","nodeType":"ElementaryTypeName","src":"25432:7:8","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":1101,"mutability":"mutable","name":"feedDecimals","nameLocation":"25456:12:8","nodeType":"VariableDeclaration","scope":1177,"src":"25448:20:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":1100,"name":"uint256","nodeType":"ElementaryTypeName","src":"25448:7:8","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":1103,"mutability":"mutable","name":"decimals0","nameLocation":"25476:9:8","nodeType":"VariableDeclaration","scope":1177,"src":"25470:15:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":1102,"name":"uint8","nodeType":"ElementaryTypeName","src":"25470:5:8","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"visibility":"internal"},{"constant":false,