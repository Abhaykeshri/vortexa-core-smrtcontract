"Identifier","overloadedDeclarations":[],"referencedDeclaration":11483,"src":"3235:10:25","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"nodeType":"BinaryOperation","operator":"<","rightExpression":{"id":11499,"name":"liquidity1","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":11491,"src":"3248:10:25","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"src":"3235:23:25","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"falseExpression":{"id":11502,"name":"liquidity1","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":11491,"src":"3274:10:25","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"id":11503,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"nodeType":"Conditional","src":"3235:49:25","trueExpression":{"id":11501,"name":"liquidity0","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":11483,"src":"3261:10:25","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"functionReturnParameters":11450,"id":11504,"nodeType":"Return","src":"3228:56:25"}]},"documentation":{"id":11436,"nodeType":"StructuredDocumentation","src":"1355:1176:25","text":" @notice Computes the maximum liquidity supported by token amounts in a price range.\n @dev Range endpoints are normalized; full-precision multiplication and checked narrowing prevent overflow.\n      Behavior by price position:\n      - current price at or below the lower bound: only currency0 limits liquidity;\n      - current price at or above the upper bound: only currency1 limits liquidity;\n      - current price inside the range: the smaller of the two single-token liquidities is returned, so the\n        scarcer token limits the position.\n      Reverts with `InvalidPriceRange` for a zero or empty range and with an OpenZeppelin `SafeCast` error\n      if the result does not fit in a uint128.\n @param sqrtPriceX96 The current Q64.96 square-root price.\n @param sqrtPriceAX96 One boundary of the Q64.96 price range.\n @param sqrtPriceBX96 The other boundary of the Q64.96 price range.\n @param amount0 The available currency0 amount.\n @param amount1 The available currency1 amount.\n @return liquidity The largest uint128 liquidity supported by both amounts."},"id":11506,"implemented":true,"kind":"function","modifiers":[],"name":"liquidityForAmounts","nameLocation":"2545:19:25","nodeType":"FunctionDefinition","parameters":{"id":11447,"nodeType":"ParameterList","parameters":[{"constant":false,"id":11438,"mutability":"mutable","name":"sqrtPriceX96","nameLocation":"2582:12:25","nodeType":"VariableDeclaration","scope":11506,"src":"2574:20:25","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":11437,"name":"uint160","nodeType":"ElementaryTypeName","src":"2574:7:25","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"},{"constant":false,"id":11440,"mutability":"mutable","name":"sqrtPriceAX96","nameLocation":"2612:13:25","nodeType":"VariableDeclaration","scope":11506,"src":"2604:21:25","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":11439,"name":"uint160","nodeType":"ElementaryTypeName","src":"2604:7:25","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"},{"constant":false,"id":11442,"mutability":"mutable","name":"sqrtPriceBX96","nameLocation":"2643:13:25","nodeType":"VariableDeclaration","scope":11506,"src":"2635:21:25","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":11441,"name":"uint160","nodeType":"ElementaryTypeName","src":"2635:7:25","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"},{"constant":false,"id":11444,"mutability":"mutable","name":"amount0","nameLocation":"2674:7:25","nodeType":"VariableDeclaration","scope":11506,"src":"2666:15:25","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":11443,"name":"uint256","nodeType":"ElementaryTypeName","src":"2666:7:25","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":11446,"mutability":"mutable","name":"amount1","nameLocation":"2699:7:25","nodeType":"VariableDeclaration","scope":11506,"src":"2691:15:25","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":11445,"name":"uint256","nodeType":"ElementaryTypeName","src":"2691:7:25","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"2564:148:25"},"returnParameters":{"id":11450,"nodeType":"ParameterList","parameters":[{"constant":false,"id":11449,"mutability":"mutable","name":"liquidity","nameLocation":"2744:9:25","nodeType":"VariableDeclaration","scope":11506,"src":"2736:17:25","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"},"typeName":{"id":11448,"name":"uint128","nodeType":"ElementaryTypeName","src":"2736:7:25","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"visibility":"internal"}],"src":"2735:19:25"},"scope":11720,"src":"2536:755:25","stateMutability":"pure","virtual":false,"visibility":"internal"},{"body":{"id":11569,"nodeType":"Block","src":"4384:458:25","statements":[{"assignments":[11523,11525],"declarations":[{"constant":false,"id":11523,"mutability":"mutable","name":"sqrtA","nameLocation":"4403:5:25","nodeType":"VariableDeclaration","scope":11569,"src":"4395: