{"absolutePath":"src/libraries/LiquidityMath.sol","exportedSymbols":{"LiquidityMath":[2597],"Math":[2164],"SafeCast":[5904]},"id":2598,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":2298,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:5"},{"absolutePath":"//?/C:/Users/Abhay/Desktop/vortexa-core/lib/openzeppelin-contracts/contracts/utils/math/Math.sol","file":"@openzeppelin/contracts/utils/math/Math.sol","id":2300,"nameLocation":"-1:-1:-1","nodeType":"ImportDirective","scope":2598,"sourceUnit":2165,"src":"57:65:5","symbolAliases":[{"foreign":{"id":2299,"name":"Math","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":2164,"src":"65:4:5","typeDescriptions":{}},"nameLocation":"-1:-1:-1"}],"unitAlias":""},{"absolutePath":"//?/C:/Users/Abhay/Desktop/vortexa-core/lib/openzeppelin-contracts/contracts/utils/math/SafeCast.sol","file":"@openzeppelin/contracts/utils/math/SafeCast.sol","id":2302,"nameLocation":"-1:-1:-1","nodeType":"ImportDirective","scope":2598,"sourceUnit":5905,"src":"123:73:5","symbolAliases":[{"foreign":{"id":2301,"name":"SafeCast","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":5904,"src":"131:8:5","typeDescriptions":{}},"nameLocation":"-1:-1:-1"}],"unitAlias":""},{"abstract":false,"baseContracts":[],"canonicalName":"LiquidityMath","contractDependencies":[],"contractKind":"library","documentation":{"id":2303,"nodeType":"StructuredDocumentation","src":"198:739:5","text":" @title Liquidity Math\n @notice Computes Uniswap-style liquidity and token amounts for Q64.96 price ranges.\n @dev Functions match the pinned Uniswap V4 math behavior used by M1 differential tests.\n      Rounding policy: liquidity and token amounts are always rounded down, so the amounts Uniswap pulls for the\n      computed liquidity never exceed the amounts supplied as inputs. Dust stays with the caller.\n      Safety: all products use OpenZeppelin full-precision `Math.mulDiv`, which guards the 512-bit\n      intermediate, and all `uint128` narrowing is checked and reverts instead of truncating. Production code\n      imports no Uniswap source; Uniswap's `LiquidityAmounts` is used only as a test oracle."},"fullyImplemented":true,"id":2597,"linearizedBaseContracts":[2597],"name":"LiquidityMath","nameLocation":"946:13:5","nodeType":"ContractDefinition","nodes":[{"documentation":{"id":2304,"nodeType":"StructuredDocumentation","src":"966:199:5","text":" @notice Price range endpoints are zero or equal after sorting.\n @dev Thrown when the lower endpoint is zero (division by zero risk) or both endpoints are equal (empty range)."},"errorSelector":"47ebe172","id":2306,"name":"InvalidPriceRange","nameLocation":"1176:17:5","nodeType":"ErrorDefinition","parameters":{"id":2305,"nodeType":"ParameterList","parameters":[],"src":"1193:2:5"},"src":"1170:26:5"},{"constant":true,"documentation":{"id":2307,"nodeType":"StructuredDocumentation","src":"1202:102:5","text":" @notice Fixed-point scaling factor for Q64.96 values.\n @dev Equal to `2**96`."},"id":2312,"mutability":"constant","name":"Q96","nameLocation":"1335:3:5","nodeType":"VariableDeclaration","scope":2597,"src":"1309:39:5","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":2308,"name":"uint256","nodeType":"ElementaryTypeName","src":"1309:7:5","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"value":{"commonType":{"typeIdentifier":"t_rational_79228162514264337593543950336_by_1","typeString":"int_const 79228162514264337593543950336"},"id":2311,"isConstant":false,"isLValue":false,"isPure":true,"lValueRequested":false,"leftExpression":{"hexValue":"31","id":2309,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"1341:1:5","typeDescriptions":{"typeIdentifier":"t_rational_1_by_1","typeString":"int_const 1"},"value":"1"},"nodeType":"BinaryOperation"