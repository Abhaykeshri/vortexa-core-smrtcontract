{"absolutePath":"src/interfaces/IPriceGuard.sol","exportedSymbols":{"IPriceGuard":[10521],"PoolKey":[12194]},"id":10522,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":10429,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:15"},{"absolutePath":"src/libraries/Types.sol","file":"../libraries/Types.sol","id":10431,"nameLocation":"-1:-1:-1","nodeType":"ImportDirective","scope":10522,"sourceUnit":12290,"src":"57:47:15","symbolAliases":[{"foreign":{"id":10430,"name":"PoolKey","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":12194,"src":"65:7:15","typeDescriptions":{}},"nameLocation":"-1:-1:-1"}],"unitAlias":""},{"abstract":false,"baseContracts":[],"canonicalName":"IPriceGuard","contractDependencies":[],"contractKind":"interface","documentation":{"id":10432,"nodeType":"StructuredDocumentation","src":"106:642:15","text":" @title PriceGuard Interface\n @notice Defines the configuration and runtime checks used to validate pool prices against oracle references.\n @dev Implementations are expected to compare a Uniswap V4 pool price with Chainlink and/or Uniswap V3 TWAP\n      references and return trust status without mutating state during price checks.\n      Consumers (vault, swap executor, factory) call `isPriceTrusted` in the same transaction as any action that\n      values shares or accepts a swap price, and never cache the result. Withdrawal paths must not call this\n      interface, so an oracle outage can never trap user funds."},"fullyImplemented":false,"id":10521,"linearizedBaseContracts":[10521],"name":"IPriceGuard","nameLocation":"759:11:15","nodeType":"ContractDefinition","nodes":[{"canonicalName":"IPriceGuard.PairConfig","documentation":{"id":10433,"nodeType":"StructuredDocumentation","src":"777:389:15","text":" @notice Reference-oracle configuration for one Uniswap V4 pool.\n @dev At least one of `chainlinkFeed` or `v3Pool` must be configured by the implementation. The Chainlink feed\n      is the primary reference and the V3 TWAP is the fallback. A `maxDeviationBps` of zero marks an unset\n      configuration, so implementations must reject zero when storing."},"id":10461,"members":[{"constant":false,"id":10436,"mutability":"mutable","name":"chainlinkFeed","nameLocation":"1309:13:15","nodeType":"VariableDeclaration","scope":10461,"src":"1301:21:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":10435,"name":"address","nodeType":"ElementaryTypeName","src":"1301:7:15","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":10439,"mutability":"mutable","name":"invertFeed","nameLocation":"1479:10:15","nodeType":"VariableDeclaration","scope":10461,"src":"1474:15:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":10438,"name":"bool","nodeType":"ElementaryTypeName","src":"1474:4:15","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":10442,"mutability":"mutable","name":"maxStaleness","nameLocation":"1609:12:15","nodeType":"VariableDeclaration","scope":10461,"src":"1602:19:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint32","typeString":"uint32"},"typeName":{"id":10441,"name":"uint32","nodeType":"ElementaryTypeName","src":"1602:6:15","typeDescriptions":{"typeIdentifier":"t_uint32","typeString":"uint32"}},"visibility":"internal"},{"constant":false,"id":10445,"mutability":"mutable","name":"minAnswer","nameLocation":"1765:9:15","nodeType":"VariableDeclaration","scope":10461,"src":"1757:17:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":10444,"name":"uint256","nodeType":"ElementaryTypeName","src":"1757:7:15","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":10448,"mutability":"mutable","name":"maxAnswer","nameLocation":"1918:9:15","nodeType":"VariableDeclaration","scope":10461,"src":"1910:17:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":10447,"name":"uint256","nodeType":"ElementaryTypeName","src":"1910:7:15","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":10451,"mutability":"mutable","name":"v3Pool","nameLocation":"2041:6:15","nodeType":"VariableDeclaration","scope":10461,"src":"2033:14:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":10450,"name":"address","nodeType":"ElementaryTypeName","src":"2033:7:15","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":10454,"mutability":"mutable","name":"invertV3","nameLocation":"2204:8:15","nodeType":"VariableDeclaration","scope":10461,"src":"2199:13:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":10453,"name":"bool","nodeType":"ElementaryTypeName","src":"2199:4:15","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":10457,"mutability":"mutable","name":"twapWindow","nameLocation":"2337:10:15","nodeType":"VariableDeclaration","scope":10461,"src":"2330:17:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint32","typeString":"uint32"},"typeName":{"id":10456,"name":"uint32","nodeType":"ElementaryTypeName","src":"2330:6:15","typeDescriptions":{"typeIdentifier":"t_uint32","typeString":"uint32"}},"visibility":"internal"},{"constant":false,"id":10460,"mutability":"mutable","name":"maxDeviationBps","nameLocation":"2491:15:15","nodeType":"VariableDeclaration","scope":10461,"src":"2484:22:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"},"typeName":{"id":10459,"name":"uint16","nodeType":"ElementaryTypeName","src":"2484:6:15","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"}},"visibility":"internal"}],"name":"PairConfig","nameLocation":"1178:10:15","nodeType":"StructDefinition","scope":10521,"src":"1171:1342:15","visibility":"public"},{"anonymous":false,"documentation":{"id":10462,"nodeType":"StructuredDocumentation","src":"2519:514:15","text":" @notice Emitted when a pool reference configuration is stored.\n @dev Emitted by `setPairConfig` after validation and storage, so indexers always see the stored values.\n @param poolId Uniswap V4 pool id derived from `key`.\n @param key Uniswap V4 pool key configured by the owner.\n @param config Oracle and deviation configuration stored for the pool.\n @param decimals0 Cached decimals for `key.currency0`.\n @param decimals1 Cached decimals for `key.currency1`."},"eventSelector":"68937cf29d67c2708cbe0c1e521c7b474f55187cbd273051bbc263f9f7f73e9e","id":10476,"name":"PairConfigSet","nameLocation":"3044:13:15","nodeType":"EventDefinition","parameters":{"id":10475,"nodeType":"ParameterList","parameters":[{"constant":false,"id":10464,"indexed":true,"mutability":"mutable","name":"poolId","nameLocation":"3074:6:15","nodeType":"VariableDeclaration","scope":10476,"src":"3058:22:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":10463,"name":"bytes32","nodeType":"ElementaryTypeName","src":"3058:7:15","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"visibility":"internal"},{"constant":false,"id":10467,"indexed":false,"mutability":"mutable","name":"key","nameLocation":"3090:3:15","nodeType":"VariableDeclaration","scope":10476,"src":"3082:11:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$12194_memory_ptr","typeString":"struct PoolKey"},"typeName":{"id":10466,"nodeType":"UserDefinedTypeName","pathNode":{"id":10465,"name":"PoolKey","nameLocations":["3082:7:15"],"nodeType":"IdentifierPath","referencedDeclaration":12194,"src":"3082:7:15"},"referencedDeclaration":12194,"src":"3082:7:15","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$12194_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"},{"constant":false,"id":10470,"indexed":false,"mutability":"mutable","name":"config","nameLocation":"3106:6:15","nodeType":"VariableDeclaration","scope":10476,"src":"3095:17:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_struct$_PairConfig_$10461_memory_ptr","typeString":"struct IPriceGuard.PairConfig"},"typeName":{"id":10469,"nodeType":"UserDefinedTypeName","pathNode":{"id":10468,"name":"PairConfig","nameLocations":["3095:10:15"],"nodeType":"IdentifierPath","referencedDeclaration":10461,"src":"3095:10:15"},"referencedDeclaration":10461,"src":"3095:10:15","typeDescriptions":{"typeIdentifier":"t_struct$_PairConfig_$10461_storage_ptr","typeString":"struct IPriceGuard.PairConfig"}},"visibility":"internal"},{"constant":false,"id":10472,"indexed":false,"mutability":"mutable","name":"decimals0","nameLocation":"3120:9:15","nodeType":"VariableDeclaration","scope":10476,"src":"3114:15:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":10471,"name":"uint8","nodeType":"ElementaryTypeName","src":"3114:5:15","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"visibility":"internal"},{"constant":false,"id":10474,"indexed":false,"mutability":"mutable","name":"decimals1","nameLocation":"3137:9:15","nodeType":"VariableDeclaration","scope":10476,"src":"3131:15:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":10473,"name":"uint8","nodeType":"ElementaryTypeName","src":"3131:5:15","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"visibility":"internal"}],"src":"3057:90:15"},"src":"3038:110:15"},{"documentation":{"id":10477,"nodeType":"StructuredDocumentation","src":"3154:525:15","text":" @notice Stores or replaces the oracle configuration for a Uniswap V4 pool.\n @dev Restricted to the owner, which is expected to be a timelock. Implementations must validate the\n      configuration, cache both currencies' decimals, and confirm that the converted reference price agrees\n      with the live pool price before storing, and must emit `PairConfigSet`.\n @param key Pool key identifying the V4 pool.\n @param config Oracle reference and deviation settings for the pool."},"functionSelector":"c2e85d2d","id":10486,"implemented":false,"kind":"function","modifiers":[],"name":"setPairConfig","nameLocation":"3693:13:15","nodeType":"FunctionDefinition","parameters":{"id":10484,"nodeType":"ParameterList","parameters":[{"constant":false,"id":10480,"mutability":"mutable","name":"key","nameLocation":"3724:3:15","nodeType":"VariableDeclaration","scope":10486,"src":"3707:20:15","stateVariable":false,"storageLocation":"calldata","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$12194_calldata_ptr","typeString":"struct PoolKey"},"typeName":{"id":10479,"nodeType":"UserDefinedTypeName","pathNode":{"id":10478,"name":"PoolKey","nameLocations":["3707:7:15"],"nodeType":"IdentifierPath","referencedDeclaration":12194,"src":"3707:7:15"},"referencedDeclaration":12194,"src":"3707:7:15","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$12194_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"},{"constant":false,"id":10483,"mutability":"mutable","name":"config","nameLocation":"3749:6:15","nodeType":"VariableDeclaration","scope":10486,"src":"3729:26:15","stateVariable":false,"storageLocation":"calldata","typeDescriptions":{"typeIdentifier":"t_struct$_PairConfig_$10461_calldata_ptr","typeString":"struct IPriceGuard.PairConfig"},"typeName":{"id":10482,"nodeType":"UserDefinedTypeName","pathNode":{"id":10481,"name":"PairConfig","nameLocations":["3729:10:15"],"nodeType":"IdentifierPath","referencedDeclaration":10461,"src":"3729:10:15"},"referencedDeclaration":10461,"src":"3729:10:15","typeDescriptions":{"typeIdentifier":"t_struct$_PairConfig_$10461_storage_ptr","typeString":"struct IPriceGuard.PairConfig"}},"visibility":"internal"}],"src":"3706:50:15"},"returnParameters":{"id":10485,"nodeType":"ParameterList","parameters":[],"src":"3765:0:15"},"scope":10521,"src":"3684:82:15","stateMutability":"nonpayable","virtual":false,"visibility":"external"},{"documentation":{"id":10487,"nodeType":"StructuredDocumentation","src":"3772:645:15","text":" @notice Checks whether the current V4 pool price is within the configured deviation from the reference price.\n @dev Must not mutate state. Stale, missing or invalid oracle data returns `(false, type(uint256).max)` rather\n      than reverting, so callers can raise one clear error; only a pool without a configuration reverts.\n @param key Pool key identifying the V4 pool to check.\n @return trusted True when the pool price is within the configured deviation and safety checks pass.\n @return devBps Observed deviation in basis points, or `type(uint256).max` when no trusted reference is available."},"functionSelector":"cf8b06c0","id":10497,"implemented":false,"kind":"function","modifiers":[],"name":"isPriceTrusted","nameLocation":"4431:14:15","nodeType":"FunctionDefinition","parameters":{"id":10491,"nodeType":"ParameterList","parameters":[{"constant":false,"id":10490,"mutability":"mutable","name":"key","nameLocation":"4463:3:15","nodeType":"VariableDeclaration","scope":10497,"src":"4446:20:15","stateVariable":false,"storageLocation":"calldata","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$12194_calldata_ptr","typeString":"struct PoolKey"},"typeName":{"id":10489,"nodeType":"UserDefinedTypeName","pathNode":{"id":10488,"name":"PoolKey","nameLocations":["4446:7:15"],"nodeType":"IdentifierPath","referencedDeclaration":12194,"src":"4446:7:15"},"referencedDeclaration":12194,"src":"4446:7:15","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$12194_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"}],"src":"4445:22:15"},"returnParameters":{"id":10496,"nodeType":"ParameterList","parameters":[{"constant":false,"id":10493,"mutability":"mutable","name":"trusted","nameLocation":"4496:7:15","nodeType":"VariableDeclaration","scope":10497,"src":"4491:12:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":10492,"name":"bool","nodeType":"ElementaryTypeName","src":"4491:4:15","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":10495,"mutability":"mutable","name":"devBps","nameLocation":"4513:6:15","nodeType":"VariableDeclaration","scope":10497,"src":"4505:14:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":10494,"name":"uint256","nodeType":"ElementaryTypeName","src":"4505:7:15","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"4490:30:15"},"scope":10521,"src":"4422:99:15","stateMutability":"view","virtual":false,"visibility":"external"},{"documentation":{"id":10498,"nodeType":"StructuredDocumentation","src":"4527:323:15","text":" @notice Returns the current trusted oracle reference price for a pool.\n @dev Reverts when the pair is not configured or its oracle/reference is not currently usable.\n @param key Pool key identifying the configured V4 pool.\n @return sqrtPriceX96 Trusted reference price in Q64.96 format."},"functionSelector":"4f2aa232","id":10506,"implemented":false,"kind":"function","modifiers":[],"name":"referenceSqrtPriceX96","nameLocation":"4864:21:15","nodeType":"FunctionDefinition","parameters":{"id":10502,"nodeType":"ParameterList","parameters":[{"constant":false,"id":10501,"mutability":"mutable","name":"key","nameLocation":"4903:3:15","nodeType":"VariableDeclaration","scope":10506,"src":"4886:20:15","stateVariable":false,"storageLocation":"calldata","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$12194_calldata_ptr","typeString":"struct PoolKey"},"typeName":{"id":10500,"nodeType":"UserDefinedTypeName","pathNode":{"id":10499,"name":"PoolKey","nameLocations":["4886:7:15"],"nodeType":"IdentifierPath","referencedDeclaration":12194,"src":"4886:7:15"},"referencedDeclaration":12194,"src":"4886:7:15","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$12194_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"}],"src":"4885:22:15"},"returnParameters":{"id":10505,"nodeType":"ParameterList","parameters":[{"constant":false,"id":10504,"mutability":"mutable","name":"sqrtPriceX96","nameLocation":"4939:12:15","nodeType":"VariableDeclaration","scope":10506,"src":"4931:20:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":10503,"name":"uint160","nodeType":"ElementaryTypeName","src":"4931:7:15","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"}],"src":"4930:22:15"},"scope":10521,"src":"4855:98:15","stateMutability":"view","virtual":false,"visibility":"external"},{"documentation":{"id":10507,"nodeType":"StructuredDocumentation","src":"4959:428:15","text":" @notice Returns the stored oracle configuration and cached currency decimals for a pool.\n @dev An unset pool returns a zeroed configuration; callers distinguish it by `maxDeviationBps == 0`.\n @param key Pool key identifying the V4 pool.\n @return config Stored pair configuration.\n @return decimals0 Cached decimals for currency0.\n @return decimals1 Cached decimals for currency1."},"functionSelector":"8bae2724","id":10520,"implemented":false,"kind":"function","modifiers":[],"name":"configOf","nameLocation":"5401:8:15","nodeType":"FunctionDefinition","parameters":{"id":10511,"nodeType":"ParameterList","parameters":[{"constant":false,"id":10510,"mutability":"mutable","name":"key","nameLocation":"5427:3:15","nodeType":"VariableDeclaration","scope":10520,"src":"5410:20:15","stateVariable":false,"storageLocation":"calldata","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$12194_calldata_ptr","typeString":"struct PoolKey"},"typeName":{"id":10509,"nodeType":"UserDefinedTypeName","pathNode":{"id":10508,"name":"PoolKey","nameLocations":["5410:7:15"],"nodeType":"IdentifierPath","referencedDeclaration":12194,"src":"5410:7:15"},"referencedDeclaration":12194,"src":"5410:7:15","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$12194_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"}],"src":"5409:22:15"},"returnParameters":{"id":10519,"nodeType":"ParameterList","parameters":[{"constant":false,"id":10514,"mutability":"mutable","name":"config","nameLocation":"5497:6:15","nodeType":"VariableDeclaration","scope":10520,"src":"5479:24:15","stateVariable":false,"storageLocation":"memory","typeDescriptions":{"typeIdentifier":"t_struct$_PairConfig_$10461_memory_ptr","typeString":"struct IPriceGuard.PairConfig"},"typeName":{"id":10513,"nodeType":"UserDefinedTypeName","pathNode":{"id":10512,"name":"PairConfig","nameLocations":["5479:10:15"],"nodeType":"IdentifierPath","referencedDeclaration":10461,"src":"5479:10:15"},"referencedDeclaration":10461,"src":"5479:10:15","typeDescriptions":{"typeIdentifier":"t_struct$_PairConfig_$10461_storage_ptr","typeString":"struct IPriceGuard.PairConfig"}},"visibility":"internal"},{"cons