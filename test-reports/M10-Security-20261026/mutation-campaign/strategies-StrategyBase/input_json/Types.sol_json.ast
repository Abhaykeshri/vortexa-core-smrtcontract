{"absolutePath":"src/libraries/Types.sol","exportedSymbols":{"Band":[952],"Currency":[909],"DepositMode":[938],"Plan":[1015],"PoolKey":[928],"RebalanceParams":[1023],"Strategy":[933],"VaultConfig":[992]},"id":1024,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":907,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:2"},{"canonicalName":"Currency","id":909,"name":"Currency","nameLocation":"962:8:2","nodeType":"UserDefinedValueTypeDefinition","src":"957:25:2","underlyingType":{"id":908,"name":"address","nodeType":"ElementaryTypeName","src":"974:7:2","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}}},{"canonicalName":"PoolKey","documentation":{"id":910,"nodeType":"StructuredDocumentation","src":"984:291:2","text":" @notice Minimal Uniswap V4 pool key used to derive pool ids and read pool state.\n @dev The field order must match Uniswap's `PoolKey` exactly, because the pool id is the keccak256 hash of the\n      ABI-encoded struct. Currencies are sorted by address, `currency0 < currency1`."},"id":928,"members":[{"constant":false,"id":914,"mutability":"mutable","name":"currency0","nameLocation":"1378:9:2","nodeType":"VariableDeclaration","scope":928,"src":"1369:18:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_userDefinedValueType$_Currency_$909","typeString":"Currency"},"typeName":{"id":913,"nodeType":"UserDefinedTypeName","pathNode":{"id":912,"name":"Currency","nameLocations":["1369:8:2"],"nodeType":"IdentifierPath","referencedDeclaration":909,"src":"1369:8:2"},"referencedDeclaration":909,"src":"1369:8:2","typeDescriptions":{"typeIdentifier":"t_userDefinedValueType$_Currency_$909","typeString":"Currency"}},"visibility":"internal"},{"constant":false,"id":918,"mutability":"mutable","name":"currency1","nameLocation":"1475:9:2","nodeType":"VariableDeclaration","scope":928,"src":"1466:18:2","stateVariable":false,"storageLocation":"default","