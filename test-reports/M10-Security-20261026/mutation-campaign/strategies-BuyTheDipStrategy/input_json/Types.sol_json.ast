t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":170,"mutability":"mutable","name":"baseIsCurrency0","nameLocation":"5505:15:2","nodeType":"VariableDeclaration","scope":171,"src":"5500:20:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":169,"name":"bool","nodeType":"ElementaryTypeName","src":"5500:4:2","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"}],"name":"VaultConfig","nameLocation":"4116:11:2","nodeType":"StructDefinition","scope":203,"src":"4109:1414:2","visibility":"public"},{"canonicalName":"Plan","documentation":{"id":172,"nodeType":"StructuredDocumentation","src":"5525:411:2","text":" @notice Output of planning logic describing bands and optional swap intent.\n @dev Produced by a strategy and never trusted by the vault: the vault re-checks band alignment, weights, the\n      single-sided rule and the swap size before any token moves. `swapAmountIn` must be zero for every strategy\n      other than Normal LP. When `lockIdle` is true, `bands` is empty and no swap is requested."},"id":194,"members":[{"constant":false,"id":177,"mutability":"mutable","name":"bands","nameLocation":"6018:5:2","nodeType":"VariableDeclaration","scope":194,"src":"6011:12:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_array$_t_struct$_Band_$131_storage_$dyn_storage_ptr","typeString":"struct Band[]"},"typeName":{"baseType":{"id":175,"nodeType":"UserDefinedTypeName","pathNode":{"id":174,"name":"Band","nameLocations":["6011:4:2"],"nodeType":"IdentifierPath","referencedDeclaration":131,"src":"6011:4:2"},"referencedDeclaration":131,"src":"6011:4:2","typeDescriptions":{"typeIdentifier":"t_struct$_Band_$131_storage_ptr","typeString":"struct Band"}},"id":176,"nodeType":"ArrayTypeName","src":"6011:6:2","typeDescriptions":{"typeIdentifier":"t_array$_t_struct$_Band_$131_storage_$dyn_storage_ptr","typeString":"struct Band[]"}},"visibility":"internal"},{"constant":false,"id":181,"mutability":"mutable","name":"weightsBps","nameLocation":"6099:10:2","nodeType":"VariableDeclaration","scope":194,"src":"6090:19:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_array$_t_uint16_$dyn_storage_ptr","typeString":"uint16[]"},"typeName":{"baseType":{"id":179,"name":"uint16","nodeType":"ElementaryTypeName","src":"6090:6:2","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"}},"id":180,"nodeType":"ArrayTypeName","src":"6090:8:2","typeDescriptions":{"typeIdentifier":"t_array$_t_uint16_$dyn_storage_ptr","typeString":"uint16[]"}},"visibility":"internal"},{"constant":false,"id":184,"mutability":"mutable","name":"needsSwap","nameLocation":"6195:9:2","nodeType":"VariableDeclaration","scope":194,"src":"6190:14:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":183,"name":"bool","nodeType":"ElementaryTypeName","src":"6190:4:2","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":187,"mutability":"mutable","name":"zeroForOne","nameLocation":"6287:10:2","nodeType":"VariableDeclaration","scope":194,"src":"6282:15:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":186,"name":"bool","nodeType":"ElementaryTypeName","src":"6282:4:2","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":190,"mutability":"mutable","name":"swapAmountIn","nameLocation":"6377:12:2","nodeType":"VariableDeclaration","scope":194,"src":"6369:20:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":189,"name":"uint256","nodeType":"ElementaryTypeName","src":"6369:7:2","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":193,"mutability":"mutable","name":"lockIdle","nameLocation":"6479:8:2","nodeType":"VariableDeclaration","scope":194,"src":"6474:13:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":192,"name":"bool","nodeType":"ElementaryTypeName","src":"6474:4:2","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"}],"name":"Plan","nameLocation":"5944:4:2","nodeType":"StructDefinition","scope":203,"src":"5937:553:2","visibility":"public"},{"canonicalName":"RebalanceParams","documentation":{"id":195,"nodeType":"StructuredDocumentation","src":"6492:272:2","text":" @notice Parameters supplied to a rebalance operation.\n @dev Supplied by a keeper, who is trusted for liveness only. Both values are treated as hostile: the vault\n      bounds the center against the real pool tick and the slippage against its own loss check."},"id":202,"members":[{"constant":false,"id":198,"mutability":"mutable","name":"newCenterTick","nameLocation":"6912:13:2","nodeType":"VariableDeclaration","scope":202,"src":"6906:19:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":197,"name":"int24","nodeType":"ElementaryTypeName","src":"6906:5:2","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":201,"mutability":"mutable","name":"maxSlippageBps","nameLocation":"7063:14:2","nodeType":"VariableDeclaration","scope":202,"src":"7056:21:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"},"typeName":{"id":200,"name":"uint16","nodeType":"ElementaryTypeName","src":"7056:6:2","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"}},"visibilit