mberName":"observe","nodeType":"MemberAccess","referencedDeclaration":5449,"src":"27098:41:8","typeDescriptions":{"typeIdentifier":"t_function_external_view$_t_array$_t_uint32_$dyn_memory_ptr_$returns$_t_array$_t_int56_$dyn_memory_ptr_$_t_array$_t_uint160_$dyn_memory_ptr_$","typeString":"function (uint32[] memory) view external returns (int56[] memory,uint160[] memory)"}},"id":1218,"isConstant":false,"isLValue":false,"isPure":false,"kind":"functionCall","lValueRequested":false,"nameLocations":[],"names":[],"nodeType":"FunctionCall","src":"27098:54:8","tryCall":true,"typeDescriptions":{"typeIdentifier":"t_tuple$_t_array$_t_int56_$dyn_memory_ptr_$_t_array$_t_uint160_$dyn_memory_ptr_$","typeString":"tuple(int56[] memory,uint160[] memory)"}},"id":1287,"nodeType":"TryStatement","src":"27094:607:8"}]},"documentation":{"id":1178,"nodeType":"StructuredDocumentation","src":"26147:708:8","text":" @notice Computes the Uniswap V3 time-weighted average price as a Q64.96 square-root price.\n @dev Observes `[twapWindow, 0]`, takes the mean tick as `(cum1 - cum0) / window` rounded toward negative\n      infinity, converts it with `SqrtPriceMath.getSqrtPriceAtTick` and inverts it when `invertV3` is set.\n      A pool with too little history makes `observe` revert, which is reported as `ok == false` and never\n      as a pass.\n @param config Pair configuration holding the V3 pool, window and orientation.\n @return ok True when the TWAP could be computed.\n @return sqrtPriceX96 TWAP square-root price as a Q64.96 value, or zero when `ok` is false."},"id":1289,"implemented":true,"kind":"function","modifiers":[],"name":"_v3Sqrt","nameLocation":"26869:7:8","nodeType":"FunctionDefinition","parameters":{"id":1182,"nodeType":"ParameterList","parameters":[{"constant":false,"id":1181,"mutability":"mutable","name":"config","nameLocation":"26895:6:8","nodeType":"VariableDeclaration","scope":1289,"src":"26877:24:8","stateVariable":false,"storageLocation":"memory","typeDescriptions":{"typeIdentif