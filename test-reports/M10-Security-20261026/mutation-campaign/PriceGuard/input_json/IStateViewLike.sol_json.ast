{"absolutePath":"src/interfaces/external/IStateViewLike.sol","exportedSymbols":{"IStateViewLike":[5421]},"id":5422,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":5371,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:11"},{"abstract":false,"baseContracts":[],"canonicalName":"IStateViewLike","contractDependencies":[],"contractKind":"interface","documentation":{"id":5372,"nodeType":"StructuredDocumentation","src":"57:519:11","text":" @title Uniswap V4 StateView Minimal Interface\n @notice Minimal interface for reading slot0 state from a Uniswap V4 pool.\n @dev PriceGuard uses `sqrtPriceX96` from `getSlot0` as the current pool price input.\n      This is a minimal, MIT-licensed interface declared by this project; it contains no Uniswap source. The\n      pool id passed in is the keccak256 hash of the ABI-encoded `PoolKey` (see `PoolIdLib.toId`). Later\n      milestones extend this interface with position and fee-growth reads."},"fullyImplemented":false,"id":5421,"linearizedBaseContracts":[5421],"name":"IStateViewLike","nameLocation":"587:14:11","nodeType":"ContractDefinition","nodes":[{"documentation":{"id":5373,"nodeType":"StructuredDocumentation","src":"608:661:11","text":" @notice Reads slot0 for a V4 pool.\n @dev An uninitialized pool returns a zero `sqrtPriceX96`, which callers must treat as \"pool does not exist\".\n      The returned price is the instantaneous spot price and can be manipulated within a single transaction,\n      so it must always be cross-checked against an external reference before being relied on.\n @param poolId Pool id derived from a Uniswap V4 `PoolKey`.\n @return sqrtPriceX96 Current square-root price as a Q64.96 value.\n @return tick Current pool tick.\n @return protocolFee Current protocol fee value.\n @return lpFee Current LP fee value."},"functionSelector":"c815641c","id":5386,"implemented":false,"kind":"function","modifiers":[],"name":"getSlot0","nameLocation":"1283:8:11","nodeType":"FunctionDefinition","parameters":{"id":5376,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5375,"mutability":"mutable","name":"poolId","nameLocation":"1300:6:11","nodeType":"VariableDeclaration","scope":5386,"src":"1292:14:11","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":5374,"name":"bytes32","nodeType":"ElementaryTypeName","src":"1292:7:11","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"visibility":"internal"}],"src":"1291:16:11"},"returnParameters":{"id":5385,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5378,"mutability":"mutable","name":"sqrtPriceX96","nameLocation":"1363:12:11","nodeType":"VariableDeclaration","scope":5386,"src":"1355:20:11","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":5377,"name":"uint160","nodeType":"ElementaryTypeName","src":"1355:7:11","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"},{"constant":false,"id":5380,"mutability":"mutable","name":"tick","nameLocation":"1383:4:11","nodeType":"VariableDeclaration","scope":5386,"src":"1377:10:11","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":5379,"name":"int24","nodeType":"ElementaryTypeName","src":"1377:5:11","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":5382,"mutability":"mutable","name":"protocolFee","nameLocation":"1396:11:11","nodeType":"VariableDeclaration","scope":5386,"src":"1389:18:11","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"},"typeName":{"id":5381,"name":"uint24","nodeType":"ElementaryTypeName","src":"1389:6:11","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"}},"visibility":"internal"},{"constant":false,"id":5384,"mutability":"mutable","name":"lpFee","nameLocation":"1416:5:11","nodeType":"VariableDeclaration","scope":5386,"src":"1409:12:11","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"},"typeName":{"id":5383,"name":"uint24","nodeType":"ElementaryTypeName","src":"1409:6:11","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"}},"visibility":"internal"}],"src":"1354:68:11"},"scope":5421,"src":"1274:149:11","stateMutability":"view","virtual":false,"visibility":"external"},{"documentation":{"id":5387,"nodeType":"StructuredDocumentation","src":"1429:770:11","text":" @notice Reads a V4 position's liquidity and last fee-growth checkpoints.\n @dev The salt is the PositionManager NFT id encoded as bytes32 for positions minted by this vault.\n @param poolId Pool id derived from a Uniswap V4 `PoolKey`.\n @param owner Position owner recorded in the PoolManager, normally the PositionManager contract.\n @param tickLower Lower tick of the position.\n @param tickUpper Upper tick of the position.\n @param salt Position salt, equal to `bytes32(tokenId)` for PositionManager NFTs.\n @return liquidity Active position liquidity.\n @return feeGrowthInside0LastX128 Last recorded fee growth for currency0.\n @return feeGrowthInside1LastX128 Last recorded fee growth for currency1."},"functionSelector":"dacf1d2f","id":5406,"implemented":false,"kind":"function","modifiers":[],"name":"getPositionInfo","nameLocation":"2213:15:11","nodeType":"FunctionDefinition","parameters":{"id":5398,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5389,"mutability":"mutable","name":"poolId","nameLocation":"2237:6:11","nodeType":"VariableDeclaration","scope":5406,"src":"2229:14:11","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":5388,"name":"bytes32","nodeType":"ElementaryTypeName","src":"2229:7:11","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"visibility":"internal"},{"constant":false,"id":5391,"mutability":"mutable","name":"owner","nameLocation":"2253:5:11","nodeType":"VariableDeclaration","scope":5406,"src":"2245:13:11","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":5390,"name":"address","nodeType":"ElementaryTypeName","src":"2245:7:11","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":5393,"mutability":"mutable","name":"tickLower","nameLocation":"2266:9:11","nodeType":"VariableDeclaration","scope":5406,"src":"2260:15:11","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":5392,"name":"int24","nodeType":"ElementaryTypeName","src":"2260:5:11","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":5395,"mutability":"mutable","name":"tickUpper","nameLocation":"2283:9:11","nodeType":"VariableDeclaration","scope":5406,"src":"2277:15:11","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":5394,"name":"int24","nodeType":"ElementaryTypeName","src":"2277:5:11","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":5397,"mutability":"mutable","name":"salt","nameLocation":"2302:4:11","nodeType":"VariableDeclaration","scope":5406,"src":"2294:12:11","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":5396,"name":"bytes32","nodeType":"ElementaryTypeName","src":"2294:7:11","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"byte