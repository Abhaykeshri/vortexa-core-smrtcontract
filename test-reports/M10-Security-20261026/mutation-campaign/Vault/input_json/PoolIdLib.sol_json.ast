{"absolutePath":"src/libraries/PoolIdLib.sol","exportedSymbols":{"PoolIdLib":[11743],"PoolKey":[12194]},"id":11744,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":11722,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:26"},{"absolutePath":"src/libraries/Types.sol","file":"./Types.sol","id":11724,"nameLocation":"-1:-1:-1","nodeType":"ImportDirective","scope":11744,"sourceUnit":12290,"src":"57:36:26","symbolAliases":[{"foreign":{"id":11723,"name":"PoolKey","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":12194,"src":"65:7:26","typeDescriptions":{}},"nameLocation":"-1:-1:-1"}],"unitAlias":""},{"abstract":false,"baseContracts":[],"canonicalName":"PoolIdLib","contractDependencies":[],"contractKind":"library","documentation":{"id":11725,"nodeType":"StructuredDocumentation","src":"95:405:26","text":" @title Pool Id Library\n @notice Computes deterministic pool identifiers from Vortexa/Uniswap V4 pool keys.\n @dev The encoding is intentionally ABI encoding of the complete `PoolKey`.\n      The identifier is the same value Uniswap v4 uses as `PoolId`, so it can be passed directly to `StateView`\n      reads. Equality with Uniswap's `PoolIdLibrary` is asserted by a differential test."},"fullyImplemented":true,"id":11743,"linearizedBaseContracts":[11743],"name":"PoolIdLib","nameLocation":"509:9:26","nodeType":"ContractDefinition","nodes":[{"body":{"id":11741,"nodeType":"Block","src":"1072:50:26","statements":[{"expression":{"arguments":[{"arguments":[{"id":11737,"name":"key","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":11729,"src":"1110:3:26","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$12194_memory_ptr","typeString":"struct PoolKey memory"}}],"expression":{"argumentTypes":[{"typeIdentifier":"t_struct$_PoolKey_$12194_memory_ptr","typeString":"struct PoolKey memory"}],"expression":{"id":11735,"name":"abi","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":-1,"src":"1099:3:26","typeDescriptions":{"typeIdentifier":"t_magic_abi","typeString":"abi"}},"id":11736,"isConstant":false,"isLValue":false,"isPure":true,"lValueRequested":false,"memberLocation":"1103:6:26","memberName":"encode","nodeType":"MemberAccess","src":"1099:10:26","typeDescriptions":{"typeIdentifier":"t_function_abiencode_pure$__$returns$_t_bytes_memory_ptr_$","typeString":"function () pure returns (bytes memory)"}},"id":11738,"isConstant":false,"isLValue":false,"isPure":false,"kind":"functionCall","lValueRequested":false,"nameLocations":[],"names":[],"nodeType":"FunctionCall","src":"1099:15:26","tryCall":false,"typeDescriptions":{"typeIdentifier":"t_bytes_memory_ptr","typeString":"bytes memory"}}],"expression":{"argumentTypes":[{"typeIdentifier":"t_bytes_memory_ptr","typeString":"bytes memory"}],"id":11734,"name":"keccak256","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":-8,"src":"1089:9:26","typeDescriptions":{"typeIdentifier":"t_function_keccak256_pure$_t_bytes_memory_ptr_$returns$_t_bytes32_$","typeString":"function (bytes memory) pure returns (bytes32)"}},"id":11739,"isConstant":false,"isLValue":false,"isPure":false,"kind":"functionCall","lValueRequested":false,"nameLocations":[],"names":[],"nodeType":"FunctionCall","src":"1089:26:26","tryCall":false,"typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"functionReturnParameters":11733,"id":11740,"nodeType":"Return","src":"1082:33:26"}]},"documentation":{"id":11726,"nodeType":"StructuredDocumentation","src":"525:473:26","text":" @notice Computes the canonical identifier for a pool key.\n @dev The field order and ABI encoding match Uniswap v4 PoolKey: `currency0`, `currency1`, `fee`,\n      `tickSpacing`, `hooks`, each occupying one 32-byte word. Changing the order or the field types would\n      silently produce ids for non-existent pools.\n @param key The five-word, statically encoded pool key.\n @return id The keccak256 hash of the ABI-encoded key."},"id":11742,"implemented":true,"kind":"function","modifiers":[],"name":"toId","nameLocation":"1012:4:26","nodeType":"FunctionDefinition","parameters":{"id":11730,"nodeType":"ParameterList","parameters":[{"constant":false,"id":11729,"mutability":"mutable","name":"key","nameLocation":"1032:3:26","nodeType":"VariableDeclaration","scope":11742,"src":"1017:18:26","stateVariable":false,"storageLocation":"memory","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$12194_memory_ptr","typeString":"struct PoolKey"},"typeName":{"id":11728,"nodeType":"UserDefinedTypeName","pathNode":{"id":11727,"name":"PoolKey","nameLocations":["1017:7:26"],"nodeType":"IdentifierPath","referencedDeclaration":12194,"src":"1017:7:26"},"referencedDeclaration":12194,"src":"1017:7:26","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$12194_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"}],"src":"1016:20:26"},"returnParameters":{"id":11733,"nodeType":"ParameterList","parameters":[{"constant":false,"id":11732,"mutability":"mutable","name":"id","nameLocation":"1068:2:26","nodeType":"VariableDeclaration","scope":11742,"src":"1060:10:26","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":11731,"name":"bytes32","nodeType":"ElementaryTypeName","src":"1060:7:26","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"visibility":"internal"}],"src":"1059:12:26"},"scope":11743,"src":"1003:119:26","stateMutability":"pure","virtual":false,"visibility":"internal"}],"scope":11744,"src":"501:623:26","usedErrors":[],"usedEvents":[]}],"src":"32:1093:26"}