or handling native ETH and ERC-20 currencies through the shared `Currency` type.\n @dev The zero address is treated as native ETH. Non-zero currency values are treated as ERC-20 token addresses.\n      ERC-20 transfers go through OpenZeppelin `SafeERC20`, so tokens that return `false` or nothing are handled\n      and failures revert. Native sends forward all remaining gas to the recipient, so every call site that\n      sends native currency must provide its own reentrancy protection (checks-effects-interactions plus a\n      `nonReentrant` guard)."},"fullyImplemented":true,"id":11419,"linearizedBaseContracts":[11419],"name":"CurrencyLib","nameLocation":"879:11:24","nodeType":"ContractDefinition","nodes":[{"global":false,"id":11314,"libraryName":{"id":11311,"name":"SafeERC20","nameLocations":["903:9:24"],"nodeType":"IdentifierPath","referencedDeclaration":4806,"src":"903:9:24"},"nodeType":"UsingForDirective","src":"897:27:24","typeName":{"id":11313,"nodeType":"UserDefinedTypeName","pathNode":{"id":11312,"name":"IERC20","nameLocations":["917:6:24"],"nodeType":"IdentifierPath","referencedDeclaration":4330,"src":"917:6:24"},"referencedDeclaration":4330,"src":"917:6:24","typeDescriptions":{"typeIdentifier":"t_contract$_IERC20_$4330","typeString":"contract IERC20"}}},{"documentation":{"id":11315,"nodeType":"StructuredDocumentation","src":"930:226:24","text":" @notice Native ETH transfer failed.\n @dev Thrown by `transfer` when the low-level call to the recipient returns false, for example because the\n      recipient reverts or has no payable `receive`."},"errorSelector":"f4b3b1bc","id":11317,"name":"NativeTransferFailed","nameLocation":"1167:20:24","nodeType":"ErrorDefinition","parameters":{"id":11316,"nodeType":"ParameterList","parameters":[],"src":"1187:2:24"},"src":"1161:29:24"},{"body":{"id":11336,"nodeType":"Block","src":"1575:63:24","statements":[{"expression":{"commonType":{"typeIdentifier":"t_address","typeString":"address"},"id":11334,"isConstant":false,"isLVa