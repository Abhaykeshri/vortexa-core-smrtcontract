{"absolutePath":"src/libraries/LiquidityMath.sol","exportedSymbols":{"LiquidityMath":[9397],"Math":[3160],"SafeCast":[4925]},"id":9398,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":9098,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:26"},{"absolutePath":"//?/C:/Users/Abhay/Desktop/vortexa-core/lib/openzeppelin-contracts/contracts/utils/math/Math.sol","file":"@openzeppelin/contracts/utils/math/Math.sol","id":9100,"nameLocation":"-1:-1:-1","nodeType":"ImportDirective","scope":9398,"sourceUnit":3161,"src":"57:65:26","symbolAliases":[{"foreign":{"id":9099,"name":"Math","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":3160,"src":"65:4:26","typeDescriptions":{}},"nameLocation":"-1:-1:-1"}],"unitAlias":""},{"absolutePath":"//?/C:/Users/Abhay/Desktop/vortexa-core/lib/openzeppelin-contracts/contracts/utils/math/SafeCast.sol","file":"@openzeppelin/contracts/utils/math/SafeCast.sol","id":9102,"nameLocation":"-1:-1:-1","nodeType":"ImportDirective","scope":9398,"sourceUnit":4926,"src":"123:73:26","symbolAliases":[{"foreign":{"id":9101,"name":"SafeCast","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":4925,"src":"131:8:26","typeDescriptions":{}},"nameLocation":"-1:-1:-1"}],"unitAlias":""},{"abstract":false,"baseContracts":[],"canonicalName":"LiquidityMath","contractDependencies":[],"contractKind":"library","documentation":{"id":9103,"nodeType":"StructuredDocumentation","src":"198:739:26","text":" @title Liquidity Math\n @notice Computes Uniswap-style liquidity and token amounts for Q64.96 price ranges.\n @dev Functions match the pinned Uniswap V4 math behavior used by M1 differential tests.\n      Rounding policy: liquidity and token amounts are always rounded down, so the amounts Uniswap pulls for the\n      computed liquidity never exceed the amounts supplied as inputs. Dust stays with the caller.\n      Safety: all products use OpenZeppelin full-precision `Math.mulDiv`, which guards the 512-bit\n      intermediate, and all `uint128` narrowing is checked and reverts instead of truncating. Production code\n      imports no Uniswap source; Uniswap's `LiquidityAmounts` is used only as a test oracle."},"fullyImplemented":true,"id":9397,"linearizedBaseContracts":[9397],"name":"LiquidityMath","nameLocation":"946:13:26","nodeType":"ContractDefinition","nodes":[{"documentation":{"id":9104,"nodeType":"StructuredDocumentation","src":"966:199:26","text":" @notice Price range endpoints are zero or equal after sorting.\n @dev Thrown when the lower endpoint is zero (division by zero risk) or both endpoints are equal (empty range)."},"errorSelector":"47ebe172","id":9106,"name":"InvalidPriceRange","nameLocation":"1176:17:26","nodeType":"ErrorDefinition","parameters":{"id":9105,"nodeType":"ParameterList","parameters":[],"src":"1193:2:26"},"src":"1170:26:26"},{"constant":true,"documentation":{"id":9107,"nodeType":"StructuredDocumentation","src":"1202:102:26","text":" @notice Fixed-point scaling factor for Q64.96 values.\n @dev Equal to `2**96`."},"id":9112,"mutability":"constant","name":"Q96","nameLocation":"1335:3:26","nodeType":"VariableDeclaration","scope":9397,"src":"1309:39:26","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":9108,"name":"uint256","nodeType":"ElementaryTypeName","src":"1309:7:26","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"value":{"commonType":{"typeIdentifier":"t_rational_79228162514264337593543950336_by_1","typeString":"int_const 79228162514264337593543950336"},"id":9111,"isConstant":false,"isLValue":false,"isPure":true,"lValueRequested":false,"leftExpression":{"hexValue":"31","id":9109,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"1341:1:26","typeDescriptions":{"typeIdentifier":"t_rational_1_by_1","typeString":"int_const 1"},"value":"1"},"nodeType":"