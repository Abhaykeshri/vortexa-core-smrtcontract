{"absolutePath":"src/libraries/SqrtPriceMath.sol","exportedSymbols":{"SafeCast":[5904],"SqrtPriceMath":[3195]},"id":3196,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":2805,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:7"},{"absolutePath":"//?/C:/Users/Abhay/Desktop/vortexa-core/lib/openzeppelin-contracts/contracts/utils/math/SafeCast.sol","file":"@openzeppelin/contracts/utils/math/SafeCast.sol","id":2807,"nameLocation":"-1:-1:-1","nodeType":"ImportDirective","scope":3196,"sourceUnit":5905,"src":"57:73:7","symbolAliases":[{"foreign":{"id":2806,"name":"SafeCast","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":5904,"src":"65:8:7","typeDescriptions":{}},"nameLocation":"-1:-1:-1"}],"unitAlias":""},{"abstract":false,"baseContracts":[],"canonicalName":"SqrtPriceMath","contractDependencies":[],"contractKind":"library","documentation":{"id":2808,"nodeType":"StructuredDocumentation","src":"132:707:7","text":" @title Square-Root Price Math\n @notice Converts Uniswap ticks into Q64.96 square-root prices.\n @dev The implementation is independently tested against pinned Uniswap V4 TickMath outputs.\n      This is an independent implementation, not a copy of Uniswap source, so production code carries no\n      BUSL-licensed material. Uniswap's `TickMath` is used only as a differential test oracle: results must\n      match exactly for every tested tick, including both boundaries.\n      Only the forward direction (tick to price) is provided. The inverse is never needed on-chain because the\n      current tick comes from `StateView.getSlot0` and prices are converted to ticks off-chain."},"fullyImplemented":true,"id":3195,"linearizedBaseContracts":[3195],"name":"SqrtPriceMath","nameLocation":"848:13:7","nodeType":"ContractDefinition","nodes":[{"documentation":{"id":2809,"nodeType":"StructuredDocumentation","src":"868:167:7","text":" @notice Tick is outside the supported Uniswap range.\n @dev Thrown by `getSqrtPrice