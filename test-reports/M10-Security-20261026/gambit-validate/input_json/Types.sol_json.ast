:"7056:21:30","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"},"typeName":{"id":8152,"name":"uint16","nodeType":"ElementaryTypeName","src":"7056:6:30","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"}},"visibility":"internal"}],"name":"RebalanceParams","nameLocation":"6772:15:30","nodeType":"StructDefinition","scope":8155,"src":"6765:315:30","visibility":"public"}],"src":"32:7049:30"}