{"absolutePath":"src/libraries/Types.sol","exportedSymbols":{"Band":[5912],"Currency":[5869],"DepositMode":[5898],"Plan":[5975],"PoolKey":[5888],"RebalanceParams":[5983],"Strategy":[5893],"VaultConfig":[5952]},"id":5984,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":5867,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:15"},{"canonicalName":"Currency","id":5869,"name":"Currency","nameLocation":"962:8:15","nodeType":"UserDefinedValueTypeDefinition","src":"957:25:15","underlyingType":{"id":5868,"name":"address","nodeType":"ElementaryTypeName","src":"974:7:15","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}}},{"canonicalName":"PoolKey","documentation":{"id":5870,"nodeType":"StructuredDocumentation","src":"984:291:15","text":" @notice Minimal Uniswap V4 pool key used to derive pool ids and read pool state.\n @dev The field order must match Uniswap's `PoolKey` exactly, because the pool id is the keccak256 hash of the\n      ABI-encoded struct. Currencies are sorted by address, `currency0 < currency1`."},"id":5888,"members":[{"constant":false,"id":5874,"mutability":"mutable","name":"currency0","nameLocation":"1378:9:15","nodeType":"VariableDeclaration","scope":5888,"src":"1369:18:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_userDefinedValueType$_Currency_$5869","typeString":"Currency"},"typeName":{"id":5873,"nodeType":"UserDefinedTypeName","pathNode":{"id":5872,"name":"Currency","nameLocations":["1369:8:15"],"nodeType":"IdentifierPath","referencedDeclaration":5869,"src":"1369:8:15"},"referencedDeclaration":5869,"src":"1369:8:15","typeDescriptions":{"typeIdentifier":"t_userDefinedValueType$_Currency_$5869","typeString":"Currency"}},"visibility":"internal"},{"constant":false,"id":5878,"mutability":"mutable","name":"currency1","nameLocation":"1475:9:15","nodeType":"VariableDeclaration","scope":5888,"src":"1466:18:15","stateVariable":fa