@notice Starts the two-step ownership transfer to `newOwner`.\n @dev Overrides OpenZeppelin to preserve an explicit zero-address rejection. The transfer only completes\n      once `newOwner` calls `acceptOwnership`, so a mistyped address cannot take over the contract.\n      Reverts with `OwnableInvalidOwner` when `newOwner` is the zero address and with\n      `OwnableUnauthorizedAccount` when the caller is not the current owner.\n @param newOwner Address that must later call `acceptOwnership`."},"functionSelector":"f2fde38b","id":207,"implemented":true,"kind":"function","modifiers":[{"id":182,"kind":"modifierInvocation","modifierName":{"id":181,"name":"onlyOwner","nameLocations":["9523:9:8"],"nodeType":"IdentifierPath","referencedDeclaration":1628,"src":"9523:9:8"},"nodeType":"ModifierInvocation","src":"9523:9:8"}],"name":"transferOwnership","nameLocation":"9471:17:8","nodeType":"FunctionDefinition","overrides":{"id":180,"nodeType":"OverrideSpecifier","overrides":[],"src":"9514:8:8"},"parameters":{"id":179,"nodeType":"ParameterList","parameters":[{"constant":false,"id":178,"mutability":"mutable","name":"newOwner","nameLocation":"9497:8:8","nodeType":"VariableDeclaration","scope":207,"src":"9489:16:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":177,"name":"address","nodeType":"ElementaryTypeName","src":"9489:7:8","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"}],"src":"9488:18:8"},"returnParameters":{"id":183,"nodeType":"ParameterList","parameters":[],"src":"9533:0:8"},"scope":1569,"src":"9462:205:8","stateMutability":"nonpayable","virtual":false,"visibility":"public"},{"baseFunctions":[5310],"body":{"id":277,"nodeType":"Block","src":"10752:448:8","statements":[{"expression":{"arguments":[{"id":220,"name":"key","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":211,"s