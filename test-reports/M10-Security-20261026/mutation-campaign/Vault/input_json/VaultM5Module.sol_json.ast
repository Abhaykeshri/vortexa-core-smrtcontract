},"documentation":{"id":7050,"nodeType":"StructuredDocumentation","src":"10042:874:14","text":" @notice Builds, validates, and executes the strategy plan used by a vault's first pair deposit.\n @dev A Normal LP swap is executed atomically through the immutable M6 executor. The swap is independently\n      bounded to 60% of supplied oracle value, uses a one-percent oracle-derived minimum output, and leaves no\n      ERC-20 allowance behind. One-sided strategies may never request a swap.\n @param sqrtPrice Current pool square-root price.\n @param tick Current pool tick.\n @param amount0 Supplied currency0 budget.\n @param amount1 Supplied currency1 budget.\n @return bands Validated target bands.\n @return weights Validated relative weights.\n @return postAmount0 Currency0 budget remaining after the optional swap.\n @return postAmount1 Currency1 budget remaining after the optional swap."},"functionSelector":"e2cdc265","id":7207,"implemented":true,"kind":"function","modifiers":[{"id":7061,"kind":"modifierInvocation","modifierName":{"id":7060,"name":"onlyDelegated","nameLocations":["11048:13:14"],"nodeType":"IdentifierPath","referencedDeclaration":7009,"src":"11048:13:14"},"nodeType":"ModifierInvocation","src":"11048:13:14"}],"name":"depositPlan","nameLocation":"10930:11:14","nodeType":"FunctionDefinition","parameters":{"id":7059,"nodeType":"ParameterList","parameters":[{"constant":false,"id":7052,"mutability":"mutable","name":"sqrtPrice","nameLocation":"10950:9:14","nodeType":"VariableDeclaration","scope":7207,"src":"10942:17:14","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":7051,"name":"uint160","nodeType":"ElementaryTypeName","src":"10942:7:14","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"},{"constant":false,"id":7054,"mutability":"mutable","name":"tick","nameLocation":"10967:4:14","nodeType":"VariableDeclaration","scope":72