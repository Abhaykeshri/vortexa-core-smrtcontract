{"absolutePath":"src/libraries/Types.sol","exportedSymbols":{"Band":[12218],"Currency":[12175],"DepositMode":[12204],"Plan":[12281],"PoolKey":[12194],"RebalanceParams":[12289],"Strategy":[12199],"VaultConfig":[12258]},"id":12290,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":12173,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:29"},{"canonicalName":"Currency","id":12175,"name":"Currency","nameLocation":"962:8:29","nodeType":"UserDefinedValueTypeDefinition","src":"957:25:29","underlyingType":{"id":12174,"name":"address","nodeType":"ElementaryTypeName","src":"974:7:29","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}}},{"canonicalName":"PoolKey","documentation":{"id":12176,"nodeType":"StructuredDocumentation","src":"984:291:29","text":" @notice Minimal Uniswap V4 pool key used to derive pool ids and read pool state.\n @dev The field order must match Uniswap's `PoolKey` exactly, because the pool id is the keccak256 hash of the\n      ABI-encoded struct. Currencies are sorted by address, `currency0 < currency1`."},"id":12194,"members":[{"constant":false,"id":12180,"mutability":"mutable","name":"currency0","nameLocation":"1378:9:29","nodeType":"VariableDeclaration","scope":12194,"src":"1369:18:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_userDefinedValueType$_Currency_$12175","typeString":"Currency"},"typeName":{"id":12179,"nodeType":"UserDefinedTypeName","pathNode":{"id":12178,"name":"Currency","nameLocations":["1369:8:29"],"nodeType":"IdentifierPath","referencedDeclaration":12175,"src":"1369:8:29"},"referencedDeclaration":12175,"src":"1369:8:29","typeDescriptions":{"typeIdentifier":"t_userDefinedValueType$_Currency_$12175","typeString":"Currency"}},"visibility":"internal"},{"constant":false,"id":12184,"mutability":"mutable","name":"currency1","nameLocation":"1475:9:29","nodeType":"VariableDeclaration","scope":12194,"src":"1466:18:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_userDefinedValueType$_Currency_$12175","typeString":"Currency"},"typeName":{"id":12183,"nodeType":"UserDefinedTypeName","pathNode":{"id":12182,"name":"Currency","nameLocations":["1466:8:29"],"nodeType":"IdentifierPath","referencedDeclaration":12175,"src":"1466:8:29"},"referencedDeclaration":12175,"src":"1466:8:29","typeDescriptions":{"typeIdentifier":"t_userDefinedValueType$_Currency_$12175","typeString":"Currency"}},"visibility":"internal"},{"constant":false,"id":12187,"mutability":"mutable","name":"fee","nameLocation":"1598:3:29","nodeType":"VariableDeclaration","scope":12194,"src":"1591:10:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"},"typeName":{"id":12186,"name":"uint24","nodeType":"ElementaryTypeName","src":"1591:6:29","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"}},"visibility":"internal"},{"constant":false,"id":12190,"mutability":"mutable","name":"tickSpacing","nameLocation":"1663:11:29","nodeType":"VariableDeclaration","scope":12194,"src":"1657:17:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":12189,"name":"int24","nodeType":"ElementaryTypeName","src":"1657:5:29","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":12193,"mutability":"mutable","name":"hooks","nameLocation":"1778:5:29","nodeType":"VariableDeclaration","scope":12194,"src":"1770:13:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":12192,"name":"address","nodeType":"ElementaryTypeName","src":"1770:7:29","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"}],"name":"PoolKey","nameLocation":"1283:7:29","nodeType":"StructDefinition","scope":12290,"src":"1276:510:29","visibility":"public"},{"canonicalName":"Strategy","documentation":{"id":12195,"nodeType":"StructuredDocumentation","src":"1788:262:29","text":" @notice High-level strategy selector for later vault planning milestones.\n @dev The numeric values are stored in vault configuration and emitted in events, so new strategies must only be\n      appended and existing members must never be reordered."},"id":12199,"members":[{"id":12196,"name":"NormalLP","nameLocation":"2169:8:29","nodeType":"EnumValue","src":"2169:8:29"},{"id":12197,"name":"BuyTheDip","nameLocation":"2280:9:29","nodeType":"EnumValue","src":"2280:9:29"},{"id":12198,"name":"SellThePump","nameLocation":"2392:11:29","nodeType":"EnumValue","src":"2392:11:29"}],"name":"Strategy","nameLocation":"2056:8:29","nodeType":"EnumDefinition","src":"2051:354:29"},{"canonicalName":"DepositMode","documentation":{"id":12200,"nodeType":"StructuredDocumentation","src":"2407:267:29","text":" @notice Deposit token selection mode for later vault deposit flows.\n @dev Reported by a strategy to tell the vault which tokens it accepts. One-sided strategies accept a single\n      token because their bands sit entirely on one side of the pool price."},"id":12204,"members":[{"id":12201,"name":"BothTokens","nameLocation":"2759:10:29","nodeType":"EnumValue","src":"2759:10:29"},{"id":12202,"name":"Token0Only","nameLocation":"2830:10:29","nodeType":"EnumValue","src":"2830:10:29"},{"id":12203,"name":"Token1Only","nameLocation":"2901:10:29","nodeType":"EnumValue","src":"2901:10:29"}],"name":"DepositMode","nameLocation":"2680:11:29","nodeType":"EnumDefinition","src":"2675:238:29"},{"canonicalName":"Band","documentation":{"id":12205,"nodeType":"StructuredDocumentation","src":"2915:403:29","text":" @notice One liquidity band in a planned or active position set.\n @dev Planned bands (returned by the shape library) carry zero `tokenId` and `liquidity`. Active bands record the\n      PositionManager NFT the vault owns for the band. Ticks must be multiples of the pool's tick spacing and lie\n      within the usable tick range; bands of one vault must be contiguous and non-overlapping."},"id":12218,"members":[{"constant":false,"id":12208,"mutability":"mutable","name":"tickLower","nameLocation":"3408:9:29","nodeType":"VariableDeclaration","scope":12218,"src":"3402:15:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":12207,"name":"int24","nodeType":"ElementaryTypeName","src":"3402:5:29","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":12211,"mutability":"mutable","name":"tickUpper","nameLocation":"3494:9:29","nodeType":"VariableDeclaration","scope":12218,"src":"3488:15:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":12210,"name":"int24","nodeType":"ElementaryTypeName","src":"3488:5:29","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":12214,"mutability":"mutable","name":"tokenId","nameLocation":"3600:7:29","nodeType":"VariableDeclaration","scope":12218,"src":"3592:15:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":12213,"name":"uint256","nodeType":"ElementaryTypeName","src":"3592:7:29","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":12217,"mutability":"mutable","name":"liquidity","nameLocation":"3691:9:29","nodeType":"VariableDeclaration","scope":12218,"src":"3683:17:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"},"typeName":{"id":12216,"name":"uint128","nodeType":"ElementaryTypeName","src":"3683:7:29","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"visibility":"internal"}],"name":"Band","nameLocation":"3326:4:29","nodeType":"StructDefinition","scope":12290,"src":"3319:384:29","visibility":"public"},{"canonicalName":"VaultConfig","documentation":{"id":12219,"nodeType":"StructuredDocumentation","src":"3705:403:29","text":" @notice User-facing vault strategy configuration used by later milestones.\n @dev Written once when a vault is initialized and immutable afterwards: no privileged function may change it.\n      The factory overwrites `baseIsCurrency0` with the value from the pool rule so a creator cannot flip it.\n      One-sided strategies use `trailTicks` and `lockOnFill`; Normal LP uses `driftTicks`."},"id":12258,"members":[{"constant":false,"id":12223,"mutability":"mutable","name":"poolKey","nameLocation":"4205:7:29","nodeType":"VariableDeclaration","scope":12258,"src":"4197:15:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$12194_storage_ptr","typeString":"struct PoolKey"},"typeName":{"id":12222,"nodeType":"UserDefinedTypeName","pathNode":{"id":12221,"name":"PoolKey","nameLocations":["4197:7:29"],"nodeType":"IdentifierPath","referencedDeclaration":12194,"src":"4197:7:29"},"referencedDeclaration":12194,"src":"4197:7:29","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$12194_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"},{"constant":false,"id":12227,"mutability":"mutable","name":"strategy","nameLocation":"4291:8:29","nodeType":"VariableDeclaration","scope":12258,"src":"4282:17:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_enum$_Strategy_$12199","typeString":"enum Strategy"},"typeName":{"id":12226,"nodeType":"UserDefinedTypeName","pathNode":{"id":12225,"name":"Strategy","nameLocations":["4282:8:29"],"nodeType":"IdentifierPath","referencedDeclaration":12199,"src":"4282:8:29"},"referencedDeclaration":12199,"src":"4282:8:29","typeDescriptions":{"typeIdentifier":"t_enum$_Strategy_$12199","typeString":"enum Strategy"}},"visibility":"internal"},{"constant":false,"id":12230,"mutability":"mutable","name":"shapeId","nameLocation":"4387:7:29","nodeType":"VariableDeclaration","scope":12258,"src":"4381:13:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":12229,"name":"uint8","nodeType":"ElementaryTypeName","src":"4381:5:29","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"visibility":"internal"},{"constant":false,"id":12233,"mutability":"mutable","name":"centerTick","nameLocation":"4481:10:29","nodeType":"VariableDeclaration","scope":12258,"src":"4475:16:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":12232,"name":"int24","nodeType":"ElementaryTypeName","src":"4475:5:29","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":12236,"mutability":"mutable","name":"ticksLeft","nameLocation":"4600:9:29","nodeType":"VariableDeclaration","scope":12258,"src":"4594:15:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":12235,"name":"int24","nodeType":"ElementaryTypeName","src":"4594:5:29","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":12239,"mutability":"mutable","name":"ticksRight","nameLocation":"4718:10:29","nodeType":"VariableDeclaration","scope":12258,"src":"4712:16:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":12238,"name":"int24","nodeType":"ElementaryTypeName","src":"4712:5:29","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":12242,"mutability":"mutable","name":"driftTicks","nameLocation":"4849:10:29","nodeType":"VariableDeclaration","scope":12258,"src":"4842:17:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"},"typeName":{"id":12241,"name":"uint24","nodeType":"ElementaryTypeName","src":"4842:6:29","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"}},"visibility":"internal"},{"constant":false,"id":12245,"mutability":"mutable","name":"trailTicks","nameLocation":"4991:10:29","nodeType":"VariableDeclaration","scope":12258,"src":"4984:17:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"},"typeName":{"id":12244,"name":"uint24","nodeType":"ElementaryTypeName","src":"4984:6:29","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"}},"visibility":"internal"},{"constant":false,"id":12248,"mutability":"mutable","name":"autoRebalance","nameLocation":"5085:13:29","nodeType":"VariableDeclaration","scope":12258,"src":"5080:18:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":12247,"name":"bool","nodeType":"ElementaryTypeName","src":"5080:4:29","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":12251,"mutability":"mutable","name":"lockOnFill","nameLocation":"5228:10:29","nodeType":"VariableDeclaration","scope":12258,"src":"5223:15:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":12250,"name":"bool","nodeType":"ElementaryTypeName","src":"5223:4:29","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":12254,"mutability":"mutable","name":"depositCap","nameLoc