ETH and ERC-20 currencies through the shared `Currency` type.\n @dev The zero address is treated as native ETH. Non-zero currency values are treated as ERC-20 token addresses.\n      ERC-20 transfers go through OpenZeppelin `SafeERC20`, so tokens that return `false` or nothing are handled\n      and failures revert. Native sends forward all remaining gas to the recipient, so every call site that\n      sends native currency must provide its own reentrancy protection (checks-effects-interactions plus a\n      `nonReentrant` guard)."},"fullyImplemented":true,"id":7925,"linearizedBaseContracts":[7925],"name":"CurrencyLib","nameLocation":"879:11:25","nodeType":"ContractDefinition","nodes":[{"global":false,"id":7820,"libraryName":{"id":7817,"name":"SafeERC20","nameLocations":["903:9:25"],"nodeType":"IdentifierPath","referencedDeclaration":1390,"src":"903:9:25"},"nodeType":"UsingForDirective","src":"897:27:25","typeName":{"id":7819,"nodeType":"UserDefinedTypeName","pathNode":{"id":7818,"name":"IERC20","nameLocations":["917:6:25"],"nodeType":"IdentifierPath","referencedDeclaration":914,"src":"917:6:25"},"referencedDeclaration":914,"src":"917:6:25","typeDescriptions":{"typeIdentifier":"t_contract$_IERC20_$914","typeString":"contract IERC20"}}},{"documentation":{"id":7821,"nodeType":"StructuredDocumentation","src":"930:226:25","text":" @notice Native ETH transfer failed.\n @dev Thrown by `transfer` when the low-level call to the recipient returns false, for example because the\n      recipient reverts or has no payable `receive`."},"errorSelector":"f4b3b1bc","id":7823,"name":"NativeTransferFailed","nameLocation":"1167:20:25","nodeType":"ErrorDefinition","parameters":{"id":7822,"nodeType":"ParameterList","parameters":[],"src":"1187:2:25"},"src":"1161:29:25"},{"body":{"id":7842,"nodeType":"Block","src":"1575:63:25","statements":[{"expression":{"commonType":{"typeIdentifier":"t_address","typeString":"address"},"id":7840,"isConstant":false,"isLValue":false,"isPure":false,"lValue