{"absolutePath":"//?/C:/Users/Abhay/Desktop/vortexa-core/lib/openzeppelin-contracts/contracts/utils/math/SafeCast.sol","exportedSymbols":{"SafeCast":[14192]},"id":14193,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":12429,"literals":["solidity","^","0.8",".20"],"nodeType":"PragmaDirective","src":"196:24:12"},{"abstract":false,"baseContracts":[],"canonicalName":"SafeCast","contractDependencies":[],"contractKind":"library","documentation":{"id":12430,"nodeType":"StructuredDocumentation","src":"224:561:12","text":" @dev Wrappers over Solidity's uintXX/intXX/bool casting operators with added overflow\n checks.\n Downcasting from uint256/int256 in Solidity does not revert on overflow. This can\n easily result in undesired exploitation or bugs, since developers usually\n assume that overflows raise errors. `SafeCast` restores this intuition by\n reverting the transaction when such an operation overflows.\n Using this library instead of the unchecked operations eliminates an entire\n class of bugs, so it's recommended to use it always."},"fullyImplemented":true,"id":14192,"linearizedBaseContracts":[14192],"name":"SafeCast","nameLocation":"795:8:12","nodeType":"ContractDefinition","nodes":[{"documentation":{"id":12431,"nodeType":"StructuredDocumentation","src":"811:69:12","text":" @dev Value doesn't fit in a uint of `bits` size."},"errorSelector":"6dfcc650","id":12437,"name":"SafeCastOverflowedUintDowncast","nameLocation":"892:30:12","nodeType":"ErrorDefinition","parameters":{"id":12436,"nodeType":"ParameterList","parameters":[{"constant":false,"id":12433,"mutability":"mutable","name":"bits","nameLocation":"929:4:12","nodeType":"VariableDeclaration","scope":12437,"src":"923:10:12","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":12432,"name":"uint8","nodeType":"ElementaryTypeName","src":"923:5:12","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"visibility":"