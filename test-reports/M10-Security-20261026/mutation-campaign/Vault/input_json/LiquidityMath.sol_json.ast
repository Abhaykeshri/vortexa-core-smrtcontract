{"absolutePath":"src/libraries/LiquidityMath.sol","exportedSymbols":{"LiquidityMath":[11720],"Math":[6755],"SafeCast":[14192]},"id":11721,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":11421,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:25"},{"absolutePath":"//?/C:/Users/Abhay/Desktop/vortexa-core/lib/openzeppelin-contracts/contracts/utils/math/Math.sol","file":"@openzeppelin/contracts/utils/math/Math.sol","id":11423,"nameLocation":"-1:-1:-1","nodeType":"ImportDirective","scope":11721,"sourceUnit":6756,"src":"57:65:25","symbolAliases":[{"foreign":{"id":11422,"name":"Math","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":6755,"src":"65:4:25","typeDescriptions":{}},"nameLocation":"-1:-1:-1"}],"unitAlias":""},{"absolutePath":"//?/C:/Users/Abhay/Desktop/vortexa-core/lib/openzeppelin-contracts/contracts/utils/math/SafeCast.sol","file":"@openzeppelin/contracts/utils/math/SafeCast.sol","id":11425,"nameLocation":"-1:-1:-1","nodeType":"ImportDirective","scope":11721,"sourceUnit":14193,"src":"123:73:25","symbolAliases":[{"foreign":{"id":11424,"name":"SafeCast","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":14192,"src":"131:8:25","typeDescriptions":{}},"nameLocation":"-1:-1:-1"}],"unitAlias":""},{"abstract":false,"baseContracts":[],"canonicalName":"LiquidityMath","contractDependencies":[],"contractKind":"library","documentation":{"id":11426,"nodeType":"StructuredDocumentation","src":"198:739:25","text":" @title Liquidity Math\n @notice Computes Uniswap-style liquidity and token amounts for Q64.96 price ranges.\n @dev Functions match the pinned Uniswap V4 math behavior used by M1 differential tests.\n      Rounding policy: liquidity and token amounts are always rounded down, so the amounts Uniswap pulls for the\n      computed liquidity never exceed the amounts supplied as inputs. Dust stays with the caller.\n      Safety: all products use OpenZeppelin full-precision `Math.mulDiv`, which guards the 512-bit\n      intermediate, and all `uint128` narrowing is checked and reverts instead of truncating. Production code\n      imports no Uniswap source; Uniswap's `LiquidityAmounts` is used only as a test oracle."},"fullyImplemented":true,"id":11720,"linearizedBaseContracts":[11720],"name":"LiquidityMath","nameLocation":"946:13:25","nodeType":"ContractDefinition","nodes":[{"documentation":{"id":11427,"nodeType":"StructuredDocumentation","src":"966:199:25","text":" @notice Price range endpoints are zero or equal after sorting.\n @dev Thrown when the lower endpoint is zero (division by zero risk) or both endpoints are equal (empty range)."},"errorSelector":"47ebe172","id":11429,"name":"InvalidPriceRange","nameLocation":"1176:17:25","nodeType":"ErrorDefinition","parameters":{"id":11428,"nodeType":"ParameterList","parameters":[],"src":"1193:2:25"},"src":"1170:26:25"},{"constant":true,"documentation":{"id":11430,"nodeType":"StructuredDocumentation","src":"1202:102:25","text":" @notice Fixed-point scaling factor for Q64.96 values.\n @dev Equal to `2**96`."},"id":11435,"mutability":"constant","name":"Q96","nameLocation":"1335:3:25","nodeType":"VariableDeclaration","scope":11720,"src":"1309:39:25","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":11431,"name":"uint256","nodeType":"ElementaryTypeName","src":"1309:7:25","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"value":{"commonType":{"typeIdentifier":"t_rational_79228162514264337593543950336_by_1","typeString":"int_const 79228162514264337593543950336"},"id":11434,"isConstant":false,"isLValue":false,"isPure":true,"lValueRequested":false,"leftExpression":{"hexValue":"31","id":11432,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"1341:1:25","typeDescriptions":{"typeIdentifier":"t_rational_1_by_1","typeString":"int_const 1"},"