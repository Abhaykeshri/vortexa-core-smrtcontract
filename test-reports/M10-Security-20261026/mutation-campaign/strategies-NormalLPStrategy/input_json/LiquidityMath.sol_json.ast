ypeIdentifier":"t_uint128","typeString":"uint128"}},"visibility":"internal"}],"id":2374,"initialValue":{"arguments":[{"id":2370,"name":"sqrtA","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":2329,"src":"3189:5:5","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},{"id":2371,"name":"sqrtPriceX96","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":2315,"src":"3196:12:5","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},{"id":2372,"name":"amount1","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":2323,"src":"3210:7:5","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}}],"expression":{"argumentTypes":[{"typeIdentifier":"t_uint160","typeString":"uint160"},{"typeIdentifier":"t_uint160","typeString":"uint160"},{"typeIdentifier":"t_uint256","typeString":"uint256"}],"id":2369,"name":"_liquidityForAmount1","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":2506,"src":"3168:20:5","typeDescriptions":{"typeIdentifier":"t_function_internal_pure$_t_uint160_$_t_uint160_$_t_uint256_$returns$_t_uint128_$","typeString":"function (uint160,uint160,uint256) pure returns (uint128)"}},"id":2373,"isConstant":false,"isLValue":false,"isPure":false,"kind":"functionCall","lValueRequested":false,"nameLocations":[],"names":[],"nodeType":"FunctionCall","src":"3168:50:5","tryCall":false,"typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"nodeType":"VariableDeclarationStatement","src":"3147:71:5"},{"expression":{"condition":{"commonType":{"typeIdentifier":"t_uint128","typeString":"uint128"},"id":2377,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"leftExpression":{"id":2375,"name":"liquidity0","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":2360,"src":"3235:10:5","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"nodeType":"BinaryOperation","operator":"<","rightExpression":{"id":2376,"name":"liquidity1","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":2368,"src":"3248:10:5","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"src":"3235:23:5","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"falseExpression":{"id":2379,"name":"liquidity1","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":2368,"src":"3274:10:5","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"id":2380,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"nodeType":"Conditional","src":"3235:49:5","trueExpression":{"id":2378,"name":"liquidity0","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":2360,"src":"3261:10:5","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"functionReturnParameters":2327,"id":2381,"nodeType":"Return","src":"3228:56:5"}]},"documentation":{"id":2313,"nodeType":"StructuredDocumentation","src":"1355:1176:5","text":" @notice Computes the maximum liquidity supported by token amounts in a price range.\n @dev Range endpoints are normalized; full-precision multiplication and checked narrowing prevent overflow.\n      Behavior by price position:\n      - current price at or below the lower bound: only currency0 limits liquidity;\n      - current price at or above the upper bound: only currency1 limits liquidity;\n      - current price inside the range: the smaller of the two single-token liquidities is returned, so the\n        scarcer token limits the position.\n      Reverts with `InvalidPriceRange` for a zero or empty range and with an OpenZeppelin `SafeCast` error\n      if the result does not fit in a uint128.\n @param sqrtPriceX96 The current Q64.96 square-root price.\n @param sqrtPriceAX96 One boundary of the Q64.96 price range.\n @param sqrtPriceBX96 The other boundary of the Q64.96 price range.\n @param amount0 The available currency0 amount.\n @param amount1 The available currency1 amount.\n @return liquidity The largest uint128 liquidity supported by both amounts."},"id":2383,"implemented":true,"kind":"function","modifiers":[],"name":"liquidityForAmounts","nameLocation":"2545:19:5","nodeType":"FunctionDefinition","parameters":{"id":2324,"nodeType":"ParameterList","parameters":[{"constant":false,"id":2315,"mutability":"mutable","name":"sqrtPriceX96","nameLocation":"2582:12:5","nodeType":"VariableDeclaration","scope":2383,"src":"2574:20:5","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":2314,"name":"uint160","nodeType":"ElementaryTypeName","src":"2574:7:5","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"},{"constant":false,"id":2317,"mutability":"mutable","name":"sqrtPriceAX96","nameLocation":"2612:13:5","nodeType":"VariableDeclaration","scope":2383,"src":"2604:21:5","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":2316,"name":"uint160","nodeType":"ElementaryTypeName","src":"2604:7:5","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"},{"constant":false,"id":2319,"mutability":"mutable","name":"sqrtPriceBX96","nameLocation":"2643:13:5","nodeType":"VariableDeclaration","scope":2383,"src":"2635:21:5","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":2318,"name":"uint160","nodeType":"ElementaryTypeName","src":"2635:7:5","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"},{"constant":false,"id":2321,"mutability":"mutable","name":"amount0","nameLocation":"2674:7:5","nodeType":"VariableDeclaration","