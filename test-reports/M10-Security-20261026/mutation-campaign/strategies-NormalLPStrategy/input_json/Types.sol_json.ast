{"absolutePath":"src/libraries/Types.sol","exportedSymbols":{"Band":[3242],"Currency":[3199],"DepositMode":[3228],"Plan":[3305],"PoolKey":[3218],"RebalanceParams":[3313],"Strategy":[3223],"VaultConfig":[3282]},"id":3314,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":3197,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:8"},{"canonicalName":"Currency","id":3199,"name":"Currency","nameLocation":"962:8:8","nodeType":"UserDefinedValueTypeDefinition","src":"957:25:8","underlyingType":{"id":3198,"name":"address","nodeType":"ElementaryTypeName","src":"974:7:8","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}}},{"canonicalName":"PoolKey","documentation":{"id":3200,"nodeType":"StructuredDocumentation","src":"984:291:8","text":" @notice Minimal Uniswap V4 pool key used to derive pool ids and read pool state.\n @dev The field order must match Uniswap's `PoolKey` exactly, because the pool id is the keccak256 hash of the\n      ABI-encoded struct. Currencies are sorted by address, `currency0 < currency1`."},"id":3218,"members":[{"constant":false,"id":3204,"mutability":"mutable","name":"currency0","nameLocation":"1378:9:8","nodeType":"VariableDeclaration","scope":3218,"src":"1369:18:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_userDefinedValueType$_Currency_$3199","typeString":"Currency"},"typeName":{"id":3203,"nodeType":"UserDefinedTypeName","pathNode":{"id":3202,"name":"Currency","nameLocations":["1369:8:8"],"nodeType":"IdentifierPath","referencedDeclaration":3199,"src":"1369:8:8"},"referencedDeclaration":3199,"src":"1369:8:8","typeDescriptions":{"typeIdentifier":"t_userDefinedValueType$_Currency_$3199","typeString":"Currency"}},"visibility":"internal"},{"constant":false,"id":3208,"mutability":"mutable","name":"currency1","nameLocation":"1475:9:8","nodeType":"VariableDeclaration","scope":3218,"src":"1466:18:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_userDefinedValueType$_Currency_$3199","typeString":"Currency"},"typeName":{"id":3207,"nodeType":"UserDefinedTypeName","pathNode":{"id":3206,"name":"Currency","nameLocations":["1466:8:8"],"nodeType":"IdentifierPath","referencedDeclaration":3199,"src":"1466:8:8"},"referencedDeclaration":3199,"src":"1466:8:8","typeDescriptions":{"typeIdentifier":"t_userDefinedValueType$_Currency_$3199","typeString":"Currency"}},"visibility":"internal"},{"constant":false,"id":3211,"mutability":"mutable","name":"fee","nameLocation":"1598:3:8","nodeType":"VariableDeclaration","scope":3218,"src":"1591:10:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"},"typeName":{"id":3210,"name":"uint24","nodeType":"ElementaryTypeName","src":"1591:6:8","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"}},"visibility":"internal"},{"constant":false,"id":3214,"mutability":"mutable","name":"tickSpacing","nameLocation":"1663:11:8","nodeType":"VariableDeclaration","scope":3218,"src":"1657:17:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":3213,"name":"int24","nodeType":"ElementaryTypeName","src":"1657:5:8","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":3217,"mutability":"mutable","name":"hooks","nameLocation":"1778:5:8","nodeType":"VariableDeclaration","scope":3218,"src":"1770:13:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":3216,"name":"address","nodeType":"ElementaryTypeName","src":"1770:7:8","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"}],"name":"PoolKey","nameLocation":"1283:7:8","nodeType":"StructDefinition","scope":3314,"src":"1276:510:8","visibility":"public"},{"canonicalName":"Strategy","documentation":{"id":3219,"nodeType":"StructuredDocumentation","src":"1788:262:8","text":" @notice High-level strategy selector for later vault planning milestones.\n @dev The numeric values are stored in vault configuration and emitted in events, so new strategies must only be\n      appended and existing members must never be reordered."},"id":3223,"members":[{"id":3220,"name":"NormalLP","nameLocation":"2169:8:8","nodeType":"EnumValue","src":"2169:8:8"},{"id":3221,"name":"BuyTheDip","nameLocation":"2280:9:8","nodeType":"EnumValue","src":"2280:9:8"},{"id":3222,"name":"SellThePump","nameLocation":"2392:11:8","nodeType":"EnumValue","src":"2392:11:8"}],"name":"Strategy","nameLocation":"2056:8:8","nodeType":"EnumDefinition","src":"2051:354:8"},{"canonicalName":"DepositMode","documentation":{"id":3224,"nodeType":"StructuredDocumentation","src":"2407:267:8","text":" @notice Deposit token selection mode for later vault deposit flows.\n @dev Reported by a strategy to tell the vault which tokens it accepts. One-sided strategies accept a single\n      token because their bands sit entirely on one side of the pool price."},"id":3228,"members":[{"id":3225,"name":"BothTokens","nameLocation":"2759:10:8","nodeType":"EnumValue","src":"2759:10:8"},{"id":3226,"name":"Token0Only","nameLocation":"2830:10:8","nodeType":"EnumValue","src":"2830:10:8"},{"id":3227,"name":"Token1Only","nameLocation":"2901:10:8","nodeType":"EnumValue","src":"2901:10:8"}],"name":"DepositMode","nameLocation":"2680:11:8","nodeType":"EnumDefinition","src":"2675:238:8"},{"canonicalName":"Band","documentation":{"id":3229,"nodeType":"StructuredDocumentation","src":"2915:403:8","text":" @notice One liquidity band in a planned or active position set.\n @dev Planned bands (returned by the shape library) carry zero `tokenId` and `liquidity`. Active bands record the\n      PositionManager NFT the vault owns for the band. Ticks must be multiples of the pool's tick spacing and lie\n      within the usable tick range; bands of one vault must be contiguous and non-overlapping."},"id":3242,"members":[{"constant":false,"id":3232,"mutability":"mutable","name":"tickLower","nameLocation":"3408:9:8","nodeType":"VariableDeclaration","scope":3242,"src":"3402:15:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":3231,"name":"int24","nodeType":"ElementaryTypeName","src":"3402:5:8","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":3235,"mutability":"mutable","name":"tickUpper","nameLocation":"3494:9:8","nodeType":"VariableDeclaration","scope":3242,"src":"3488:15:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":3234,"name":"int24","nodeType":"ElementaryTypeName","src":"3488:5:8","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":3238,"mutability":"mutable","name":"tokenId","nameLocation":"3600:7:8","nodeType":"VariableDeclaration","scope":3242,"src":"3592:15:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":3237,"name":"uint256","nodeType":"ElementaryTypeName","src":"3592:7:8","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":3241,"mutability":"mutable","name":"liquidity","nameLocation":"3691:9:8","nodeType":"VariableDeclaration","scope":3242,"src":"3683:17:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"},"typeName":{"id":3240,"name":"uint128","nodeType":"ElementaryTypeName","src":"3683:7:8","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"visibility":"internal"}],"name":"Band","nameLocation":"3326:4:8","nodeType":"StructDefinition","scope":3314,"src":"3319:384:8","visibility":"public"},{"canonicalName":"VaultConfig","documentation":{"id":3243,"nodeType":"StructuredDocumentation","src":"3705:403:8","text":" @notice User-facing vault strategy configuration used by later milestones.\n @dev Written once when a vault is initialized and immutable afterwards: no privileged function may change it.\n      The factory overwrites `baseIsCurrency0` with the value from the pool rule so a creator cannot flip it.\n      One-sided strategies use `trailTicks` and `lockOnFill`; Normal LP uses `driftTicks`."},"id":3282,"members":[{"constant":false,"id":3247,"mutability":"mutable","name":"poolKey","nameLocation":"4205:7:8","nodeType":"VariableDeclaration","scope":3282,"src":"4197:15:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$3218_storage_ptr","typeString":"struct PoolKey"},"typeName":{"id":3246,"nodeType":"UserDefinedTypeName","pathNode":{"id":3245,"name":"PoolKey","nameLocations":["4197:7:8"],"nodeType":"IdentifierPath","referencedDeclaration":3218,"src":"4197:7:8"},"referencedDeclaration":3218,"src":"4197:7:8","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$3218_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"},{"constant":false,"id":3251,"mutability":"mutable","name":"strategy","nameLocation":"4291:8:8","nodeType":"VariableDeclaration","scope":3282,"src":"4282:17:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_enum$_Strategy_$3223","typeString":"enum Strategy"},"typeName":{"id":3250,"nodeType":"UserDefinedTypeName","pathNode":{"id":3249,"name":"Strategy","nameLocations":["4282:8:8"],"nodeType":"IdentifierPath","referencedDeclaration":3223,"src":"4282:8:8"},"referencedDeclaration":3223,"src":"4282:8:8","typeDescriptions":{"typeIdentifier":"t_enum$_Strategy_$3223","typeString":"enum Strategy"}},"visibility":"internal"},{"constant":false,"id":3254,"mutability":"mutable","name":"shapeId","nameLocation":"4387:7:8","nodeType":"VariableDeclaration","scope":3282,"src":"4381:13:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":3253,"name":"uint8","nodeType":"ElementaryTypeName","src":"4381:5:8","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"visibility":"internal"},{"constant":false,"id":3257,"mutability":"mutable","name":"centerTick","nameLocation":"4481:10:8","nodeType":"VariableDeclaration","scope":3282,"src":"4475:16:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":3256,"name":"int24","nodeType":"ElementaryTypeName","src":"4475:5:8","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":3260,"mutability":"mutable","name":"ticksLeft","nameLocation":"4600:9:8","nodeType":"VariableDeclaration","scope":3282,"src":"4594:15:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":3259,"name":"int24","nodeType":"ElementaryTypeName","src":"4594:5:8","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":3263,"mutability":"mutable","name":"ticksRight","nameLocation":"4718:10:8","nodeType":"VariableDeclaration","scope":3282,"src":"4712:16:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":3262,"name":"int24","nodeType":"ElementaryTypeName","src":"4712:5:8","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":3266,"mutability":"mutable","name":"driftTicks","nameLocation":"4849:10:8","nodeType":"VariableDeclaration","scope":3282,"src":"4842:17:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"},"typeName":{"id":3265,"name":"uint24","nodeType":"ElementaryTypeName","src":"4842:6:8","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"}},"visibility":"internal"},{"constant":false,"id":3269,"mutability":"mutable","name":"trailTicks","nameLocation":"4991:10:8","nodeType":"VariableDeclaration","scope":3282,"src":"4984:17:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"},"typeName":{"id":3268,"name":"uint24","nodeType":"ElementaryTypeName","src":"4984:6:8","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"}},"visibility":"internal"},{"constant":false,"id":3272,"mutability":"mutable","name":"autoRebalance","nameLocation":"5085:13:8","nodeType":"VariableDeclaration","scope":3282,"src":"5080:18:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":3271,"name":"bool","nodeType":"ElementaryTypeName","src":"5080:4:8","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":3275,"mutability":"mutable","name":"lockOnFill","nameLocation":"5228:10:8","nodeType":"VariableDeclaration","scope":3282,"src":"5223:15:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":3274,"name":"bool","nodeType":"ElementaryTypeName","src":"5223:4:8","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":3278,"mutability":"mutable","name":"depositCap","nameLocation":"5358:10:8","nodeType":"VariableDeclaration","scope":3282,"src":"5350:18:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint25