tant":false,"id":12288,"mutability":"mutable","name":"maxSlippageBps","nameLocation":"7063:14:29","nodeType":"VariableDeclaration","scope":12289,"src":"7056:21:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"},"typeName":{"id":12287,"name":"uint16","nodeType":"ElementaryTypeName","src":"7056:6:29","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"}},"visibility":"internal"}],"name":"RebalanceParams","nameLocation":"6772:15:29","nodeType":"StructDefinition","scope":12290,"src":"6765:315:29","visibility":"public"}],"src":"32:7049:29"}