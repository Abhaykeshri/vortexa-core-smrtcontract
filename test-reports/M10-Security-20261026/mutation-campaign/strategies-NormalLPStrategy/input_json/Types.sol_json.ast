},"typeName":{"id":3311,"name":"uint16","nodeType":"ElementaryTypeName","src":"7056:6:8","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"}},"visibility":"internal"}],"name":"RebalanceParams","nameLocation":"6772:15:8","nodeType":"StructDefinition","scope":3314,"src":"6765:315:8","visibility":"public"}],"src":"32:7049:8"}