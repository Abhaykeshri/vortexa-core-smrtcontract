{"absolutePath":"src/libraries/PoolIdLib.sol","exportedSymbols":{"PoolIdLib":[5473],"PoolKey":[5888]},"id":5474,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":5452,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:13"},{"absolutePath":"src/libraries/Types.sol","file":"./Types.sol","id":5454,"nameLocation":"-1:-1:-1","nodeType":"ImportDirective","scope":5474,"sourceUnit":5984,"src":"57:36:13","symbolAliases":[{"foreign":{"id":5453,"name":"PoolKey","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":5888,"src":"65:7:13","typeDescriptions":{}},"nameLocation":"-1:-1:-1"}],"unitAlias":""},{"abstract":false,"baseContracts":[],"canonicalName":"PoolIdLib","contractDependencies":[],"contractKind":"library","documentation":{"id":5455,"nodeType":"StructuredDocumentation","src":"95:405:13","text":" @title Pool Id Library\n @notice Computes deterministic pool identifiers from Vortexa/Uniswap V4 pool keys.\n @dev The encoding is intentionally ABI encoding of the complete `PoolKey`.\n      The identifier is the same value Uniswap v4 uses as `PoolId`, so it can be passed directly to `StateView`\n      reads. Equality with Uniswap's `PoolIdLibrary` is asserted by a differential test."},"fullyImplemented":true,"id":5473,"linearizedBaseContracts":[5473],"name":"PoolIdLib","nameLocation":"509:9:13","nodeType":"ContractDefinition","nodes":[{"body":{"id":5471,"nodeType":"Block","src":"1072:50:13","statements":[{"expression":{"arguments":[{"arguments":[{"id":5467,"name":"key","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":5459,"src":"1110:3:13","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$5888_memory_ptr","typeString":"struct PoolKey memory"}}],"expression":{"argumentTypes":[{"typeIdentifier":"t_struct$_PoolKey_$5888_memory_ptr","typeString":"struct PoolKey memory"}],"expression":{"id":5465,"name":"abi","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":-1,"src":"1099:3:13","typeDescriptions":{"typeIdentifier":"t_magic_abi","typeString":"abi"}},"id":5466,"isConstant":false,"isLValue":false,"isPure":true,"lValueRequested":false,"memberLocation":"1103:6:13","memberName":"encode","nodeType":"MemberAccess","src":"1099:10:13","typeDescriptions":{"typeIdentifier":"t_function_abiencode_pure$__$returns$_t_bytes_memory_ptr_$","typeString":"function () pure returns (bytes memory)"}},"id":5468,"isConstant":false,"isLValue":false,"isPure":false,"kind":"functionCall","lValueRequested":false,"nameLocations":[],"names":[],"nodeType":"FunctionCall","src":"1099:15:13","tryCall":false,"typeDescriptions":{"typeIdentifier":"t_bytes_memory_ptr","typeString":"bytes memory"}}],"expression":{"argumentTypes":[{"typeIdentifier":"t_bytes_memory_ptr","typeString":"bytes memory"}],"id":5464,"name":"keccak256","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":-8,"src":"1089:9:13","typeDescriptions":{"typeIdentifier":"t_function_keccak256_pure$_t_bytes_memory_ptr_$returns$_t_bytes32_$","typeString":"function (bytes memory) pure returns (bytes32)"}},"id":5469,"isConstant":false,"isLValue":false,"isPure":false,"kind":"functionCall","lValueRequested":false,"nameLocations":[],"names":[],"nodeType":"FunctionCall","src":"1089:26:13","tryCall":false,"typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"functionReturnParameters":5463,"id":5470,"nodeType":"Return","src":"1082:33:13"}]},"documentation":{"id":5456,"nodeType":"StructuredDocumentation","src":"525:473:13","text":" @notice Computes the canonical identifier for a pool key.\n @dev The field order and ABI encoding match Uniswap v4 PoolKey: `currency0`, `currency1`, `fee`,\n      `tickSpacing`, `hooks`, each occupying one 32-byte word. Changing the order or the field types would\n      silently produce ids for non-existent pools.\n @param key The five-word, statically encoded pool key.\n @return id The keccak256 hash of the ABI-encoded key."},"id":5472,"implemented":true,"kind":"function","modifiers":[],"name":"toId","nameLocation":"1012:4:13","nodeType":"FunctionDefinition","parameters":{"id":5460,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5459,"mutability":"mutable","name":"key","nameLocation":"1032:3:13","nodeType":"VariableDeclaration","scope":5472,"src":"1017:18:13","stateVariable":false,"storageLocation":"memory","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$5888_memory_ptr","typeString":"struct PoolKey"},"typeName":{"id":5458,"nodeType":"UserDefinedTypeName","pathNode":{"id":5457,"name":"PoolKey","nameLocations":["1017:7:13"],"nodeType":"IdentifierPath","referencedDeclaration":5888,"src":"1017:7:13"},"referencedDeclaration":5888,"src":"1017:7:13","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$5888_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"}],"src":"1016:20:13"},"returnParameters":{"id":5463,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5462,"mutability":"mutable","name":"id","nameLocation":"1068:2:13","nodeType":"VariableDeclaration","scope":5472,"src":"1060:10:13","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":5461,"name":"bytes32","nodeType":"ElementaryTypeName","src":"1060:7:13","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"visibility":"internal"}],"src":"1059:12:13"},"scope":5473,"src":"1003:119:13","stateMutability":"pure","virtual":false,"visibility":"internal"}],"scope":5474,"src":"501:623:13","usedErrors":[],"usedEvents":[]}],"src":"32:1093:13"}