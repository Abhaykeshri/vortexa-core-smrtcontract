{"absolutePath":"src/interfaces/external/IStateViewLike.sol","exportedSymbols":{"IStateViewLike":[11301]},"id":11302,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":11251,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:23"},{"abstract":false,"baseContracts":[],"canonicalName":"IStateViewLike","contractDependencies":[],"contractKind":"interface","documentation":{"id":11252,"nodeType":"StructuredDocumentation","src":"57:519:23","text":" @title Uniswap V4 StateView Minimal Interface\n @notice Minimal interface for reading slot0 state from a Uniswap V4 pool.\n @dev PriceGuard uses `sqrtPriceX96` from `getSlot0` as the current pool price input.\n      This is a minimal, MIT-licensed interface declared by this project; it contains no Uniswap source. The\n      pool id passed in is the keccak256 hash of the ABI-encoded `PoolKey` (see `PoolIdLib.toId`). Later\n      milestones extend this interface with position and fee-growth reads."},"fullyImplemented":false,"id":11301,"linearizedBaseContracts":[11301],"name":"IStateViewLike","nameLocation":"587:14:23","nodeType":"ContractDefinition","nodes":[{"documentation":{"id":11253,"nodeType":"StructuredDocumentation","src":"608:661:23","text":" @notice Reads slot0 for a V4 pool.\n @dev An uninitialized pool returns a zero `sqrtPriceX96`, which callers must treat as \"pool does not exist\".\n      The returned price is the instantaneous spot price and can be manipulated within a single transaction,\n      so it must always be cross-checked against an external reference before being relied on.\n @param poolId Pool id derived from a Uniswap V4 `PoolKey`.\n @return sqrtPriceX96 Current square-root price as a Q64.96 value.\n @return tick Current pool tick.\n @return protocolFee Current protocol fee value.\n @return lpFee Current LP fee value."},"functionSelector":"c815641c","id":11266,"implemented":false,"kind":"function","modifiers":[],"name":"getSlot0","nameLocation":"1283:8:23","nodeType":"FunctionDefinition","parameters":{"id":11256,"nodeType":"ParameterList","parameters":[{"constant":false,"id":11255,"mutability":"mutable","name":"poolId","nameLocation":"1300:6:23","nodeType":"VariableDeclaration","scope":11266,"src":"1292:14:23","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":11254,"name":"bytes32","nodeType":"ElementaryTypeName","src":"1292:7:23","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"visibility":"internal"}],"src":"1291:16:23"},"returnParameters":{"id":11265,"nodeType":"ParameterList","parameters":[{"constant":false,"id":11258,"mutability":"mutable","name":"sqrtPriceX96","nameLocation":"1363:12:23","nodeType":"VariableDeclaration","scope":11266,"src":"1355:20:23","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":11257,"name":"uint160","nodeType":"ElementaryTypeName","src":"1355:7:23","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"},{"constant":false,"id":11260,"mutability":"mutable","name":"tick","nameLocation":"1383:4:23","nodeType":"VariableDeclaration","scope":11266,"src":"1377:10:23","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":11259,"name":"int24","nodeType":"ElementaryTypeName","src":"1377:5:23","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":11262,"mutability":"mutable","name":"protocolFee","nameLocation":"1396:11:23","nodeType":"VariableDeclaration","scope":11266,"src":"1389:18:23","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"},"typeName":{"id":11261,"name":"uint24","nodeType":"ElementaryTypeName","src":"1389:6:23","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"}},"visibility":"internal"},{"constant":false,"id":11264,"mutability":"mutable","name":"lpFee","nameLocation":"1416:5:23","nodeType":"VariableDeclaration","scope":11266,"src":"1409:12:23","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"},"typeName":{"id":11263,"name":"uint24","nodeType":"ElementaryTypeName","src":"1409:6:23","typeDescriptions":{"typeIdentifier":"t_uint24","typeString":"uint24"}},"visibility":"internal"}],"src":"1354:68:23"},"scope":11301,"src":"1274:149:23","stateMutability":"view","virtual":false,"visibility":"external"},{"documentation":{"id":11267,"nodeType":"StructuredDocumentation","src":"1429:770:23","text":" @notice Reads a V4 position's liquidity and last fee-growth checkpoints.\n @dev The salt is the PositionManager NFT id encoded as bytes32 for positions minted by this vault.\n @param poolId Pool id derived from a Uniswap V4 `PoolKey`.\n @param owner Position owner recorded in the PoolManager, normally the PositionManager contract.\n @param tickLower Lower tick of the position.\n @param tickUpper Upper tick of the position.\n @param salt Position salt, equal to `bytes32(tokenId)` for PositionManager NFTs.\n @return liquidity Active position liquidity.\n @return feeGrowthInside0LastX128 Last recorded fee growth for currency0.\n @return feeGrowthInside1LastX128 Last recorded fee growth for currency1."},"functionSelector":"dacf1d2f","id":11286,"implemented":false,"kind":"function","modifiers":[],"name":"getPositionInfo","nameLocation":"2213:15:23","nodeType":"FunctionDefinition","parameters":{"id":11278,"nodeType":"ParameterList","parameters":[{"constant":false,"id":11269,"mutability":"mutable","name":"poolId","nameLocation":"2237:6:23","nodeType":"VariableDeclaration","scope":11286,"src":"2229:14:23","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":11268,"name":"bytes32","nodeType":"ElementaryTypeName","src":"2229:7:23","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"visibility":"internal"},{"constant":false,"id":11271,"mutability":"mutable","name":"owner","nameLocation":"2253:5:23","nodeType":"VariableDeclaration","scope":11286,"src":"2245:13:23","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":11270,"name":"address","nodeType":"ElementaryTypeName","src":"2245:7:23","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":11273,"mutability":"mutable","name":"tickLower","nameLocation":"2266:9:23","nodeType":"VariableDeclaration","scope":11286,"src":"2260:15:23","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":11272,"name":"int24","nodeType":"ElementaryTypeName","src":"2260:5:23","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":11275,"mutability":"mutable","name":"tickUpper","nameLocation":"2283:9:23","nodeType":"VariableDeclaration","scope":11286,"src":"2277:15:23","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":11274,"name":"int24","nodeType":"ElementaryTypeName","src":"2277:5:23","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":11277,"mutability":"mutable","name":"salt","nameLocation":"2302:4:23","nodeType":"VariableDeclaration","scope":11286,"src":"2294:12:23","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":11276,"name":"bytes32","nodeType":"ElementaryTypeName","src":"2294:7:23","typeDescriptions":{"ty