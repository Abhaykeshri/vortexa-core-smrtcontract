g\n by making the `nonReentrant` function external, and making it call a\n `private` function that does the actual work."},"id":1433,"name":"nonReentrant","nameLocation":"3066:12:8","nodeType":"ModifierDefinition","parameters":{"id":1424,"nodeType":"ParameterList","parameters":[],"src":"3078:2:8"},"src":"3057:107:8","virtual":false,"visibility":"internal"},{"body":{"id":1440,"nodeType":"Block","src":"3609:56:8","statements":[{"expression":{"arguments":[],"expression":{"argumentTypes":[],"id":1436,"name":"_nonReentrantBeforeView","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":1452,"src":"3620:23:8","typeDescriptions":{"typeIdentifier":"t_function_internal_view$__$returns$__$","typeString":"function () view"}},"id":1437,"isConstant":false,"isLValue":false,"isPure":false,"kind":"functionCall","lValueRequested":false,"nameLocations":[],"names":[],"nodeType":"FunctionCall","src":"3620:25:8","tryCall":false,"typeDescriptions":{"typeIdentifier":"t_tuple$__$","typeString":"tuple()"}},"id":1438,"nodeType":"ExpressionStatement","src":"3620:25:8"},{"id":1439,"nodeType":"PlaceholderStatement","src":"3656:1:8"}]},"documentation":{"id":1434,"nodeType":"StructuredDocumentation","src":"3172:403:8","text":" @dev A `view` only version of {nonReentrant}. Use to block view functions\n from being called, preventing reading from inconsistent contract state.\n CAUTION: This is a \"view\" modifier and does not change the reentrancy\n status. Use it only on view functions. For payable or non-payable functions,\n use the standard {nonReentrant} modifier instead."},"id":1441,"name":"nonReentrantView","nameLocation":"3590:16:8","nodeType":"ModifierDefinition","parameters":{"id":1435,"nodeType":"ParameterList","parameters":[],"src":"3606:2:8"},"src":"3581:84:8","virtual":false,"visibility":"internal"},{"body":{"id":1451,"nodeType":"Block","src":"3721:113:8","statements":[{"condition":{"arguments":[],"expression":{"argumentTypes":[],"id":1444,"name":"_reentrancyGuard