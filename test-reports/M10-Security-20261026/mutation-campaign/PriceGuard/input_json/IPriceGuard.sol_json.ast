{"absolutePath":"src/interfaces/IPriceGuard.sol","exportedSymbols":{"IPriceGuard":[5345],"PoolKey":[5888]},"id":5346,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":5253,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:9"},{"absolutePath":"src/libraries/Types.sol","file":"../libraries/Types.sol","id":5255,"nameLocation":"-1:-1:-1","nodeType":"ImportDirective","scope":5346,"sourceUnit":5984,"src":"57:47:9","symbolAliases":[{"foreign":{"id":5254,"name":"PoolKey","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":5888,"src":"65:7:9","typeDescriptions":{}},"nameLocation":"-1:-1:-1"}],"unitAlias":""},{"abstract":false,"baseContracts":[],"canonicalName":"IPriceGuard","contractDependencies":[],"contractKind":"interface","documentation":{"id":5256,"nodeType":"StructuredDocumentation","src":"106:642:9","text":" @title PriceGuard Interface\n @notice Defines the configuration and runtime checks used to validate pool prices against oracle references.\n @dev Implementations are expected to compare a Uniswap V4 pool price with Chainlink and/or Uniswap V3 TWAP\n      references and return trust status without mutating state during price checks.\n      Consumers (vault, swap executor, factory) call `isPriceTrusted` in the same transaction as any action that\n      values shares or accepts a swap price, and never cache the result. Withdrawal paths must not call this\n      interface, so an oracle outage can never trap user funds."},"fullyImplemented":false,"id":5345,"linearizedBaseContracts":[5345],"name":"IPriceGuard","nameLocation":"759:11:9","nodeType":"ContractDefinition","nodes":[{"canonicalName":"IPriceGuard.PairConfig","documentation":{"id":5257,"nodeType":"StructuredDocumentation","src":"777:389:9","text":" @notice Reference-oracle configuration for one Uniswap V4 pool.\n @dev At least one of `chainlinkFeed` or `v3Pool` must be configured by the implementation. The Chainlink feed\n      is the primary reference and the V3 TWAP is the fallback. A `maxDeviationBps` of zero marks an unset\n      configuration, so implementations must reject zero when storing."},"id":5285,"members":[{"constant":false,"id":5260,"mutability":"mutable","name":"chainlinkFeed","nameLocation":"1309:13:9","nodeType":"VariableDeclaration","scope":5285,"src":"1301:21:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":5259,"name":"address","nodeType":"ElementaryTypeName","src":"1301:7:9","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":5263,"mutability":"mutable","name":"invertFeed","nameLocation":"1479:10:9","nodeType":"VariableDeclaration","scope":5285,"src":"1474:15:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":5262,"name":"bool","nodeType":"ElementaryTypeName","src":"1474:4:9","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":5266,"mutability":"mutable","name":"maxStaleness","nameLocation":"1609:12:9","nodeType":"VariableDeclaration","scope":5285,"src":"1602:19:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint32","typeString":"uint32"},"typeName":{"id":5265,"name":"uint32","nodeType":"ElementaryTypeName","src":"1602:6:9","typeDescriptions":{"typeIdentifier":"t_uint32","typeString":"uint32"}},"visibility":"internal"},{"constant":false,"id":5269,"mutability":"mutable","name":"minAnswer","nameLocation":"1765:9:9","nodeType":"VariableDeclaration","scope":5285,"src":"1757:17:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":5268,"name":"uint256","nodeType":"ElementaryTypeName","src":"1757:7:9","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":5272,"mutability":"mutable","name":"maxAnswer","nameLocation":"1918:9:9","nodeType":"VariableDeclaration","scope":5285,"src":"1910:17:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":5271,"name":"uint256","nodeType":"ElementaryTypeName","src":"1910:7:9","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":5275,"mutability":"mutable","name":"v3Pool","nameLocation":"2041:6:9","nodeType":"VariableDeclaration","scope":5285,"src":"2033:14:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":5274,"name":"address","nodeType":"ElementaryTypeName","src":"2033:7:9","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":5278,"mutability":"mutable","name":"invertV3","nameLocation":"2204:8:9","nodeType":"VariableDeclaration","scope":5285,"src":"2199:13:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":5277,"name":"bool","nodeType":"ElementaryTypeName","src":"2199:4:9","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":5281,"mutability":"mutable","name":"twapWindow","nameLocation":"2337:10:9","nodeType":"VariableDeclaration","scope":5285,"src":"2330:17:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint32","typeString":"uint32"},"typeName":{"id":5280,"name":"uint32","nodeType":"ElementaryTypeName","src":"2330:6:9","typeDescriptions":{"typeIdentifier":"t_uint32","typeString":"uint32"}},"visibility":"internal"},{"constant":false,"id":5284,"mutability":"mutable","name":"maxDeviationBps","nameLocation":"2491:15:9","nodeType":"VariableDeclaration","scope":5285,"src":"2484:22:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"},"typeName":{"id":5283,"name":"uint16","nodeType":"ElementaryTypeName","src":"2484:6:9","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"}},"visibility":"internal"}],"name":"PairConfig","nameLocation":"1178:10:9","nodeType":"StructDefinition","scope":5345,"src":"1171:1342:9","visibility":"public"},{"anonymous":false,"documentation":{"id":5286,"nodeType":"StructuredDocumentation","src":"2519:514:9","text":" @notice Emitted when a pool reference configuration is stored.\n @dev Emitted by `setPairConfig` after validation and storage, so indexers always see the stored values.\n @param poolId Uniswap V4 pool id derived from `key`.\n @param key Uniswap V4 pool key configured by the owner.\n @param config Oracle and deviation configuration stored for the pool.\n @param decimals0 Cached decimals for `key.currency0`.\n @param decimals1 Cached decimals for `key.currency1`."},"eventSelector":"68937cf29d67c2708cbe0c1e521c7b474f55187cbd273051bbc263f9f7f73e9e","id":5300,"name":"PairConfigSet","nameLocation":"3044:13:9","nodeType":"EventDefinition","parameters":{"id":5299,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5288,"indexed":true,"mutability":"mutable","name":"poolId","nameLocation":"3074:6:9","nodeType":"VariableDeclaration","scope":5300,"src":"3058:22:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":5287,"name":"bytes32","nodeType":"ElementaryTypeName","src":"3058:7:9","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"visibility":"internal"},{"constant":false,"id":5291,"indexed":false,"mutability":"mutable","name":"key","nameLocation":"3090:3:9","nodeType":"VariableDeclaration","scope":5300,"src":"3082:11:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$5888_memory_ptr","typeString":"struct PoolKey"},"typeName":{"id":5290,"nodeType":"UserDefinedTypeName","pathNode":{"id":5289,"name":"PoolKey","nameLocations":["3082:7:9"],"nodeType":"IdentifierPath","referencedDeclaration":5888,"src":"3082:7:9"},"referencedDeclaration":5888,"src":"3082:7:9","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$5888_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"},{"constant":false,"id":5294,"indexed":false,"mutability":"mutable","name":"config","nameLocation":"3106:6:9","nodeType":"VariableDeclaration","scope":5300,"src":"3095:17:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_struct$_PairConfig_$5285_memory_ptr","typeString":"struct IPriceGuard.PairConfig"},"typeName":{"id":5293,"nodeType":"UserDefinedTypeName","pathNode":{"id":5292,"name":"PairConfig","nameLocations":["3095:10:9"],"nodeType":"IdentifierPath","referencedDeclaration":5285,"src":"3095:10:9"},"referencedDeclaration":5285,"src":"3095:10:9","typeDescriptions":{"typeIdentifier":"t_struct$_PairConfig_$5285_storage_ptr","typeString":"struct IPriceGuard.PairConfig"}},"visibility":"internal"},{"constant":false,"id":5296,"indexed":false,"mutability":"mutable","name":"decimals0","nameLocation":"3120:9:9","nodeType":"VariableDeclaration","scope":5300,"src":"3114:15:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":5295,"name":"uint8","nodeType":"ElementaryTypeName","src":"3114:5:9","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"visibility":"internal"},{"constant":false,"id":5298,"indexed":false,"mutability":"mutable","name":"decimals1","nameLocation":"3137:9:9","nodeType":"VariableDeclaration","scope":5300,"src":"3131:15:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":5297,"name":"uint8","nodeType":"ElementaryTypeName","src":"3131:5:9","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"visibility":"internal"}],"src":"3057:90:9"},"src":"3038:110:9"},{"documentation":{"id":5301,"nodeType":"StructuredDocumentation","src":"3154:525:9","text":" @notice Stores or replaces the oracle configuration for a Uniswap V4 pool.\n @dev Restricted to the owner, which is expected to be a timelock. Implementations must validate the\n      configuration, cache both currencies' decimals, and confirm that the converted reference price agrees\n      with the live pool price before storing, and must emit `PairConfigSet`.\n @param key Pool key identifying the V4 pool.\n @param config Oracle reference and deviation settings for the pool."},"functionSelector":"c2e85d2d","id":5310,"implemented":false,"kind":"function","modifiers":[],"name":"setPairConfig","nameLocation":"3693:13:9","nodeType":"FunctionDefinition","parameters":{"id":5308,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5304,"mutability":"mutable","name":"key","nameLocation":"3724:3:9","nodeType":"VariableDeclaration","scope":5310,"src":"3707:20:9","stateVariable":false,"storageLocation":"calldata","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$5888_calldata_ptr","typeString":"struct PoolKey"},"typeName":{"id":5303,"nodeType":"UserDefinedTypeName","pathNode":{"id":5302,"name":"PoolKey","nameLocations":["3707:7:9"],"nodeType":"IdentifierPath","referencedDeclaration":5888,"src":"3707:7:9"},"referencedDeclaration":5888,"src":"3707:7:9","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$5888_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"},{"constant":false,"id":5307,"mutability":"mutable","name":"config","nameLocation":"3749:6:9","nodeType":"VariableDeclaration","scope":5310,"src":"3729:26:9","stateVariable":false,"storageLocation":"calldata","typeDescriptions":{"typeIdentifier":"t_struct$_PairConfig_$5285_calldata_ptr","typeString":"struct IPriceGuard.PairConfig"},"typeName":{"id":5306,"nodeType":"UserDefinedTypeName","pathNode":{"id":5305,"name":"PairConfig","nameLocations":["3729:10:9"],"nodeType":"IdentifierPath","referencedDeclaration":5285,"src":"3729:10:9"},"referencedDeclaration":5285,"src":"3729:10:9","typeDescriptions":{"typeIdentifier":"t_struct$_PairConfig_$5285_storage_ptr","typeString":"struct IPriceGuard.PairConfig"}},"visibility":"internal"}],"src":"3706:50:9"},"returnParameters":{"id":5309,"nodeType":"ParameterList","parameters":[],"src":"3765:0:9"},"scope":5345,"src":"3684:82:9","stateMutability":"nonpayable","virtual":false,"visibility":"external"},{"documentation":{"id":5311,"nodeType":"StructuredDocumentation","src":"3772:645:9","text":" @notice Checks whether the current V4 pool price is within the configured deviation from the reference price.\n @dev Must not mutate state. Stale, missing or invalid oracle data returns `(false, type(uint256).max)` rather\n      than reverting, so callers can raise one clear error; only a pool without a configuration reverts.\n @param key Pool key identifying the V4 pool to check.\n @return trusted True when the pool price is within the configured deviation and safety checks pass.\n @return devBps Observed deviation in basis points, or `type(uint256).max` when no trusted reference is available."},"functionSelector":"cf8b06c0","id":5321,"implemented":false,"kind":"function","modifiers":[],"name":"isPriceTrusted","nameLocation":"4431:14:9","nodeType":"FunctionDefinition","parameters":{"id":5315,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5314,"mutability":"mutable","name":"key","nameLocation":"4463:3:9","nodeType":"VariableDeclaration","scope":5321,"src":"4446:20:9","stateVariable":false,"storageLocation":"calldata","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$5888_calldata_ptr","typeString":"struct PoolKey"},"typeName":{"id":5313,"nodeType":"UserDefinedTypeName","pathNode":{"id":5312,"name":"PoolKey","nameLocations":["4446:7:9"],"nodeType":"IdentifierPath","referencedDeclaration":5888,"src":"4446:7:9"},"referencedDeclaration":5888,"src":"4446:7:9","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$5888_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"}],"src":"4445:22:9"},"returnParameters":{"id":5320,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5317,"mutability":"mutable","name":"trusted","nameLocation":"4496:7:9","nodeType":"VariableDeclaration","scope":5321,"src":"4491:12:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":5316,"name":"bool","nodeType":"ElementaryTypeName","src":"4491:4:9","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":5319,"mutability":"mutable","name":"devBps","nameLocation":"4513:6:9","nodeType":"VariableDeclaration","scope":5321,"src":"4505:14:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":5318,"name":"uint256","nodeType":"ElementaryTypeName","src":"4505:7:9","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"4490:30:9"},"scope":5345,"src":"4422:99:9","stateMutability":"view","virtual":false,"visibility":"external"},{"documentation":{"id":5322,"nodeType":"StructuredDocumentation","src":"4527:323:9","text":" @notice Returns the current trusted oracle reference price for a pool.\n @dev Reverts when the pair is not configured or its oracle/reference is not currently usable.\n @param key Pool key identifying the configured V4 pool.\n @return sqrtPriceX96 Trusted reference price in Q64.96 format."},"functionSelector":"4f2aa232","id":5330,"implemented":false,"kind":"function","modifiers":[],"name":"referenceSqrtPriceX96","nameLocation":"4864:21:9","nodeType":"FunctionDefinition","parameters":{"id":5326,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5325,"mutability":"mutable","name":"key","nameLocation":"4903:3:9","nodeType":"VariableDeclaration","scope":5330,"src":"4886:20:9","stateVariable":false,"storageLocation":"calldata","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$5888_calldata_ptr","typeString":"struct PoolKey"},"typeName":{"id":5324,"nodeType":"UserDefinedTypeName","pathNode":{"id":5323,"name":"PoolKey","nameLocations":["4886:7:9"],"nodeType":"IdentifierPath","referencedDeclaration":5888,"src":"4886:7:9"},"referencedDeclaration":5888,"src":"4886:7:9","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$5888_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"}],"src":"4885:22:9"},"returnParameters":{"id":5329,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5328,"mutability":"mutable","name":"sqrtPriceX96","nameLocation":"4939:12:9","nodeType":"VariableDeclaration","scope":5330,"src":"4931:20:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":5327,"name":"uint160","nodeType":"ElementaryTypeName","src":"4931:7:9","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"}],"src":"4930:22:9"},"scope":5345,"src":"4855:98:9","stateMutability":"view","virtual":false,"visibility":"external"},{"documentation":{"id":5331,"nodeType":"StructuredDocumentation","src":"4959:428:9","text":" @notice Returns the stored oracle configuration and cached currency decimals for a pool.\n @dev An unset pool returns a zeroed configuration; callers distinguish it by `maxDeviationBps == 0`.\n @param key Pool key identifying the V4 pool.\n @return config Stored pair configuration.\n @return decimals0 Cached decimals for currency0.\n @return decimals1 Cached decimals for currency1."},"functionSelector":"8bae2724","id":5344,"implemented":false,"kind":"function","modifiers":[],"name":"configOf","nameLocation":"5401:8:9","nodeType":"FunctionDefinition","parameters":{"id":5335,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5334,"mutability":"mutable","name":"key","nameLocation":"5427:3:9","nodeType":"VariableDeclaration","scope":5344,"src":"5410:20:9","stateVariable":false,"storageLocation":"calldata","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$5888_calldata_ptr","typeString":"struct PoolKey"},"typeName":{"id":5333,"nodeType":"UserDefinedTypeName","pathNode":{"id":5332,"name":"PoolKey","nameLocations":["5410:7:9"],"nodeType":"IdentifierPath","referencedDeclaration":5888,"src":"5410:7:9"},"referencedDeclaration":5888,"src":"5410:7:9","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$5888_storage_ptr","typeString":"struct PoolKey"}},"visibility":"internal"}],"src":"5409:22:9"},"returnParameters":{"id":5343,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5338,"mutability":"mutable","name":"config","nameLocation":"5497:6:9","nodeType":"VariableDeclaration","scope":5344,"src":"5479:24:9","stateVariable":false,"storageLocation":"memory","typeDescriptions":{"typeIdentifier":"t_struct$_PairConfig_$5285_memory_ptr","typeString":"struct IPriceGuard.PairConfig"},"typeName":{"id":5337,"nodeType":"UserDefinedTypeName","pathNode":{"id":5336,"name":"PairConfig","nameLocations":["5479:10:9"],"nodeType":"IdentifierPath","referencedDeclaration":5285,"src":"5479:10:9"},"referencedDeclaration":5285,"src":"5479:10:9","typeDescriptions":{"typeIdentifier":"t_struct$_PairConfig_$5285_storage_ptr","typeString":"struct IPriceGuard.PairConfig"}},"visibility":"internal"},{"constant":false,"id":5340,"mutability":"mutable","name":"decimals0","nameLocation":"5511:9:9","nodeType":"VariableDeclaration","scope":5344,"src":"5505:15:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":5339,"name":"uint8","nodeType":"ElementaryTypeName","src":"5505:5:9","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"visibility":"internal"},{"constant":false,"id":5342,"mutability":"mutable","name":"decimals1","nameLocation":"5528:9:9","nodeType":"VariableDeclaration","scope":5344,"src":"5522:15:9","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":5341,"name":"uint8","nodeType":"ElementaryTypeName","src":"5522:5:9","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"visibility":"internal"}],"src":"5478:60:9"},"scope":5345,"src":"5392:147:9","stateMutability":"view","virtual":false,"visibility":"external"}],"scope":5346,"src":"749:4792:9","usedErrors":[],"usedEvents":[5300]}],"src":"32:5510:9"}