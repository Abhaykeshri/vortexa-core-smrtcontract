:"7056:21:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"},"typeName":{"id":5981,"name":"uint16","nodeType":"ElementaryTypeName","src":"7056:6:15","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"}},"visibility":"internal"}],"name":"RebalanceParams","nameLocation":"6772:15:15","nodeType":"StructDefinition","scope":5984,"src":"6765:315:15","visibility":"public"}],"src":"32:7049:15"}