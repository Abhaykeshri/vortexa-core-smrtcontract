{"typeIdentifier":"t_uint128","typeString":"uint128"}},"nodeType":"BinaryOperation","operator":"<","rightExpression":{"id":9176,"name":"liquidity1","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":9168,"src":"3248:10:26","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"src":"3235:23:26","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"falseExpression":{"id":9179,"name":"liquidity1","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":9168,"src":"3274:10:26","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"id":9180,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"nodeType":"Conditional","src":"3235:49:26","trueExpression":{"id":9178,"name":"liquidity0","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":9160,"src":"3261:10:26","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"}},"functionReturnParameters":9127,"id":9181,"nodeType":"Return","src":"3228:56:26"}]},"documentation":{"id":9113,"nodeType":"StructuredDocumentation","src":"1355:1176:26","text":" @notice Computes the maximum liquidity supported by token amounts in a price range.\n @dev Range endpoints are normalized; full-precision multiplication and checked narrowing prevent overflow.\n      Behavior by price position:\n      - current price at or below the lower bound: only currency0 limits liquidity;\n      - current price at or above the upper bound: only currency1 limits liquidity;\n      - current price inside the range: the smaller of the two single-token liquidities is returned, so the\n        scarcer token limits the position.\n      Reverts with `InvalidPriceRange` for a zero or empty range and with an OpenZeppelin `SafeCast` error\n      if the result does not fit in a uint128.\n @param sqrtPriceX96 The current Q64.96 square-root price.\n @param sqrtPriceAX96 One boundary of the Q64.96 price range.\n @param sqrtPriceBX96 The other boundary of the Q64.96 price range.\n @param amount0 The available currency0 amount.\n @param amount1 The available currency1 amount.\n @return liquidity The largest uint128 liquidity supported by both amounts."},"id":9183,"implemented":true,"kind":"function","modifiers":[],"name":"liquidityForAmounts","nameLocation":"2545:19:26","nodeType":"FunctionDefinition","parameters":{"id":9124,"nodeType":"ParameterList","parameters":[{"constant":false,"id":9115,"mutability":"mutable","name":"sqrtPriceX96","nameLocation":"2582:12:26","nodeType":"VariableDeclaration","scope":9183,"src":"2574:20:26","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":9114,"name":"uint160","nodeType":"ElementaryTypeName","src":"2574:7:26","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"},{"constant":false,"id":9117,"mutability":"mutable","name":"sqrtPriceAX96","nameLocation":"2612:13:26","nodeType":"VariableDeclaration","scope":9183,"src":"2604:21:26","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":9116,"name":"uint160","nodeType":"ElementaryTypeName","src":"2604:7:26","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"},{"constant":false,"id":9119,"mutability":"mutable","name":"sqrtPriceBX96","nameLocation":"2643:13:26","nodeType":"VariableDeclaration","scope":9183,"src":"2635:21:26","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":9118,"name":"uint160","nodeType":"ElementaryTypeName","src":"2635:7:26","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"},{"constant":false,"id":9121,"mutability"