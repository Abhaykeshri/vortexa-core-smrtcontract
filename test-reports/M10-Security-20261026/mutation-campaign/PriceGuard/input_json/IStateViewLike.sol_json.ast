V4 `PoolKey`.\n @param tickLower Lower tick of the range.\n @param tickUpper Upper tick of the range.\n @return feeGrowthInside0X128 Current fee growth for currency0 inside the range.\n @return feeGrowthInside1X128 Current fee growth for currency1 inside the range."},"functionSelector":"53e9c1fb","id":5420,"implemented":false,"kind":"function","modifiers":[],"name":"getFeeGrowthInside","nameLocation":"2987:18:11","nodeType":"FunctionDefinition","parameters":{"id":5414,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5409,"mutability":"mutable","name":"poolId","nameLocation":"3014:6:11","nodeType":"VariableDeclaration","scope":5420,"src":"3006:14:11","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":5408,"name":"bytes32","nodeType":"ElementaryTypeName","src":"3006:7:11","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"visibility":"internal"},{"constant":false,"id":5411,"mutability":"mutable","name":"tickLower","nameLocation":"3028:9:11","nodeType":"VariableDeclaration","scope":5420,"src":"3022:15:11","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":5410,"name":"int24","nodeType":"ElementaryTypeName","src":"3022:5:11","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":5413,"mutability":"mutable","name":"tickUpper","nameLocation":"3045:9:11","nodeType":"VariableDeclaration","scope":5420,"src":"3039:15:11","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":5412,"name":"int24","nodeType":"ElementaryTypeName","src":"3039:5:11","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"}],"src":"3005:50:11"},"returnParameters":{"id":5419,"nodeType":"ParameterList","parameters"