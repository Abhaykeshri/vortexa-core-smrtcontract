The uint128 liquidity to value.\n @return amount0 The currency0 amount, rounded down.\n @return amount1 The currency1 amount, rounded down."},"id":11570,"implemented":true,"kind":"function","modifiers":[],"name":"amountsForLiquidity","nameLocation":"4192:19:25","nodeType":"FunctionDefinition","parameters":{"id":11516,"nodeType":"ParameterList","parameters":[{"constant":false,"id":11509,"mutability":"mutable","name":"sqrtPriceX96","nameLocation":"4220:12:25","nodeType":"VariableDeclaration","scope":11570,"src":"4212:20:25","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":11508,"name":"uint160","nodeType":"ElementaryTypeName","src":"4212:7:25","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"},{"constant":false,"id":11511,"mutability":"mutable","name":"sqrtPriceAX96","nameLocation":"4242:13:25","nodeType":"VariableDeclaration","scope":11570,"src":"4234:21:25","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":11510,"name":"uint160","nodeType":"ElementaryTypeName","src":"4234:7:25","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"},{"constant":false,"id":11513,"mutability":"mutable","name":"sqrtPriceBX96","nameLocation":"4265:13:25","nodeType":"VariableDeclaration","scope":11570,"src":"4257:21:25","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":11512,"name":"uint160","nodeType":"ElementaryTypeName","src":"4257:7:25","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"},{"constant":false,"id":11515,"mutability":"mutable","name":"liquidity","nameLocation":"4288:9:25","nodeType":"VariableDeclaration","scope":11570,"src":"4280:17:25","stateVariable":false,"storageLoca