PoolKey storage ref"}},"id":9465,"isConstant":false,"isLValue":true,"isPure":false,"lValueRequested":false,"memberLocation":"44860:9:14","memberName":"currency1","nodeType":"MemberAccess","referencedDeclaration":12184,"src":"44847:22:14","typeDescriptions":{"typeIdentifier":"t_userDefinedValueType$_Currency_$12175","typeString":"Currency"}},"id":9466,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"memberLocation":"44870:8:14","memberName":"transfer","nodeType":"MemberAccess","referencedDeclaration":11418,"src":"44847:31:14","typeDescriptions":{"typeIdentifier":"t_function_internal_nonpayable$_t_userDefinedValueType$_Currency_$12175_$_t_address_$_t_uint256_$returns$__$attached_to$_t_userDefinedValueType$_Currency_$12175_$","typeString":"function (Currency,address,uint256)"}},"id":9469,"isConstant":false,"isLValue":false,"isPure":false,"kind":"functionCall","lValueRequested":false,"nameLocations":[],"names":[],"nodeType":"FunctionCall","src":"44847:56:14","tryCall":false,"typeDescriptions":{"typeIdentifier":"t_tuple$__$","typeString":"tuple()"}},"id":9470,"nodeType":"ExpressionStatement","src":"44847:56:14"}]},"documentation":{"id":9359,"nodeType":"StructuredDocumentation","src":"42930:1078:14","text":" @notice Sends the protocol cut of collected trading fees to the factory's fee collector.\n @dev `protocolFee = floor(fee * bps / 10_000)` per currency, where `bps` is the factory's current fee clamped\n      to `MAX_PROTOCOL_FEE_BPS` (zero if the factory read reverts), so it never exceeds the fees and never\n      touches principal. Strict mode (collect, compound, deposit) reverts if the collector is\n      unset or a transfer fails. Lenient mode (withdraw) instead leaves the undeliverable part in the vault for\n      the remaining holders and emits `ProtocolFeeForfeited`, so no exit can be blocked by the fee path.\n      The factory is this vault's immutable `factory()`.\n @param fee0 Gross currency0 fees.\n @param fee1 Gross currency1 fees.\n @param strict True to revert on delivery failure, false to forfeit instead.\n @return protocolFee0 Currency0 protocol fee owed (and, in strict mode, transferred).\n @return protocolFee1 Currency1 protocol fee owed (and, in strict mode, transferred)."},"id":9472,"implemented":true,"kind":"function","modifiers":[],"name":"_payProtocolFee","nameLocation":"44022:15:14","nodeType":"FunctionDefinition","parameters":{"id":9366,"nodeType":"ParameterList","parameters":[{"constant":false,"id":9361,"mutability":"mutable","name":"fee0","nameLocation":"44046:4:14","nodeType":"VariableDeclaration","scope":9472,"src":"44038:12:14","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":9360,"name":"uint256","nodeType":"ElementaryTypeName","src":"44038:7:14","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":9363,"mutability":"mutable","name":"fee1","nameLocation":"44060:4:14","nodeType":"VariableDeclaration","scope":9472,"src":"44052:12:14","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":9362,"name":"uint256","nodeType":"ElementaryTypeName","src":"44052:7:14","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":9365,"mutability":"mutable","name":"strict","nameLocation":"44071:6:14","nodeType":"VariableDeclaration","scope":9472,"src":"44066:11:14","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":9364,"name":"bool","nodeType":"ElementaryTypeName","src":"44066:4:14","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"}],"src":"44037:41:14"},"returnParameters":{"id":9371,"nodeType":"ParameterList","parameters":[{"constant":false,"id":9368,"mutabilit