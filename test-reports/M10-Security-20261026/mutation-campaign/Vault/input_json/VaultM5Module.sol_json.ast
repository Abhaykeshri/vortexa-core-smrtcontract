tions":{"typeIdentifier":"t_struct$_PoolKey_$12194_storage","typeString":"struct PoolKey storage ref"}},"id":7954,"isConstant":false,"isLValue":true,"isPure":false,"lValueRequested":false,"memberLocation":"22754:9:14","memberName":"currency1","nodeType":"MemberAccess","referencedDeclaration":12184,"src":"22741:22:14","typeDescriptions":{"typeIdentifier":"t_userDefinedValueType$_Currency_$12175","typeString":"Currency"}},"id":7955,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"memberLocation":"22764:8:14","memberName":"transfer","nodeType":"MemberAccess","referencedDeclaration":11418,"src":"22741:31:14","typeDescriptions":{"typeIdentifier":"t_function_internal_nonpayable$_t_userDefinedValueType$_Currency_$12175_$_t_address_$_t_uint256_$returns$__$attached_to$_t_userDefinedValueType$_Currency_$12175_$","typeString":"function (Currency,address,uint256)"}},"id":7958,"isConstant":false,"isLValue":false,"isPure":false,"kind":"functionCall","lValueRequested":false,"nameLocations":[],"names":[],"nodeType":"FunctionCall","src":"22741:50:14","tryCall":false,"typeDescriptions":{"typeIdentifier":"t_tuple$__$","typeString":"tuple()"}},"id":7959,"nodeType":"ExpressionStatement","src":"22741:50:14"},{"expression":{"arguments":[{"id":7967,"name":"receiver","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":7733,"src":"22870:8:14","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},{"id":7968,"name":"amount0","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":7738,"src":"22880:7:14","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}}],"expression":{"argumentTypes":[{"typeIdentifier":"t_address","typeString":"address"},{"typeIdentifier":"t_uint256","typeString":"uint256"}],"expression":{"expression":{"expression":{"id":7960,"name":"_cfg","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":6970,"src":"22838:4:14","typeDescriptions":{"typeIdentifier":"t_struct$_VaultConfig_$12258_storage","typeString":"struct VaultConfig storage ref"}},"id":7964,"isConstant":false,"isLValue":true,"isPure":false,"lValueRequested":false,"memberLocation":"22843:7:14","memberName":"poolKey","nodeType":"MemberAccess","referencedDeclaration":12223,"src":"22838:12:14","typeDescriptions":{"typeIdentifier":"t_struct$_PoolKey_$12194_storage","typeString":"struct PoolKey storage ref"}},"id":7965,"isConstant":false,"isLValue":true,"isPure":false,"lValueRequested":false,"memberLocation":"22851:9:14","memberName":"currency0","nodeType":"MemberAccess","referencedDeclaration":12180,"src":"22838:22:14","typeDescriptions":{"typeIdentifier":"t_userDefinedValueType$_Currency_$12175","typeString":"Currency"}},"id":7966,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"memberLocation":"22861:8:14","memberName":"transfer","nodeType":"MemberAccess","referencedDeclaration":11418,"src":"22838:31:14","typeDescriptions":{"typeIdentifier":"t_function_internal_nonpayable$_t_userDefinedValueType$_Currency_$12175_$_t_address_$_t_uint256_$returns$__$attached_to$_t_userDefinedValueType$_Currency_$12175_$","typeString":"function (Currency,address,uint256)"}},"id":7969,"isConstant":false,"isLValue":false,"isPure":false,"kind":"functionCall","lValueRequested":false,"nameLocations":[],"names":[],"nodeType":"FunctionCall","src":"22838:50:14","tryCall":false,"typeDescriptions":{"typeIdentifier":"t_tuple$__$","typeString":"tuple()"}},"id":7970,"nodeType":"ExpressionStatement","src":"22838:50:14"}]},"documentation":{"id":7725,"nodeType":"StructuredDocumentation","src":"19130:1492:14","text":" @notice Burns the caller's shares and pays out their proportional share of both currencies (guide 7.2).\n @dev Order: read supply, idle balances and per-band pending fees; burn; lower stored liquidity; one\n      `modifyLiquidities` with DECREASE_LIQUIDITY per non-empty band and TAKE_PAIR to the vault; measure the\n      balance delta; take the protocol fee from the collected fees only; pay\n      `(delta - F) + f * (idle + F - protocolFee)`. Withdrawal depends on nothing but the PositionManager and\n      token transfers: the factory is read only when fees are pending, through non-reverting reads, and the\n      fee transfer is best-effort, so a broken factory or fee collector forfeits the fee instead of blocking the\n      exit. Bands with zero stored liquidity are skipped (Uniswap reverts on modifying an empty position). The\n      currency1 leg is paid before the currency0 leg, so a native-ETH receiver only ever observes final state.\n      Same signature as `Vault.withdrawPair`, which forwards its calldata unchanged; the vault's dependencies\n      are read back from its own immutable getters, and only when there are bands.\n @param shares Shares to burn.\n @param min0 Minimum currency0 output.\n @param min1 Minimum currency1 output.\n @param receiver Payout receiver.\n @return amount0 Currency0 paid to the receiver.\n @return amount1 Currency1 paid to the receiver."},"functionSelector":"61ce831e","id":7972,"implemented":true,"kind":"function","modifiers":[{"id":7736,"kind":"modifierInvocation","modifierName":{"id":7735,"name":"onlyDelegated","nameLocations":["21001:13:14"],"nodeType":"IdentifierPath","referencedDeclaration":7009,"src":"21001:13:14"},"nodeType":"ModifierInvocation","src":"21001:13:14"}],"name":"withdrawPair","nameLocation":"20901:12:14","nodeType":"FunctionDefinition","parameters":{"id":7734,"nodeType":"ParameterList","parameters":[{"constant":false,"id":7727,"mutability":"mutable","name":"shares","nameLocation":"20922:6:14","nodeType":"VariableDeclaration","scope":7972,"src":"20914:14:14","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":7726,"name":"uint256","nodeType":"ElementaryTypeName","src":"20914:7:14","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"