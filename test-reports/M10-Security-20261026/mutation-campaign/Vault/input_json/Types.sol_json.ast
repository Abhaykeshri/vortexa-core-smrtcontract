["6011:4:29"],"nodeType":"IdentifierPath","referencedDeclaration":12218,"src":"6011:4:29"},"referencedDeclaration":12218,"src":"6011:4:29","typeDescriptions":{"typeIdentifier":"t_struct$_Band_$12218_storage_ptr","typeString":"struct Band"}},"id":12263,"nodeType":"ArrayTypeName","src":"6011:6:29","typeDescriptions":{"typeIdentifier":"t_array$_t_struct$_Band_$12218_storage_$dyn_storage_ptr","typeString":"struct Band[]"}},"visibility":"internal"},{"constant":false,"id":12268,"mutability":"mutable","name":"weightsBps","nameLocation":"6099:10:29","nodeType":"VariableDeclaration","scope":12281,"src":"6090:19:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_array$_t_uint16_$dyn_storage_ptr","typeString":"uint16[]"},"typeName":{"baseType":{"id":12266,"name":"uint16","nodeType":"ElementaryTypeName","src":"6090:6:29","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"}},"id":12267,"nodeType":"ArrayTypeName","src":"6090:8:29","typeDescriptions":{"typeIdentifier":"t_array$_t_uint16_$dyn_storage_ptr","typeString":"uint16[]"}},"visibility":"internal"},{"constant":false,"id":12271,"mutability":"mutable","name":"needsSwap","nameLocation":"6195:9:29","nodeType":"VariableDeclaration","scope":12281,"src":"6190:14:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":12270,"name":"bool","nodeType":"ElementaryTypeName","src":"6190:4:29","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":12274,"mutability":"mutable","name":"zeroForOne","nameLocation":"6287:10:29","nodeType":"VariableDeclaration","scope":12281,"src":"6282:15:29","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":12273,"name":"bool","nodeType":"ElementaryTypeName","src":"6282:4:29","typeDescriptions":{"typeIdentifier":"t_bool","typeS