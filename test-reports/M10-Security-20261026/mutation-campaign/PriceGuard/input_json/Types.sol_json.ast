uctDefinition","scope":5984,"src":"1276:510:15","visibility":"public"},{"canonicalName":"Strategy","documentation":{"id":5889,"nodeType":"StructuredDocumentation","src":"1788:262:15","text":" @notice High-level strategy selector for later vault planning milestones.\n @dev The numeric values are stored in vault configuration and emitted in events, so new strategies must only be\n      appended and existing members must never be reordered."},"id":5893,"members":[{"id":5890,"name":"NormalLP","nameLocation":"2169:8:15","nodeType":"EnumValue","src":"2169:8:15"},{"id":5891,"name":"BuyTheDip","nameLocation":"2280:9:15","nodeType":"EnumValue","src":"2280:9:15"},{"id":5892,"name":"SellThePump","nameLocation":"2392:11:15","nodeType":"EnumValue","src":"2392:11:15"}],"name":"Strategy","nameLocation":"2056:8:15","nodeType":"EnumDefinition","src":"2051:354:15"},{"canonicalName":"DepositMode","documentation":{"id":5894,"nodeType":"StructuredDocumentation","src":"2407:267:15","text":" @notice Deposit token selection mode for later vault deposit flows.\n @dev Reported by a strategy to tell the vault which tokens it accepts. One-sided strategies accept a single\n      token because their bands sit entirely on one side of the pool price."},"id":5898,"members":[{"id":5895,"name":"BothTokens","nameLocation":"2759:10:15","nodeType":"EnumValue","src":"2759:10:15"},{"id":5896,"name":"Token0Only","nameLocation":"2830:10:15","nodeType":"EnumValue","src":"2830:10:15"},{"id":5897,"name":"Token1Only","nameLocation":"2901:10:15","nodeType":"EnumValue","src":"2901:10:15"}],"name":"DepositMode","nameLocation":"2680:11:15","nodeType":"EnumDefinition","src":"2675:238:15"},{"canonicalName":"Band","documentation":{"id":5899,"nodeType":"StructuredDocumentation","src":"2915:403:15","text":" @notice One liquidity band in a planned or active position set.\n @dev Planned bands (returned by the shape library) carry zero `tokenId` and `liquidity`. Active bands record the\n      PositionManager NFT the vault owns for the band. Ticks must be multiples of the pool's tick spacing and lie\n      within the usable tick range; bands of one vault must be contiguous and non-overlapping."},"id":5912,"members":[{"constant":false,"id":5902,"mutability":"mutable","name":"tickLower","nameLocation":"3408:9:15","nodeType":"VariableDeclaration","scope":5912,"src":"3402:15:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":5901,"name":"int24","nodeType":"ElementaryTypeName","src":"3402:5:15","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":5905,"mutability":"mutable","name":"tickUpper","nameLocation":"3494:9:15","nodeType":"VariableDeclaration","scope":5912,"src":"3488:15:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":5904,"name":"int24","nodeType":"ElementaryTypeName","src":"3488:5:15","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":5908,"mutability":"mutable","name":"tokenId","nameLocation":"3600:7:15","nodeType":"VariableDeclaration","scope":5912,"src":"3592:15:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":5907,"name":"uint256","nodeType":"ElementaryTypeName","src":"3592:7:15","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":5911,"mutability":"mutable","name":"liquidity","nameLocation":"3691:9:15","nodeType":"VariableDeclaration","scope":5912,"src":"3683:17:15","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"},"typeName":{"id":5910,"name":"uint128","nodeType":"ElementaryTypeName","src":"3683:7:15","typeDescriptions":{"typeIdentif