 Band"}},"id":3287,"nodeType":"ArrayTypeName","src":"6011:6:8","typeDescriptions":{"typeIdentifier":"t_array$_t_struct$_Band_$3242_storage_$dyn_storage_ptr","typeString":"struct Band[]"}},"visibility":"internal"},{"constant":false,"id":3292,"mutability":"mutable","name":"weightsBps","nameLocation":"6099:10:8","nodeType":"VariableDeclaration","scope":3305,"src":"6090:19:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_array$_t_uint16_$dyn_storage_ptr","typeString":"uint16[]"},"typeName":{"baseType":{"id":3290,"name":"uint16","nodeType":"ElementaryTypeName","src":"6090:6:8","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"}},"id":3291,"nodeType":"ArrayTypeName","src":"6090:8:8","typeDescriptions":{"typeIdentifier":"t_array$_t_uint16_$dyn_storage_ptr","typeString":"uint16[]"}},"visibility":"internal"},{"constant":false,"id":3295,"mutability":"mutable","name":"needsSwap","nameLocation":"6195:9:8","nodeType":"VariableDeclaration","scope":3305,"src":"6190:14:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":3294,"name":"bool","nodeType":"ElementaryTypeName","src":"6190:4:8","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":3298,"mutability":"mutable","name":"zeroForOne","nameLocation":"6287:10:8","nodeType":"VariableDeclaration","scope":3305,"src":"6282:15:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":3297,"name":"bool","nodeType":"ElementaryTypeName","src":"6282:4:8","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":3301,"mutability":"mutable","name":"swapAmountIn","nameLocation":"6377:12:8","nodeType":"VariableDeclaration","scope":3305,"src":"6369:20:8","stateVariable":false,"storageLocation":"default",