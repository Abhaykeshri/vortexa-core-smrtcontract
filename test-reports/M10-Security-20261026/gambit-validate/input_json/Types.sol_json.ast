uctDefinition","scope":8155,"src":"1276:510:30","visibility":"public"},{"canonicalName":"Strategy","documentation":{"id":8060,"nodeType":"StructuredDocumentation","src":"1788:262:30","text":" @notice High-level strategy selector for later vault planning milestones.\n @dev The numeric values are stored in vault configuration and emitted in events, so new strategies must only be\n      appended and existing members must never be reordered."},"id":8064,"members":[{"id":8061,"name":"NormalLP","nameLocation":"2169:8:30","nodeType":"EnumValue","src":"2169:8:30"},{"id":8062,"name":"BuyTheDip","nameLocation":"2280:9:30","nodeType":"EnumValue","src":"2280:9:30"},{"id":8063,"name":"SellThePump","nameLocation":"2392:11:30","nodeType":"EnumValue","src":"2392:11:30"}],"name":"Strategy","nameLocation":"2056:8:30","nodeType":"EnumDefinition","src":"2051:354:30"},{"canonicalName":"DepositMode","documentation":{"id":8065,"nodeType":"StructuredDocumentation","src":"2407:267:30","text":" @notice Deposit token selection mode for later vault deposit flows.\n @dev Reported by a strategy to tell the vault which tokens it accepts. One-sided strategies accept a single\n      token because their bands sit entirely on one side of the pool price."},"id":8069,"members":[{"id":8066,"name":"BothTokens","nameLocation":"2759:10:30","nodeType":"EnumValue","src":"2759:10:30"},{"id":8067,"name":"Token0Only","nameLocation":"2830:10:30","nodeType":"EnumValue","src":"2830:10:30"},{"id":8068,"name":"Token1Only","nameLocation":"2901:10:30","nodeType":"EnumValue","src":"2901:10:30"}],"name":"DepositMode","nameLocation":"2680:11:30","nodeType":"EnumDefinition","src":"2675:238:30"},{"canonicalName":"Band","documentation":{"id":8070,"nodeType":"StructuredDocumentation","src":"2915:403:30","text":" @notice One liquidity band in a planned or active position set.\n @dev Planned bands (returned by the shape library) carry zero `tokenId` and `liquidity`. Active bands record the\n      PositionManager NFT the vault owns for the band. Ticks must be multiples of the pool's tick spacing and lie\n      within the usable tick range; bands of one vault must be contiguous and non-overlapping."},"id":8083,"members":[{"constant":false,"id":8073,"mutability":"mutable","name":"tickLower","nameLocation":"3408:9:30","nodeType":"VariableDeclaration","scope":8083,"src":"3402:15:30","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":8072,"name":"int24","nodeType":"ElementaryTypeName","src":"3402:5:30","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":8076,"mutability":"mutable","name":"tickUpper","nameLocation":"3494:9:30","nodeType":"VariableDeclaration","scope":8083,"src":"3488:15:30","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":8075,"name":"int24","nodeType":"ElementaryTypeName","src":"3488:5:30","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":8079,"mutability":"mutable","name":"tokenId","nameLocation":"3600:7:30","nodeType":"VariableDeclaration","scope":8083,"src":"3592:15:30","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":8078,"name":"uint256","nodeType":"ElementaryTypeName","src":"3592:7:30","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":8082,"mutability":"mutable","name":"liquidity","nameLocation":"3691:9:30","nodeType":"VariableDeclaration","scope":8083,"src":"3683:17:30","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint128","typeString":"uint128"},"typeName":{"id":8081,"name":"uint128","nodeType":"ElementaryTypeName","src":"3683:7:30","typeDescriptions":{"typeIdentif