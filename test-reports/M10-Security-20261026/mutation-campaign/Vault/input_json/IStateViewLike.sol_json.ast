ng fees.\n @param poolId Pool id derived from a Uniswap V4 `PoolKey`.\n @param tickLower Lower tick of the range.\n @param tickUpper Upper tick of the range.\n @return feeGrowthInside0X128 Current fee growth for currency0 inside the range.\n @return feeGrowthInside1X128 Current fee growth for currency1 inside the range."},"functionSelector":"53e9c1fb","id":11300,"implemented":false,"kind":"function","modifiers":[],"name":"getFeeGrowthInside","nameLocation":"2987:18:23","nodeType":"FunctionDefinition","parameters":{"id":11294,"nodeType":"ParameterList","parameters":[{"constant":false,"id":11289,"mutability":"mutable","name":"poolId","nameLocation":"3014:6:23","nodeType":"VariableDeclaration","scope":11300,"src":"3006:14:23","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":11288,"name":"bytes32","nodeType":"ElementaryTypeName","src":"3006:7:23","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"visibility":"internal"},{"constant":false,"id":11291,"mutability":"mutable","name":"tickLower","nameLocation":"3028:9:23","nodeType":"VariableDeclaration","scope":11300,"src":"3022:15:23","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":11290,"name":"int24","nodeType":"ElementaryTypeName","src":"3022:5:23","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":11293,"mutability":"mutable","name":"tickUpper","nameLocation":"3045:9:23","nodeType":"VariableDeclaration","scope":11300,"src":"3039:15:23","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":11292,"name":"int24","nodeType":"ElementaryTypeName","src":"3039:5:23","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"}],"src":"3005:50:23"},"r