{"absolutePath":"src/interfaces/external/IUniswapV3PoolLike.sol","exportedSymbols":{"IUniswapV3PoolLike":[5450]},"id":5451,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":5423,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:12"},{"abstract":false,"baseContracts":[],"canonicalName":"IUniswapV3PoolLike","contractDependencies":[],"contractKind":"interface","documentation":{"id":5424,"nodeType":"StructuredDocumentation","src":"57:588:12","text":" @title Uniswap V3 Pool Minimal Interface\n @notice Minimal interface for validating pool tokens and reading TWAP data from a Uniswap V3 pool.\n @dev PriceGuard uses this as a fallback reference when Chainlink is unavailable or invalid.\n      V3 TWAPs can be manipulated on thin pools and short windows, so only deep-liquidity pools with a window of\n      at least ten minutes should be configured. V3 orders tokens by address, which can differ from the V4 key\n      ordering when native ETH is involved; the pair configuration's `invertV3` flag compensates for that."},"fullyImplemented":false,"id":5450,"linearizedBaseContracts":[5450],"name":"IUniswapV3PoolLike","nameLocation":"656:18:12","nodeType":"ContractDefinition","nodes":[{"documentation":{"id":5425,"nodeType":"StructuredDocumentation","src":"681:209:12","text":" @notice Returns the first token in the V3 pool's canonical ordering.\n @dev The lower address of the pair. Reverts for contracts that are not V3 pools.\n @return Address of token0."},"functionSelector":"0dfe1681","id":5430,"implemented":false,"kind":"function","modifiers":[],"name":"token0","nameLocation":"904:6:12","nodeType":"FunctionDefinition","parameters":{"id":5426,"nodeType":"ParameterList","parameters":[],"src":"910:2:12"},"returnParameters":{"id":5429,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5428,"mutability":"mutable","name":"","nameLocation":"-1:-1:-1","nodeType":"VariableDeclaration","scope":5430,"src":"936:7:12","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":5427,"name":"address","nodeType":"ElementaryTypeName","src":"936:7:12","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"}],"src":"935:9:12"},"scope":5450,"src":"895:50:12","stateMutability":"view","virtual":false,"visibility":"external"},{"documentation":{"id":5431,"nodeType":"StructuredDocumentation","src":"951:211:12","text":" @notice Returns the second token in the V3 pool's canonical ordering.\n @dev The higher address of the pair. Reverts for contracts that are not V3 pools.\n @return Address of token1."},"functionSelector":"d21220a7","id":5436,"implemented":false,"kind":"function","modifiers":[],"name":"token1","nameLocation":"1176:6:12","nodeType":"FunctionDefinition","parameters":{"id":5432,"nodeType":"ParameterList","parameters":[],"src":"1182:2:12"},"returnParameters":{"id":5435,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5434,"mutability":"mutable","name":"","nameLocation":"-1:-1:-1","nodeType":"VariableDeclaration","scope":5436,"src":"1208:7:12","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":5433,"name":"address","nodeType":"ElementaryTypeName","src":"1208:7:12","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"}],"src":"1207:9:12"},"scope":5450,"src":"1167:50:12","stateMutability":"view","virtual":false,"visibility":"external"},{"documentation":{"id":5437,"nodeType":"StructuredDocumentation","src":"1223:640:12","text":" @notice Returns cumulative tick observations for the requested lookback points.\n @dev Reverts when the oracle history is shorter than the oldest requested point. The mean tick between two\n      observations is the difference of the tick cumulatives divided by the elapsed seconds, rounded toward\n      negative infinity.\n @param secondsAgos Array of seconds-before-current timestamps to observe.\n @return tickCumulatives Cumulative ticks at each requested observation point.\n @return secondsPerLiquidityCumulativeX128s Cumulative seconds-per-liquidity values at each observation point."},"functionSelector":"883bdbfd","id":5449,"implemented":false,"kind":"function","modifiers":[],"name":"observe","nameLocation":"1877:7:12","nodeType":"FunctionDefinition","parameters":{"id":5441,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5440,"mutability":"mutable","name":"secondsAgos","nameLocation":"1903:11:12","nodeType":"VariableDeclaration","scope":5449,"src":"1885:29:12","stateVariable":false,"storageLocation":"calldata","typeDescriptions":{"typeIdentifier":"t_array$_t_uint32_$dyn_calldata_ptr","typeString":"uint32[]"},"typeName":{"baseType":{"id":5438,"name":"uint32","nodeType":"ElementaryTypeName","src":"1885:6:12","typeDescriptions":{"typeIdentifier":"t_uint32","typeString":"uint32"}},"id":5439,"nodeType":"ArrayTypeName","src":"1885:8:12","typeDescriptions":{"typeIdentifier":"t_array$_t_uint32_$dyn_storage_ptr","typeString":"uint32[]"}},"visibility":"internal"}],"src":"1884:31:12"},"returnParameters":{"id":5448,"nodeType":"ParameterList","parameters":[{"constant":false,"id":5444,"mutability":"mutable","name":"tickCumulatives","nameLocation":"1978:15:12","nodeType":"VariableDeclaration","scope":5449,"src":"1963:30:12","stateVariable":false,"storageLocation":"memory","typeDescriptions":{"typeIdentifier":"t_array$_t_int56_$dyn_memory_ptr","typeString":"int56[]"},"typeName":{"baseType":{"id":5442,"name":"int56","nodeType":"ElementaryTypeName","src":"1963:5:12","typeDescriptions":{"typeIdentifier":"t_int56","typeString":"int56"}},"id":5443,"nodeType":"ArrayTypeName","src":"1963:7:12","typeDescriptions":{"typeIdentifier":"t_array$_t_int56_$dyn_storage_ptr","typeString":"int56[]"}},"visibility":"internal"},{"constant":false