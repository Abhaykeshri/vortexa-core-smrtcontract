ype":"ElementaryTypeName","src":"6369:7:2","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":1014,"mutability":"mutable","name":"lockIdle","nameLocation":"6479:8:2","nodeType":"VariableDeclaration","scope":1015,"src":"6474:13:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":1013,"name":"bool","nodeType":"ElementaryTypeName","src":"6474:4:2","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"}],"name":"Plan","nameLocation":"5944:4:2","nodeType":"StructDefinition","scope":1024,"src":"5937:553:2","visibility":"public"},{"canonicalName":"RebalanceParams","documentation":{"id":1016,"nodeType":"StructuredDocumentation","src":"6492:272:2","text":" @notice Parameters supplied to a rebalance operation.\n @dev Supplied by a keeper, who is trusted for liveness only. Both values are treated as hostile: the vault\n      bounds the center against the real pool tick and the slippage against its own loss check."},"id":1023,"members":[{"constant":false,"id":1019,"mutability":"mutable","name":"newCenterTick","nameLocation":"6912:13:2","nodeType":"VariableDeclaration","scope":1023,"src":"6906:19:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":1018,"name":"int24","nodeType":"ElementaryTypeName","src":"6906:5:2","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":1022,"mutability":"mutable","name":"maxSlippageBps","nameLocation":"7063:14:2","nodeType":"VariableDeclaration","scope":1023,"src":"7056:21:2","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint16","typeString":"uint16"},"typeName":{"id":1021,"name":"uint16","nodeType":"ElementaryTypeName","src":"7056:6:2","typeDescriptions":{"typeIden