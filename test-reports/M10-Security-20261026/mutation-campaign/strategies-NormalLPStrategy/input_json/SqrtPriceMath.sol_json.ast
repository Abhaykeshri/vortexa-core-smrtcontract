","typeString":"bool"}},"falseExpression":{"hexValue":"31","id":3181,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"5686:1:7","typeDescriptions":{"typeIdentifier":"t_rational_1_by_1","typeString":"int_const 1"},"value":"1"},"id":3182,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"nodeType":"Conditional","src":"5650:37:7","trueExpression":{"hexValue":"30","id":3180,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"5682:1:7","typeDescriptions":{"typeIdentifier":"t_rational_0_by_1","typeString":"int_const 0"},"value":"0"},"typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}}],"id":3183,"isConstant":false,"isInlineArray":false,"isLValue":false,"isPure":false,"lValueRequested":false,"nodeType":"TupleExpression","src":"5649:39:7","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"src":"5633:55:7","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"nodeType":"VariableDeclarationStatement","src":"5615:73:7"},{"expression":{"id":3191,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"leftHandSide":{"id":3186,"name":"sqrtPriceX96","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":2826,"src":"5698:12:7","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"nodeType":"Assignment","operator":"=","rightHandSide":{"arguments":[{"id":3189,"name":"rounded","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":3166,"src":"5732:7:7","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}}],"expression":{"argumentTypes":[{"typeIdentifier":"t_uint256","typeString":"uint256"}],"expression":{"id":3187,"name":"SafeCast","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":5904,"src":"5713:8:7","typeDescriptions":{"typeIdentifier":"t_type$_t_contract$_SafeCast_$5904_$","typeString":"type(library SafeCast)"}},"id":3188,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"memberLocation":"5722:9:7","memberName":"toUint160","nodeType":"MemberAccess","referencedDeclaration":4502,"src":"5713:18:7","typeDescriptions":{"typeIdentifier":"t_function_internal_pure$_t_uint256_$returns$_t_uint160_$","typeString":"function (uint256) pure returns (uint160)"}},"id":3190,"isConstant":false,"isLValue":false,"isPure":false,"kind":"functionCall","lValueRequested":false,"nameLocations":[],"names":[],"nodeType":"FunctionCall","src":"5713:27:7","tryCall":false,"typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"src":"5698:42:7","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"id":3192,"nodeType":"ExpressionStatement","src":"5698:42:7"}]},"documentation":{"id":2821,"nodeType":"StructuredDocumentation","src":"1447:862:7","text":" @notice Converts a tick to its Q64.96 square-root price.\n @dev Uses the independently implemented bitwise exponentiation and rounds the Q128.128 result up to Q64.96.\n      The loop-free algorithm multiplies one precomputed Q128.128 constant per set bit of `|tick|`. The\n      constants are nearest-integer rounded values of `2^128 / sqrt(1.0001)^(2^k)` for `k = 0..18`, matching\n      the pinned Uniswap implementation (a literal floor would not reproduce Uniswap's outputs). For positive\n      ticks the ratio is inverted. The final Q128.128 to Q64.96 conversion rounds up.\n      Reverts with `InvalidTick` when `tick` is outside `[MIN_TICK, MAX_TICK]`.\n @param tick The tick in the inclusive Uniswap v4 range.\n @return sqrtPriceX96 The square root of 1.0001^tick, scaled by 2^96."},"id":3194,"implemented":true,"kind":"function","modifiers":[],"name":"getSqrtPriceAtTick","nameLocation":"2323:18:7","nodeType":"FunctionDefinition","parameters":{"id":2824,"nodeType":"ParameterList","parameters":[{"constant":false,"id":2823,"mutability":"mutable","name":"tick","nameLocation":"2348:4:7","nodeType":"VariableDeclaration","scope":3194,"src":"2342:10:7","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":2822,"name":"int24","nodeType":"ElementaryTypeName","src":"2342:5:7","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"}],"src":"2341:12:7"},"returnParameters":{"id":2827,"nodeType":"ParameterList","parameters":[{"constant":false,"id":2826,"mutability":"mutable","name":"sqrtPriceX96","nameLocation":"2385:12:7","nodeType":"VariableDeclaration","scope":3194,"src":"2377:20:7","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":2825,"name":"uint160","nodeType":"ElementaryTypeName","src":"2377:7:7","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"}],"src":"2376:22:7"},"scope":3195,"src":"2314:3433:7","stateMutability":"pure","virtual":false,"visibility":"internal"}],"scope":3196,"src":"840:4909:7","usedErrors":[2811],"usedEvents":[]}],"src":"32:5718:7"}