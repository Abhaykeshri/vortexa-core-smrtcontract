V4 `PoolKey`.\n @param tickLower Lower tick of the range.\n @param tickUpper Upper tick of the range.\n @return feeGrowthInside0X128 Current fee growth for currency0 inside the range.\n @return feeGrowthInside1X128 Current fee growth for currency1 inside the range."},"functionSelector":"53e9c1fb","id":9095,"implemented":false,"kind":"function","modifiers":[],"name":"getFeeGrowthInside","nameLocation":"2987:18:23","nodeType":"FunctionDefinition","parameters":{"id":9089,"nodeType":"ParameterList","parameters":[{"constant":false,"id":9084,"mutability":"mutable","name":"poolId","nameLocation":"3014:6:23","nodeType":"VariableDeclaration","scope":9095,"src":"3006:14:23","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":9083,"name":"bytes32","nodeType":"ElementaryTypeName","src":"3006:7:23","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"visibility":"internal"},{"constant":false,"id":9086,"mutability":"mutable","name":"tickLower","nameLocation":"3028:9:23","nodeType":"VariableDeclaration","scope":9095,"src":"3022:15:23","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":9085,"name":"int24","nodeType":"ElementaryTypeName","src":"3022:5:23","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"},{"constant":false,"id":9088,"mutability":"mutable","name":"tickUpper","nameLocation":"3045:9:23","nodeType":"VariableDeclaration","scope":9095,"src":"3039:15:23","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"},"typeName":{"id":9087,"name":"int24","nodeType":"ElementaryTypeName","src":"3039:5:23","typeDescriptions":{"typeIdentifier":"t_int24","typeString":"int24"}},"visibility":"internal"}],"src":"3005:50:23"},"returnParameters":{"id":9094,"nodeType":"ParameterList","parameters"