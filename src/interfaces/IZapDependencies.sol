pragma solidity 0.8.26;

import {IPriceGuard} from "./IPriceGuard.sol";
import {IShapeLibrary} from "./IShapeLibrary.sol";
import {IStrategy} from "./IStrategy.sol";
import {ISwapExecutor} from "./ISwapExecutor.sol";
import {IVault} from "./IVault.sol";
import {IVaultFactory} from "./IVaultFactory.sol";
import {PoolKey} from "../libraries/Types.sol";

/**
 * @title M9 Vault Read Extension
 * @notice Existing Vault views consumed only by Zap, isolated from the stable M4-M8 interface.
 * @dev Declares deployed Vault selectors without expanding the legacy IVault mock surface.
 */
interface IZapVault is IVault {
    /**
     * @notice Returns the immutable clone-local strategy.
     * @dev Used to bind enum-based Zap math to the actual strategy implementation.
     * @return vaultStrategy Strategy stored when the clone was initialized.
     */
    function strategy() external view returns (IStrategy vaultStrategy);

    /**
     * @notice Previews shares for a token1-denominated ERC-4626 asset amount.
     * @dev This is an estimate input, not an exact pair-deposit preview.
     * @param assets Token1-denominated value to preview.
     * @return shares Estimated vault shares.
     */
    function previewDeposit(uint256 assets) external view returns (uint256 shares);
}

/**
 * @title M9 Factory Read Extension
 * @notice Existing autogenerated Factory getter consumed only by Zap.
 * @dev Declares the deployed immutable getter without expanding legacy factory mocks.
 */
interface IZapFactory is IVaultFactory {
    /**
     * @notice Returns the immutable ShapeLibrary.
     * @dev Used to reproduce first-deposit band geometry.
     * @return shapeLibrary Factory-approved band calculator.
     */
    function shapes() external view returns (IShapeLibrary shapeLibrary);
}

/**
 * @title M9 SwapExecutor Extension
 * @notice Existing getters plus the M9 shared quote helper, isolated from legacy executor mocks.
 * @dev Matches the concrete SwapExecutor surface used by Zap.
 */
interface IZapSwapExecutor is ISwapExecutor {
    /**
     * @notice Returns the hard maximum slippage in basis points.
     * @dev Zap rejects a caller tolerance above this value.
     * @return maxSlippageBps Executor hard cap.
     */
    function MAX_SLIPPAGE_BPS() external view returns (uint256 maxSlippageBps);

    /**
     * @notice Returns the executor's immutable factory.
     * @dev Used for mutual dependency validation.
     * @return vaultFactory Registry authorized by the executor.
     */
    function factory() external view returns (IVaultFactory vaultFactory);

    /**
     * @notice Returns the executor's immutable PriceGuard.
     * @dev Used to ensure the vault and executor share one oracle policy.
     * @return guard Executor oracle dependency.
     */
    function priceGuard() external view returns (IPriceGuard guard);

    /**
     * @notice Computes an oracle-derived minimum output with executor-identical rounding.
     * @dev Rejects a tolerance above the executor hard cap.
     * @param key V4 pool key.
     * @param zeroForOne Swap direction.
     * @param amountIn Exact input amount.
     * @param sqrtReference Trusted reference square-root price.
     * @param slippageBps Requested tolerance.
     * @return floor Minimum acceptable output.
     */
    function minOutFromReference(
        PoolKey calldata key,
        bool zeroForOne,
        uint256 amountIn,
        uint160 sqrtReference,
        uint16 slippageBps
    ) external pure returns (uint256 floor);
}
