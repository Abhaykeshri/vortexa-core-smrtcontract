{"absolutePath":"src/libraries/SqrtPriceMath.sol","exportedSymbols":{"SafeCast":[14192],"SqrtPriceMath":[12171]},"id":12172,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":11781,"literals":["solidity","0.8",".26"],"nodeType":"PragmaDirective","src":"32:23:28"},{"absolutePath":"//?/C:/Users/Abhay/Desktop/vortexa-core/lib/openzeppelin-contracts/contracts/utils/math/SafeCast.sol","file":"@openzeppelin/contracts/utils/math/SafeCast.sol","id":11783,"nameLocation":"-1:-1:-1","nodeType":"ImportDirective","scope":12172,"sourceUnit":14193,"src":"57:73:28","symbolAliases":[{"foreign":{"id":11782,"name":"SafeCast","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":14192,"src":"65:8:28","typeDescriptions":{}},"nameLocation":"-1:-1:-1"}],"unitAlias":""},{"abstract":false,"baseContracts":[],"canonicalName":"SqrtPriceMath","contractDependencies":[],"contractKind":"library","documentation":{"id":11784,"nodeType":"StructuredDocumentation","src":"132:707:28","text":" @title Square-Root Price Math\n @notice Converts Uniswap ticks into Q64.96 square-root prices.\n @dev The implementation is independently tested against pinned Uniswap V4 TickMath outputs.\n      This is an independent implementation, not a copy of Uniswap source, so production code carries no\n      BUSL-licensed material. Uniswap's `TickMath` is used only as a differential test oracle: results must\n      match exactly for every tested tick, including both boundaries.\n      Only the forward direction (tick to price) is provided. The inverse is never needed on-chain because the\n      current tick comes from `StateView.getSlot0` and prices are converted to ticks off-chain."},"fullyImplemented":true,"id":12171,"linearizedBaseContracts":[12171],"name":"SqrtPriceMath","nameLocation":"848:13:28","nodeType":"ContractDefinition","nodes":[{"documentation":{"id":11785,"nodeType":"StructuredDocumentation","src":"868:167:28","text":" @notice Tick is outside the supported Uniswap range.\n @dev Thro