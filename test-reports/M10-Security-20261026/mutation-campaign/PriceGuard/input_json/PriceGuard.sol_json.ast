"}]},"documentation":{"id":1504,"nodeType":"StructuredDocumentation","src":"32050:428:8","text":" @notice Inverts a Q64.96 square-root price, turning token1-per-token0 into token0-per-token1.\n @dev Computes `2**192 / sqrtPriceX96` with full precision and checked narrowing. Reverts if the input is\n      zero or the inverse does not fit in a uint160.\n @param sqrtPriceX96 Square-root price to invert, as a Q64.96 value.\n @return inverted Inverted square-root price as a Q64.96 value."},"id":1526,"implemented":true,"kind":"function","modifiers":[],"name":"_invertSqrtPrice","nameLocation":"32492:16:8","nodeType":"FunctionDefinition","parameters":{"id":1507,"nodeType":"ParameterList","parameters":[{"constant":false,"id":1506,"mutability":"mutable","name":"sqrtPriceX96","nameLocation":"32517:12:8","nodeType":"VariableDeclaration","scope":1526,"src":"32509:20:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":1505,"name":"uint160","nodeType":"ElementaryTypeName","src":"32509:7:8","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"}],"src":"32508:22:8"},"returnParameters":{"id":1510,"nodeType":"ParameterList","parameters":[{"constant":false,"id":1509,"mutability":"mutable","name":"","nameLocation":"-1:-1:-1","nodeType":"VariableDeclaration","scope":1526,"src":"32553:7:8","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":1508,"name":"uint160","nodeType":"ElementaryTypeName","src":"32553:7:8","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"}],"src":"32552:9:8"},"scope":1569,"src":"32483:212:8","stateMutability":"pure","virtual":false,"visibility":"private"},{"body":{"id":1567,"nodeType":"Block","src":"33532:211:8","statements":[{"assignments":[1537],"declarations":[{"constant":false,"id":1537,"mutabilit